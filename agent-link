}

disable_legacy_paseo_recovery() {
  local sentry="$STATE/paseo-limit-sentry.json" helper="$SHIM_BIN/paseo-recover" retired="$STATE/retired/paseo-recover-v0.5"
  local recovery_state="$STATE/paseo-recovery" retired_state="$STATE/retired/paseo-recovery-v0.5"
  if [ -f "$sentry" ]; then
    python3 - "$sentry" <<'PY2'
import json, os, sys, tempfile
path = sys.argv[1]
try:
    with open(path, encoding="utf-8") as handle:
        state = json.load(handle)
except Exception:
    sys.exit(0)
if not isinstance(state, dict) or state.get("auto") is False:
    sys.exit(0)
state["auto"] = False
fd, temporary = tempfile.mkstemp(prefix=".paseo-limit-sentry-", dir=os.path.dirname(path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(state, handle)
        handle.write("\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY2
  fi
  if [ -f "$helper" ]; then
    mkdir -p "$(dirname "$retired")"
    mv "$helper" "$retired"
    chmod 600 "$retired" 2>/dev/null || true
    echo "retired legacy Paseo recovery helper"
  fi
  if [ -d "$recovery_state" ]; then
    mkdir -p "$STATE/retired"
    if [ -e "$retired_state" ]; then
      retired_state="$retired_state-$(date '+%Y%m%d-%H%M%S')"
    fi
    mv "$recovery_state" "$retired_state"
