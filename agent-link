    settings_changed = remove_paseo_terminal_hooks(settings)
    if settings.get("outputStyle") != "Concise":
        settings["outputStyle"] = "Concise"
        settings_changed = True
    if settings_changed:
        changed += write_atomic(settings_path, json.dumps(settings, indent=2) + "\n")
for directory in codex_dirs:
    changed += write_atomic(os.path.join(directory, "AGENTS.md"), codex_agents)
paseo_config_path = os.path.join(home, ".paseo", "config.json")
if os.path.exists(paseo_config_path):
    try:
        paseo_config = json.load(open(paseo_config_path, encoding="utf-8"))
        daemon = paseo_config.setdefault("daemon", {})
        # AgentLink owns model/account switching inside the current chat. Paseo's
        # legacy merge auto-archive and terminal-agent capture can otherwise hide
        # histories or surface terminal processes as unrelated chat tabs.
        daemon["autoArchiveAfterMerge"] = False
        daemon["enableTerminalAgentHooks"] = False
        current_prompt = daemon.get("appendSystemPrompt") or ""
        current_prompt = current_prompt.strip()
        if managed_start in current_prompt and managed_end in current_prompt:
            before, tail = current_prompt.split(managed_start, 1)
            _, after = tail.split(managed_end, 1)
            parts = [before.strip(), paseo_contract, after.strip()]
            merged_prompt = "\n\n".join(part for part in parts if part)
        else:
            role_marker = "\n\n## Your role\n"
            known_legacy = all(marker in current_prompt for marker in (
                "## Accounts and limits",
                "## Paseo MCP approval",
                "## Agent hygiene (daemon stability)",
            ))
            if known_legacy:
                safe_marker = "## Dev servers — the biggest cost on this machine"
                finish_marker = "\n\n## Finishing\n"
                remainder = current_prompt.split(safe_marker, 1)[1] if safe_marker in current_prompt else ""
                remainder = (safe_marker + remainder).split(finish_marker, 1)[0].strip() if remainder else ""
            elif role_marker in current_prompt:
                remainder = role_marker.lstrip("\n") + current_prompt.split(role_marker, 1)[1]
            elif current_prompt.startswith("## Response contract"):
                remainder = ""
            else:
                remainder = current_prompt
            merged_prompt = paseo_contract + ("\n\n" + remainder if remainder else "")
        daemon["appendSystemPrompt"] = merged_prompt
        changed += write_atomic(paseo_config_path, json.dumps(paseo_config, indent=2) + "\n")
    except Exception as error:
        print(f"SKIPPED {paseo_config_path}: invalid config ({error})")
skills = ["paseo", "paseo-handoff", "paseo-advisor", "paseo-committee"]
missing = [name for name in skills if not os.path.isfile(os.path.join(home, ".agents", "skills", name, "SKILL.md"))]
print(f"response and Paseo orchestration contracts installed across {len(claude_dirs)} Claude and {len(codex_dirs)} Codex config directories ({changed} file updates)")
print("Paseo appendSystemPrompt updated for every provider; automatic history archive and terminal-agent capture disabled. Run `paseo reload` to apply it.")
if missing:
    print("WARNING: missing Paseo orchestration skills: " + ", ".join(missing))
    print("Install them from Paseo Settings -> Host -> Agents -> Orchestration skills.")
PY
      ;;
    status)
      printf 'Claude style: %s\n' "$(jq -r '.outputStyle // "unset"' "$HOME/.claude/settings.json" 2>/dev/null || echo unreadable)"
      grep -Fq '## Paseo orchestration' "$HOME/.claude/output-styles/concise.md" 2>/dev/null \
