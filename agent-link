def write_atomic(path, text):
    temp = None
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path) and open(path, encoding="utf-8").read() == text:
            return False
        if os.path.exists(path):
            shutil.copy2(path, path + ".bak-agent-link-style")
        mode = os.stat(path).st_mode & 0o777 if os.path.exists(path) else 0o600
        fd, temp = tempfile.mkstemp(prefix=".agent-link-style-", dir=os.path.dirname(path))
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.chmod(temp, mode)
        os.replace(temp, path)
    except OSError as error:
        print(f"SKIPPED {path}: {error}")
        return False
    finally:
        if temp and os.path.exists(temp):
            os.unlink(temp)
    return True

def remove_paseo_terminal_hooks(settings):
    """Remove Paseo's legacy terminal-agent bridge without touching other hooks."""
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return False
    changed = False
    for event in list(hooks):
        entries = hooks.get(event)
        if not isinstance(entries, list):
            continue
        kept_entries = []
        for entry in entries:
            if not isinstance(entry, dict) or not isinstance(entry.get("hooks"), list):
                kept_entries.append(entry)
                continue
            kept_hooks = []
            for hook in entry["hooks"]:
                command = hook.get("command", "") if isinstance(hook, dict) else ""
                legacy_terminal_hook = (
                    "PASEO_TERMINAL_ID" in command
                    and ("PASEO_HOOK_CLI" in command or "paseo" in command)
                    and " hooks " in command
                )
                if legacy_terminal_hook:
                    changed = True
                else:
                    kept_hooks.append(hook)
            if kept_hooks:
                if len(kept_hooks) != len(entry["hooks"]):
                    entry = dict(entry)
                    entry["hooks"] = kept_hooks
                kept_entries.append(entry)
        if kept_entries:
            hooks[event] = kept_entries
        else:
            del hooks[event]
            changed = True
    if not hooks:
        settings.pop("hooks", None)
    return changed

claude_dirs = [os.path.join(home, ".claude")] + sorted(glob.glob(os.path.join(accounts, "claude", "*")))
codex_dirs = sorted(glob.glob(os.path.join(accounts, "codex", "*"))) + [os.path.join(home, ".codex")]
