      jq -e '.daemon.appendSystemPrompt | contains("<!-- agent-link:paseo-contract:start -->")' "$HOME/.paseo/config.json" >/dev/null 2>&1 \
        && echo "Paseo provider contract: installed" || echo "Paseo provider contract: missing"
      local skill
