#!/usr/bin/env bash
# agent-link — multi-account manager for AI coding CLIs (Claude Code, OpenAI Codex).
#
# Every account lives in its own credential slot (a folder named by the account
# email). Slots are used two ways, at the same time if you like:
#
#   PARALLEL  each slot is independently usable (shims like `claude-2`, or env
#             vars for orchestrators such as Paseo) — N accounts, N quota pools,
#             all live at once.
#   SWITCH    `agent-link use claude you@work.com` re-routes the plain `claude`
#             command to that slot via a pointer file. No credentials are ever
#             copied, backed up, or restored — every slot's OAuth tokens refresh
#             in place, so nothing decays and nothing gets logged out. Your
#             original ~/.claude and ~/.codex are never touched ("primary").
#             A switch affects new processes only; running agents keep the
#             account they started with.
#
# Works on macOS and Linux. Requires: bash, python3, and the CLIs you manage.
set -u

VERSION="0.4.0"
# Home dir. Prefer whichever location actually holds accounts — Claude binds
# credentials to the literal config-dir path, so an existing install must keep
# using the directory its logins were created under, whatever it is called.
aa_has_accounts() { [ -n "$(ls -A "$1/accounts/claude" "$1/accounts/codex" 2>/dev/null)" ]; }
if [ -n "${AGENT_LINK_HOME:-}" ]; then ROOT="$AGENT_LINK_HOME"
elif [ -n "${AGENT_AUTH_HOME:-}" ]; then ROOT="$AGENT_AUTH_HOME"
elif aa_has_accounts "$HOME/.agent-link"; then ROOT="$HOME/.agent-link"
elif aa_has_accounts "$HOME/.agent-auth"; then ROOT="$HOME/.agent-auth"
elif [ -d "$HOME/.agent-link" ]; then ROOT="$HOME/.agent-link"
elif [ -d "$HOME/.agent-auth" ]; then ROOT="$HOME/.agent-auth"
else ROOT="$HOME/.agent-link"
fi

ACCOUNTS="$ROOT/accounts"
SHIM_BIN="$ROOT/bin"
STATE="$ROOT/state"
PROVIDERS="claude codex"

# ---------------------------------------------------------------- provider registry

prov_valid() { case "$1" in claude|codex) return 0;; *) return 1;; esac; }

prov_env_var() { case "$1" in claude) echo CLAUDE_CONFIG_DIR;; codex) echo CODEX_HOME;; esac; }

# Is this slot logged in? Claude Code does NOT write a credentials file into
# CLAUDE_CONFIG_DIR on macOS — the tokens go to the OS keychain, keyed per
# config dir (verified: three config dirs report three different accounts from
# `claude auth status` at the same time). So a slot's recorded identity is the
# signal for Claude. Codex does keep auth.json inside CODEX_HOME.
prov_logged_in() { # $1 provider, $2 slot dir
  case "$1" in
    claude) [ -n "$(prov_email claude "$2")" ] ;;
    codex)  [ -f "$2/auth.json" ] ;;
  esac
}

# Reject anything that is not a plain account name — these values are
# interpolated into paths that get created and (for `remove`) deleted.
valid_account() { # $1 candidate
  case "${1:-}" in
    ""|.|..|*/*|*'\'*) return 1 ;;
    *) return 0 ;;
  esac
}

prov_binary() { echo "$1"; } # binary name == provider name for both

# Print the logged-in account email for a slot dir (empty if none/unreadable).
prov_email() { # $1 provider, $2 slot dir
  case "$1" in
    claude)
      python3 - "$2" <<'PY'
import json, sys, os
p = os.path.join(sys.argv[1], ".claude.json")
try: print(json.load(open(p)).get("oauthAccount", {}).get("emailAddress", ""))
except Exception: pass
PY
      ;;
    codex)
      python3 - "$2" <<'PY'
import json, sys, os, base64
p = os.path.join(sys.argv[1], "auth.json")
try:
    tok = json.load(open(p))["tokens"]["id_token"].split(".")[1]
    tok += "=" * (-len(tok) % 4)
    print(json.loads(base64.urlsafe_b64decode(tok)).get("email", ""))
except Exception: pass
PY
      ;;
  esac
}

# Force file-based credential storage in a codex slot config. A copied config
# may say "keyring", which would silently break slot isolation (credentials
# would land in the shared OS keyring instead of inside CODEX_HOME).
codex_pin_file_store() { # $1 config.toml path
  python3 - "$1" <<'PY'
import re, sys, os
p = sys.argv[1]
s = open(p).read() if os.path.exists(p) else ""
line = 'cli_auth_credentials_store = "file"'
if re.search(r'^\s*cli_auth_credentials_store\s*=', s, re.M):
    s = re.sub(r'^\s*cli_auth_credentials_store\s*=.*$', line, s, flags=re.M)
else:
    # Must go at the ROOT of the document. Appending would land it inside
    # whatever [table] the file happens to end with (e.g. [mcp_servers.x]),
    # where codex ignores it and silently falls back to the shared keyring.
    s = line + "\n" + s
open(p, "w").write(s)
PY
}

# One-time slot preparation after mkdir.
prov_prepare() { # $1 provider, $2 slot dir
  case "$1" in
    codex)
      # Seed from the user's real config so slots behave like the primary
      # (MCP servers etc.), then pin credentials to file storage.
      if [ ! -f "$2/config.toml" ]; then
        [ -f "$HOME/.codex/config.toml" ] && cp "$HOME/.codex/config.toml" "$2/config.toml"
      fi
      codex_pin_file_store "$2/config.toml"
      ;;
  esac
}

prov_binary_check() { # $1 provider — fail with install hints if the CLI is missing
  command -v "$(prov_binary "$1")" >/dev/null 2>&1 && return 0
  echo "error: the '$(prov_binary "$1")' CLI is not in PATH." >&2
  case "$1" in
    claude)
      echo "  install: npm install -g @anthropic-ai/claude-code   (https://claude.com/claude-code)" >&2
      echo "  note: if 'claude' works in your shell only via an alias (the old installer)," >&2
      echo "  run 'claude install' there to get a real binary on PATH." >&2
      ;;
    codex)
      echo "  install: npm install -g @openai/codex" >&2
      ;;
  esac
  return 127
}

prov_login() { # $1 provider, $2 slot dir, $3 email
  case "$1" in
    claude)
      if claude auth login --help >/dev/null 2>&1; then
        CLAUDE_CONFIG_DIR="$2" claude auth login --email "$3"
      else
        echo "note: this Claude Code version predates 'claude auth login', so the full"
        echo "      REPL will open. After the login completes, type /exit to come back."
        echo "      (Or update first: claude update)"
        CLAUDE_CONFIG_DIR="$2" claude /login
      fi
      ;;
    codex)  CODEX_HOME="$2" codex login ;;
  esac
}

# ---------------------------------------------------------------- slot helpers

slot_dir() { echo "$ACCOUNTS/$1/$2"; }

order_file() { echo "$STATE/order-$1"; }

route_file() { echo "$STATE/route-$1"; }

# Emails for a provider in stable numbered order (order file first, strays after).
slot_list() { # $1 provider
  local seen="" e d
  if [ -f "$(order_file "$1")" ]; then
    while IFS= read -r e; do
      [ -n "$e" ] && [ -d "$(slot_dir "$1" "$e")" ] && { echo "$e"; seen="$seen|$e|"; }
    done < "$(order_file "$1")"
  fi
  for d in "$ACCOUNTS/$1"/*/; do
    [ -d "$d" ] || continue
    e="$(basename "$d")"
    case "$seen" in *"|$e|"*) ;; *) echo "$e" ;; esac
  done
}

# ---------------------------------------------------------------- auto-routing pools
#
# One "auto" launcher per provider picks a real slot at LAUNCH time, so a single
# Paseo/editor provider spreads new agents across accounts. It must resolve to a
# real slot path: Claude keys credentials to the literal config-dir path, so a
# symlink that swings between slots reports logged-out (verified).
# Selection is least-recently-used among slots that are logged in and not in
# cooldown. A running process keeps whatever it started with, always.

pools_dir() { echo "$STATE/pools"; }

# The primary login (~/.claude, ~/.codex) is a perfectly good pool member, so
# rotation includes it. That avoids duplicating the primary's account as a slot
# — which wastes a credential entry and double-weights that account.
primary_dir() { case "$1" in claude) echo "$HOME/.claude";; codex) echo "$HOME/.codex";; esac; }

primary_email() { # $1 provider
  case "$1" in
    claude) prov_email claude "$HOME" ;;
    codex)  prov_email codex "$HOME/.codex" ;;
  esac
}

# An account that has hit its spend limit cannot serve requests, so routing
# must skip it without waiting for you to park it by hand. Claude records this
# in its own config: extra usage exhausted AND no subscription allowance left.
prov_blocked() { # $1 provider, $2 config dir ($HOME for the primary)
  [ "$1" = claude ] || return 1
  python3 - "$2" <<'PY2'
import json, os, sys
d = sys.argv[1]
p = os.path.join(d, ".claude.json")
try:
    c = json.load(open(p))
except Exception:
    sys.exit(1)
blocked = c.get("cachedExtraUsageDisabledReason") == "out_of_credits" and c.get("hasAvailableSubscription") is False
sys.exit(0 if blocked else 1)
PY2
}

# The primary has no slot dir, so its cooldown is tracked under "primary".
slot_available_primary() { # $1 provider
  local until now
  until="$(cat "$(pools_dir)/cooldown-$1-primary" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  [ "$until" -gt "$now" ] && return 1
  if recently_refused "$1" "$([ "$1" = claude ] && echo "$HOME/.claude" || echo "$HOME/.codex")"; then
    autopark "$1" primary
    return 1
  fi
  return 0
}

# Self-healing: if an account was refused for a limit in its most recent
# activity, sideline it automatically. This is what makes a limit recover
# without anyone running a command — the dead agent is lost either way, but
# every launch after it avoids that account.
REFUSAL_WINDOW_MIN=45
recently_refused() { # $1 provider, $2 config dir
  [ "$1" = claude ] || return 1
  python3 - "$2" "$REFUSAL_WINDOW_MIN" <<'PY2'
import glob, os, sys, time
d, window = sys.argv[1], float(sys.argv[2])
cutoff = time.time() - window * 60
newest, newest_m = None, 0
for f in glob.glob(os.path.join(d, "projects", "*", "*.jsonl")):
    try:
        m = os.stat(f).st_mtime
    except OSError:
        continue
    if m > newest_m:
        newest, newest_m = f, m
if not newest or newest_m < cutoff:
    sys.exit(1)
try:
    with open(newest, "rb") as fh:
        fh.seek(max(0, os.path.getsize(newest) - 20000))
        tail = fh.read().decode("utf-8", "ignore")
except OSError:
    sys.exit(1)
sys.exit(0 if ("spend limit" in tail or "usage limit" in tail) else 1)
PY2
}

# Park an account that just refused, so the decision persists for later launches.
autopark() { # $1 provider, $2 key (email or "primary")
  mkdir -p "$(pools_dir)"
  echo "$(( $(date +%s) + 180 * 60 ))" > "$(pools_dir)/cooldown-$1-$2"
  echo "auto: refused for a limit" > "$(pools_dir)/reason-$1-$2"
  echo "$(date '+%Y-%m-%d %H:%M')  auto-parked $1/$2 after a limit refusal" >> "$STATE/autopark.log"
}

slot_available() { # $1 provider, $2 email
  local until now
  prov_logged_in "$1" "$(slot_dir "$1" "$2")" || return 1
  until="$(cat "$(pools_dir)/cooldown-$1-$2" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  [ "$until" -gt "$now" ] && return 1
  if recently_refused "$1" "$(slot_dir "$1" "$2")"; then
    autopark "$1" "$2"
    return 1
  fi
  return 0
}

# Print the slot to use next ("primary" or an email), and stamp it as used.
pick_slot() { # $1 provider
  local best="" best_ts="" e ts pemail covered
  mkdir -p "$(pools_dir)"
  # The primary counts as a candidate unless a slot already holds that account.
  pemail="$(primary_email "$1")"
  if [ -n "$pemail" ]; then
    covered=""
    for e in $(slot_list "$1"); do
      [ "$(prov_email "$1" "$(slot_dir "$1" "$e")")" = "$pemail" ] && covered=1
    done
    if [ -z "$covered" ] && slot_available_primary "$1"; then
      ts="$(cat "$(pools_dir)/last-$1-primary" 2>/dev/null || echo 0)"
      best="primary"; best_ts="$ts"
    fi
  fi
  for e in $(slot_list "$1"); do
    slot_available "$1" "$e" || continue
    ts="$(cat "$(pools_dir)/last-$1-$e" 2>/dev/null || echo 0)"
    if [ -z "$best" ] || [ "$ts" -lt "$best_ts" ]; then best="$e"; best_ts="$ts"; fi
  done
  [ -n "$best" ] || return 1
  [ "${2:-}" = dry ] && { echo "$best"; return 0; }
  date +%s > "$(pools_dir)/last-$1-$best"
  # Launch counter: how many agents this account has actually been handed.
  local n
  n="$(cat "$(pools_dir)/count-$1-$best" 2>/dev/null || echo 0)"
  echo $(( n + 1 )) > "$(pools_dir)/count-$1-$best"
  echo "$best"
}

slot_register() { # $1 provider, $2 email — record in order file once
  mkdir -p "$STATE"
  touch "$(order_file "$1")"
  grep -qxF "$2" "$(order_file "$1")" || echo "$2" >> "$(order_file "$1")"
}

# Status of one slot. Prints a line; returns 0 only if logged in as the right account.
slot_check() { # $1 provider, $2 email, $3 index
  local dir got
  dir="$(slot_dir "$1" "$2")"
  if ! prov_logged_in "$1" "$dir"; then
    printf '  [ ] %s-%s  %s  — not logged in\n' "$1" "$3" "$2"
    return 1
  fi
  got="$(prov_email "$1" "$dir")"
  if [ -n "$got" ] && [ "$got" != "$2" ]; then
    printf '  [!] %s-%s  %s  — logged in as %s (WRONG ACCOUNT — rerun: agent-link login %s %s)\n' \
      "$1" "$3" "$2" "$got" "$1" "$2"
    return 1
  fi
  printf '  [x] %s-%s  %s  — logged in\n' "$1" "$3" "$2"
  return 0
}

slot_login() { # $1 provider, $2 email
  local dir
  prov_binary_check "$1" || return 127
  dir="$(slot_dir "$1" "$2")"
  mkdir -p "$dir"
  prov_prepare "$1" "$dir"
  slot_register "$1" "$2"
  echo
  echo "==> $1 login for: $2"
  echo "    In the browser, sign in as EXACTLY this account: $2"
  echo "    Tip: if the browser is already signed into another account, paste the"
  echo "    login URL into a private/incognito window instead."
  prov_login "$1" "$dir" "$2"
  local i=0 e
  for e in $(slot_list "$1"); do i=$((i+1)); [ "$e" = "$2" ] && break; done
  if ! slot_check "$1" "$2" "$i"; then
    # The CLI's own errors are terse ("status code 400") and the causes are
    # always the same three, so name them and hand back the retry.
    echo
    echo "    The sign-in didn't complete. A 'status code 400' means the pasted code"
    echo "    was refused — the usual reasons:"
    echo "      - the URL came from an EARLIER run: every run mints a fresh single-use"
    echo "        link, and a code from an old link is always rejected"
    echo "      - only part of the code was pasted: include everything after '#'"
    echo "      - the code expired: they only live a few minutes"
    echo "    Try again (a fresh link is printed each time):"
    echo "      agent-link login $1 $2"
    return 1
  fi
}

# ---------------------------------------------------------------- commands

# ---------------------------------------------------------------- presentation

# Colour only for a real terminal, and never when NO_COLOR is set.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  C_OFF=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_CYAN=$'\033[36m'
else
  C_OFF=""; C_BOLD=""; C_DIM=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_CYAN=""
fi

# One place that knows how an account should look: dot colour + words.
slot_state() { # $1 provider, $2 email -> "dot|state|note"
  local dir got until now last mins runs
  dir="$(slot_dir "$1" "$2")"
  if ! prov_logged_in "$1" "$dir"; then
    printf '%s|%s|%s' "${C_YELLOW}○${C_OFF}" "not logged in" "run 'l' to log in"
    return
  fi
  got="$(prov_email "$1" "$dir")"
  if [ -n "$got" ] && [ "$got" != "$2" ]; then
    printf '%s|%s|%s' "${C_RED}●${C_OFF}" "WRONG ACCOUNT" "signed in as $got"
    return
  fi
  now="$(date +%s)"
  until="$(cat "$(pools_dir)/cooldown-$1-$2" 2>/dev/null || echo 0)"
  last="$(cat "$(pools_dir)/last-$1-$2" 2>/dev/null || echo 0)"
  if [ "$until" -gt "$now" ]; then
    printf '%s|%s|%s' "${C_RED}●${C_OFF}" "logged in" "parked $(( (until - now + 59) / 60 ))m — $(cat "$(pools_dir)/reason-$1-$2" 2>/dev/null || echo 'routing skips it')"
    return
  fi
  local runs
  runs="$(cat "$(pools_dir)/count-$1-$2" 2>/dev/null || echo 0)"
  if [ "$last" -gt 0 ]; then
    mins=$(( (now - last) / 60 ))
    printf '%s|%s|%s' "${C_GREEN}●${C_OFF}" "logged in" "in rotation · ${runs} launches · last ${mins}m ago"
  else
    printf '%s|%s|%s' "${C_GREEN}●${C_OFF}" "logged in" "in rotation · never used"
  fi
}

cmd_status() {
  local p e i pointer state dot words note auto right pad pemail pcov pruns pnote puntil pnow
  for p in $PROVIDERS; do
    pointer="primary"
    [ -f "$(route_file "$p")" ] && pointer="$(cat "$(route_file "$p")")"
    echo
    right="plain \`$p\` → $pointer"
    pad=$(( 60 - ${#p} - ${#right} )); [ "$pad" -lt 2 ] && pad=2
    printf '  %s%s%s%*s%s%s%s\n' "$C_BOLD" "$(echo "$p" | tr '[:lower:]' '[:upper:]')" "$C_OFF" \
      "$pad" "" "$C_DIM" "$right" "$C_OFF"
    pemail="$(primary_email "$p")"
    pcov=""
    for e in $(slot_list "$p"); do
      [ "$(prov_email "$p" "$(slot_dir "$p" "$e")")" = "$pemail" ] && pcov=1
    done
    if [ -n "$pemail" ]; then
      pruns="$(cat "$(pools_dir)/count-$p-primary" 2>/dev/null || echo 0)"
      puntil="$(cat "$(pools_dir)/cooldown-$p-primary" 2>/dev/null || echo 0)"
      pnow="$(date +%s)"
      if [ -n "$pcov" ]; then
        pnote="duplicated by a slot below"
      elif [ "$puntil" -gt "$pnow" ]; then
        pnote="parked $(( (puntil - pnow + 59) / 60 ))m — $(cat "$(pools_dir)/reason-$p-primary" 2>/dev/null || echo 'routing skips it')"
      else
        pnote="in rotation · ${pruns} launches"
      fi
      printf '    %s %-30s %-14s %s%s%s\n' "${C_GREEN}●${C_OFF}" "$pemail" "primary" "$C_DIM" "$pnote" "$C_OFF"
    fi
    i=0
    for e in $(slot_list "$p"); do
      i=$((i+1))
      state="$(slot_state "$p" "$e")"
      dot="${state%%|*}"; words="$(echo "$state" | cut -d'|' -f2)"; note="${state##*|}"
      printf '    %s %-30s %-14s %s%s%s\n' "$dot" "$e" "$words" "$C_DIM" "$note" "$C_OFF"
    done
    [ "$i" = 0 ] && printf '    %sno accounts yet — press %sa%s to add one%s\n' "$C_DIM" "$C_BOLD" "$C_DIM" "$C_OFF"
    if [ -x "$SHIM_BIN/$p-auto" ]; then
      auto="${C_GREEN}ready${C_OFF} ${C_DIM}($SHIM_BIN/$p-auto)${C_OFF}"
    else
      auto="${C_DIM}not set up — press d${C_OFF}"
    fi
    printf '    %sdynamic routing:%s %b\n' "$C_DIM" "$C_OFF" "$auto"
  done
  return 0
}

cmd_add() { # provider email
  prov_valid "${1:-}" || { echo "usage: agent-link add <claude|codex> <email>" >&2; return 1; }
  valid_account "${2:-}" || { echo "invalid account name: '${2:-}'" >&2; return 1; }
  slot_login "$1" "$2"
}

cmd_login() { # [provider] [email|all]
  local p e i
  case "${1:-all}" in
    all)
      for p in $PROVIDERS; do
        i=0
        for e in $(slot_list "$p"); do
          i=$((i+1))
          slot_check "$p" "$e" "$i" >/dev/null || slot_login "$p" "$e"
        done
      done
      ;;
    claude|codex)
      p="$1"
      if [ -n "${2:-}" ] && [ "${2:-}" != all ]; then
        [ -d "$(slot_dir "$p" "$2")" ] || { echo "no $p slot for '$2' — use: agent-link add $p $2" >&2; return 1; }
        slot_login "$p" "$2"
      else
        i=0
        for e in $(slot_list "$p"); do
          i=$((i+1))
          slot_check "$p" "$e" "$i" >/dev/null || slot_login "$p" "$e"
        done
      fi
      ;;
    *)
      # bare email — find it in any provider
      local found=0
      for p in $PROVIDERS; do
        [ -d "$(slot_dir "$p" "$1")" ] && { slot_login "$p" "$1"; found=1; }
      done
      [ "$found" = 1 ] || { echo "no slot folder for '$1'" >&2; return 1; }
      ;;
  esac
}

cmd_use() { # provider email|primary|<number>
  prov_valid "${1:-}" || { echo "usage: agent-link use <claude|codex> <email|primary|N>" >&2; return 1; }
  local p="$1" target="${2:-}" e i
  [ -n "$target" ] || { echo "usage: agent-link use <claude|codex> <email|primary|N>" >&2; return 1; }
  if [ "$target" != primary ] && ! [ -d "$(slot_dir "$p" "$target")" ]; then
    # allow numeric selection
    if echo "$target" | grep -q '^[0-9][0-9]*$'; then
      i=0
      for e in $(slot_list "$p"); do
        i=$((i+1))
        [ "$i" = "$target" ] && { target="$e"; break; }
      done
    fi
    [ -d "$(slot_dir "$p" "$target")" ] || { echo "no $p slot '$2'" >&2; return 1; }
  fi
  mkdir -p "$STATE"
  echo "$target" > "$(route_file "$p")"
  echo "plain \`$p\` now routes to: $target (new processes only; running ones are unaffected)"
  if [ ! -x "$SHIM_BIN/$p" ]; then
    echo "note: routing shim not installed yet — run: agent-link route enable"
  fi
}

write_router_shim() { # $1 provider
  local p="$1"
  mkdir -p "$SHIM_BIN"
  cat > "$SHIM_BIN/$p" <<EOF
#!/usr/bin/env bash
# agent-link router shim — managed by \`agent-link route\`. Do not edit.
here="\$(cd "\$(dirname "\$0")" && pwd)"
aa_root="\${AGENT_LINK_HOME:-\${AGENT_AUTH_HOME:-$ROOT}}"
target="\$(cat "\$aa_root/state/route-$p" 2>/dev/null || true)"
real=""
old_ifs="\$IFS"; IFS=:
for d in \$PATH; do
  [ -n "\$d" ] || continue
  [ "\$d" = "\$here" ] && continue
  if [ -x "\$d/$p" ] && [ ! "\$d/$p" -ef "\$here/$p" ]; then real="\$d/$p"; break; fi
done
IFS="\$old_ifs"
[ -n "\$real" ] || { echo "agent-link: real '$p' binary not found in PATH" >&2; exit 127; }
# An explicitly inherited value always wins: otherwise this shim would rewrite
# the env of \`agent-link add/run/env\` and send a login into the routed slot.
if [ -z "\${$(prov_env_var "$p"):-}" ] && [ -n "\$target" ] && [ "\$target" != "primary" ]; then
  export $(prov_env_var "$p")="\$aa_root/accounts/$p/\$target"
fi
exec "\$real" "\$@"
EOF
  chmod +x "$SHIM_BIN/$p"
}

cmd_route() { # enable|disable|status
  local p
  case "${1:-status}" in
    enable)
      for p in $PROVIDERS; do write_router_shim "$p"; done
      echo "Router shims written to $SHIM_BIN"
      echo
      echo "Put them FIRST in PATH by adding this to your shell profile:"
      echo "  export PATH=\"$SHIM_BIN:\$PATH\""
      echo
      echo "Then: agent-link use claude <email>   # or 'primary' to route back"
      ;;
    disable)
      for p in $PROVIDERS; do rm -f "$SHIM_BIN/$p"; done
      echo "Router shims removed. Plain commands hit your real binaries again."
      ;;
    status|*)
      for p in $PROVIDERS; do
        if [ -x "$SHIM_BIN/$p" ]; then
          printf '%s: shim installed, routing to %s\n' "$p" "$(cat "$(route_file "$p")" 2>/dev/null || echo primary)"
        else
          printf '%s: no shim (plain `%s` is untouched)\n' "$p" "$p"
        fi
      done
      case ":$PATH:" in
        *":$SHIM_BIN:"*) ;;
        *)
          if [ -x "$SHIM_BIN/claude" ] || [ -x "$SHIM_BIN/codex" ]; then
            echo "warning: $SHIM_BIN is not in PATH — routing is inert until it is (and first)"
          fi
          ;;
      esac
      return 0
      ;;
  esac
}

write_auto_launcher() { # $1 provider — one command that routes to a live account
  local p="$1" env_var self primary_search
  primary_search="$(primary_dir "$1")"
  env_var="$(prov_env_var "$p")"
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  mkdir -p "$SHIM_BIN"
  cat > "$SHIM_BIN/$p-auto" <<EOF
#!/usr/bin/env bash
# agent-link auto-routing launcher for $p — managed by \`agent-link auto\`.
# Picks a logged-in, non-cooled-down account at launch and execs the real CLI.
# Point one editor/orchestrator provider at this file instead of picking
# accounts by hand. Running processes are never re-routed.
here="\$(cd "\$(dirname "\$0")" && pwd)"
aa_root="\${AGENT_LINK_HOME:-\${AGENT_AUTH_HOME:-$ROOT}}"
real=""
old_ifs="\$IFS"; IFS=:
for d in \$PATH; do
  [ -n "\$d" ] || continue
  [ "\$d" = "\$here" ] && continue
  if [ -x "\$d/$p" ] && [ ! "\$d/$p" -ef "\$here/$p" ]; then real="\$d/$p"; break; fi
done
IFS="\$old_ifs"
[ -n "\$real" ] || real="$(command -v "$p" 2>/dev/null || echo "$p")"
# A resumed session only exists in the account that created it, so routing a
# resume elsewhere fails with "No conversation found with session ID". Detect a
# session id in the args and pin to the account that owns it.
aa_sid=""
aa_prev=""
for aa_a in "\$@"; do
  case "\$aa_a" in
    --resume=*) aa_sid="\${aa_a#--resume=}" ;;
    -*) ;;
    *)
      case "\$aa_prev" in
        --resume|-r|resume) aa_sid="\$aa_a" ;;
      esac
      ;;
  esac
  aa_prev="\$aa_a"
done
aa_pinned=""
aa_pin_primary=""
if [ -n "\$aa_sid" ]; then
  # The primary owns sessions too, so it must be searched as well — otherwise a
  # conversation started there gets routed to a slot that has never seen it.
  if [ -n "\$(find "$primary_search" -maxdepth 4 -name "*\$aa_sid*" -print -quit 2>/dev/null)" ]; then
    aa_pin_primary=1
  else
    for aa_d in "\$aa_root/accounts/$p"/*/; do
      [ -d "\$aa_d" ] || continue
      if [ -n "\$(find "\$aa_d" -maxdepth 4 -name "*\$aa_sid*" -print -quit 2>/dev/null)" ]; then
        aa_pinned="\${aa_d%/}"
        break
      fi
    done
  fi
fi
# An explicitly inherited value always wins, then a pinned resume, then rotation.
if [ -z "\${$env_var:-}" ] && [ -z "\$aa_pin_primary" ]; then
  if [ -n "\$aa_pinned" ]; then
    export $env_var="\$aa_pinned"
  elif [ -x "$self" ]; then
    slot="\$("$self" pick $p 2>/dev/null || true)"
    if [ -n "\$slot" ] && [ "\$slot" != primary ]; then
      export $env_var="\$aa_root/accounts/$p/\$slot"
    fi
  fi
fi
exec "\$real" "\$@"
EOF
  chmod +x "$SHIM_BIN/$p-auto"
  echo "wrote $SHIM_BIN/$p-auto"
}

cmd_auto() { # write auto launchers and print the provider snippet
  local p
  for p in $PROVIDERS; do write_auto_launcher "$p"; done
  cat <<EOF

Point ONE provider at each launcher and it spreads new agents across your
accounts automatically (least-recently-used, skipping cooled-down ones).

Paseo — ~/.paseo/config.json under agents.providers (restart the daemon after):

  "claude-auto": {
    "extends": "claude",
    "label": "Claude (Dynamic Agent Link)",
    "command": ["$SHIM_BIN/claude-auto"]
  },
  "codex-auto": {
    "extends": "codex",
    "label": "Codex (Dynamic Agent Link)",
    "command": ["$SHIM_BIN/codex-auto"]
  }

Anything else that runs a command works too — just run $SHIM_BIN/claude-auto
in place of claude.
EOF
}


# Run a provider's real CLI with dynamic routing applied:
#   agent-link claude          -> Claude Code on the next account in rotation
#   agent-link codex -m ...    -> args pass straight through
# An inherited CLAUDE_CONFIG_DIR/CODEX_HOME still wins, and if no account is
# available it simply runs your primary login.
cmd_exec_auto() { # $1 provider, rest = args for the real CLI
  local p="$1" env_var real d slot
  shift
  env_var="$(prov_env_var "$p")"
  real=""
  local old_ifs="$IFS"; IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    [ "$d" = "$SHIM_BIN" ] && continue
    if [ -x "$d/$p" ]; then real="$d/$p"; break; fi
  done
  IFS="$old_ifs"
  [ -n "$real" ] || { prov_binary_check "$p"; return 127; }
  if [ -z "$(eval "printf '%s' \"\${$env_var:-}\"")" ]; then
    slot="$(pick_slot "$p" 2>/dev/null || true)"
    if [ -n "$slot" ] && [ "$slot" != primary ]; then
      export "$env_var=$(slot_dir "$p" "$slot")"
    fi
  fi
  exec "$real" "$@"
}

# Move a conversation to another account so it can be continued there.
# Sessions are stored per config dir, so a chat started on account A simply
# does not exist for account B — this copies the transcript across. The model
# re-sends the transcript on resume, so the conversation continues; the new
# account is billed from that point on.
cmd_handoff() { # $1 provider, $2 session-id, $3 target email
  prov_valid "${1:-}" || { echo "usage: agent-link handoff <claude|codex> <session-id> <email>" >&2; return 1; }
  [ -n "${2:-}" ] || { echo "usage: agent-link handoff <claude|codex> <session-id> <email>" >&2; return 1; }
  valid_account "${3:-}" || { echo "usage: agent-link handoff <claude|codex> <session-id> <email>" >&2; return 1; }
  local p="$1" sid="$2" target="$3" src="" hit="" rel dest
  [ -d "$(slot_dir "$p" "$target")" ] || { echo "no $p account '$target'" >&2; return 1; }
  for d in "$ACCOUNTS/$p"/*/; do
    [ -d "$d" ] || continue
    hit="$(find "$d" -maxdepth 4 -name "*$sid*" -print -quit 2>/dev/null)"
    [ -n "$hit" ] && { src="${d%/}"; break; }
  done
  [ -n "$src" ] || { echo "session '$sid' not found in any $p account" >&2; return 1; }
  [ "$src" = "$(slot_dir "$p" "$target")" ] && { echo "already on $target"; return 0; }
  rel="${hit#$src/}"
  dest="$(slot_dir "$p" "$target")/$rel"
  mkdir -p "$(dirname "$dest")"
  cp "$hit" "$dest"
  echo "copied session $sid"
  echo "  from: $(basename "$src")"
  echo "    to: $target"
  echo "continue it with: agent-link run $p $target $p --resume $sid"
}

cmd_pick() { # provider — print the account to use next (used by the launchers)
  prov_valid "${1:-}" || { echo "usage: agent-link pick <claude|codex>" >&2; return 1; }
  pick_slot "$1"
}

cmd_cooldown() { # provider email minutes — park an exhausted account
  prov_valid "${1:-}" && valid_account "${2:-}" || {
    echo "usage: agent-link cooldown <claude|codex> <email> [minutes|clear]" >&2; return 1; }
  local p="$1" e="$2" arg="${3:-180}"
  mkdir -p "$(pools_dir)"
  if [ "$arg" = clear ]; then
    rm -f "$(pools_dir)/cooldown-$p-$e" "$(pools_dir)/reason-$p-$e"
    echo "$p · $e: cooldown cleared"
    return 0
  fi
  echo "$(( $(date +%s) + arg * 60 ))" > "$(pools_dir)/cooldown-$p-$e"
  echo "parked by you" > "$(pools_dir)/reason-$p-$e"
  echo "$p · $e: parked for ${arg}m — auto-routing will skip it until then"
}

# One line, for an agent to run mid-conversation without dumping context.
# Ask each account to answer one token on a given model. Config flags proved
# unreliable — an account marked "out of credits" can still serve, and one that
# looks fine can refuse — so this measures instead of guessing.
cmd_probe() { # $1 provider (default claude), $2 model, [--park]
  local p="${1:-claude}" model="${2:-}" park="" e dir out ok
  case "${3:-}" in --park) park=1 ;; esac
  prov_valid "$p" || { echo "usage: agent-link probe <claude|codex> [model] [--park]" >&2; return 1; }
  [ "$p" = claude ] || { echo "probe currently supports claude only" >&2; return 1; }
  for e in primary $(slot_list "$p"); do
    if [ "$e" = primary ]; then
      [ -n "$(primary_email "$p")" ] || continue
      dir=""
    else
      prov_logged_in "$p" "$(slot_dir "$p" "$e")" || continue
      dir="$(slot_dir "$p" "$e")"
    fi
    printf '  %-28s ' "$e"
    if [ -n "$dir" ]; then
      out="$(CLAUDE_CONFIG_DIR="$dir" claude -p "ok" ${model:+--model "$model"} 2>&1 | tr '\n' ' ')"
    else
      out="$(claude -p "ok" ${model:+--model "$model"} 2>&1 | tr '\n' ' ')"
    fi
    case "$out" in
      *"spend limit"*|*"usage limit"*|*"rate limit"*|*"Credit balance"*)
        ok=""
        printf '%sCANNOT SERVE%s %s\n' "$C_RED" "$C_OFF" "${model:-default}"
        ;;
      *) ok=1; printf '%sok%s\n' "$C_GREEN" "$C_OFF" ;;
    esac
    if [ -z "$ok" ] && [ -n "$park" ]; then
      cmd_cooldown "$p" "$e" 180 >/dev/null
      echo "      parked for 180m — routing will skip it"
    fi
  done
}

# What the numbers actually say: where work went, what it cost in tokens, how
# much came from cache, and which accounts got refused.
# Find conversations that died on a limit and move them to a healthy account.
# A running agent cannot be re-routed mid-flight — its account is fixed when the
# process starts — so the honest recovery is: park the exhausted account, copy
# the transcript to one that works, resume there.
cmd_rescue() { # [hours] [--go]
  local hours="${1:-6}" go=""
  case "${2:-}" in --go) go=1 ;; esac
  case "${1:-}" in --go) hours=6; go=1 ;; esac
  local found=0 sid acct proj target
  while IFS='|' read -r sid acct proj; do
    [ -n "$sid" ] || continue
    found=1
    printf '  %s%s%s in %s\n' "$C_BOLD" "$sid" "$C_OFF" "$acct"
    printf '    project: %s\n' "$proj"
    if [ -z "$go" ]; then continue; fi
    if [ "$acct" != primary ]; then
      cmd_cooldown claude "$acct" 180 >/dev/null && printf '    parked %s for 180m\n' "$acct"
    else
      echo "$(( $(date +%s) + 10800 ))" > "$(pools_dir)/cooldown-claude-primary"
      printf '    parked the primary for 180m\n'
    fi
    target="$(pick_slot claude dry 2>/dev/null || true)"
    if [ -z "$target" ] || [ "$target" = "$acct" ]; then
      printf '    %sno healthy account to move it to%s\n' "$C_RED" "$C_OFF"
      continue
    fi
    if [ "$target" = primary ]; then
      printf '    %sthe only healthy account is your primary — resume with: claude --resume %s%s\n' "$C_DIM" "$sid" "$C_OFF"
      continue
    fi
    cmd_handoff claude "$sid" "$target" >/dev/null 2>&1 &&
      printf '    moved to %s%s%s — resume with: agent-link run claude %s claude --resume %s\n' "$C_GREEN" "$target" "$C_OFF" "$target" "$sid"
  done <<EOF
$(python3 - "$ACCOUNTS" "$HOME" "$hours" <<'PY2'
import glob, os, sys, time
accounts_root, home, hours = sys.argv[1], sys.argv[2], float(sys.argv[3])
since = time.time() - hours * 3600
seen = set()
def scan(root, label):
    for f in glob.glob(os.path.join(root, "projects", "*", "*.jsonl")):
        try:
            st = os.stat(f)
        except OSError:
            continue
        if st.st_mtime < since or st.st_size > 25_000_000:
            continue
        try:
            text = open(f, errors="ignore").read()
        except OSError:
            continue
        if "spend limit" not in text and "usage limit" not in text:
            continue
        sid = os.path.basename(f)[:-6]
        if sid in seen:
            continue
        seen.add(sid)
        print(f"{sid}|{label}|{os.path.basename(os.path.dirname(f)).split('--')[-1]}")
scan(os.path.join(home, ".claude"), "primary")
for d in sorted(glob.glob(os.path.join(accounts_root, "claude", "*"))):
    scan(d, os.path.basename(d))
PY2
)
EOF
  [ "$found" = 1 ] || echo "  no conversations hit a limit in the last ${hours}h"
  [ -n "$go" ] || echo "  (add --go to park the account and move these to a healthy one)"
}

cmd_insights() { # [days]
  local days="${1:-7}"
  python3 - "$ACCOUNTS" "$HOME" "$days" "$(pools_dir)" <<'PY2'
import json, os, sys, time, glob
accounts_root, home, days, pools = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
since = time.time() - days * 86400

def email_of(d):
    try:
        return (json.load(open(os.path.join(d, ".claude.json"))).get("oauthAccount") or {}).get("emailAddress") or ""
    except Exception:
        return ""

def scan(d):
    t = dict(sessions=0, inp=0, out=0, cread=0, ccreate=0, limits=0, last=0, models=set(), daily=[0]*days, proj={})
    for f in glob.glob(os.path.join(d, "projects", "*", "*.jsonl")):
        try:
            st = os.stat(f)
        except OSError:
            continue
        if st.st_mtime < since or st.st_size > 25_000_000:
            continue
        t["sessions"] += 1
        t["last"] = max(t["last"], st.st_mtime)
        label = os.path.basename(os.path.dirname(f)).split("--")[-1]
        t["proj"][label] = t["proj"].get(label, 0) + 1
        try:
            text = open(f, errors="ignore").read()
        except OSError:
            continue
        for line in text.split("\n"):
            if '"usage"' not in line and "spend limit" not in line and "usage limit" not in line:
                continue
            try:
                o = json.loads(line)
            except Exception:
                continue
            if "spend limit" in line or "usage limit" in line:
                t["limits"] += 1
            m = o.get("message") or {}
            u = m.get("usage") or {}
            if not u:
                continue
            out = u.get("output_tokens") or 0
            t["inp"] += u.get("input_tokens") or 0
            t["out"] += out
            t["cread"] += u.get("cache_read_input_tokens") or 0
            t["ccreate"] += u.get("cache_creation_input_tokens") or 0
            if m.get("model") and m["model"] != "<synthetic>":
                t["models"].add(m["model"])
            ts = o.get("timestamp")
            when = None
            if ts:
                try:
                    when = time.mktime(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
                except Exception:
                    when = None
            when = when or st.st_mtime
            idx = days - 1 - int((time.time() - when) // 86400)
            if 0 <= idx < days:
                t["daily"][idx] += out
    return t

def human(n):
    return f"{n/1_000_000:.1f}M" if n >= 1_000_000 else (f"{round(n/1000)}k" if n >= 1000 else str(n))

def spark(vals):
    blocks = "▁▂▃▄▅▆▇█"
    top = max(vals) or 1
    return "".join(blocks[min(7, int(v / top * 7))] if v else "·" for v in vals)

dirs = [(email_of(home) or "primary", os.path.join(home, ".claude"), "primary")]
for d in sorted(glob.glob(os.path.join(accounts_root, "claude", "*"))):
    dirs.append((os.path.basename(d), d, "account"))

rows = [(name, kind, scan(d), d) for name, d, kind in dirs]
total_out = sum(r[2]["out"] for r in rows) or 1
print(f"\n  Last {days} days\n")
for name, kind, t, d in rows:
    if t["sessions"] == 0:
        print(f"  {name:28} {kind:8} no activity")
        continue
    tin = t["inp"] + t["cread"] + t["ccreate"]
    cache = round(t["cread"] / tin * 100) if tin else 0
    launches = 0
    key = "primary" if kind == "primary" else name
    try:
        launches = int(open(os.path.join(pools, f"count-claude-{key}")).read().strip())
    except Exception:
        pass
    print(f"  {name:28} {kind:8} {spark(t['daily'])}  {t['sessions']:>3} sessions · {human(t['out']):>5} out · {cache:>2}% cached · {round(t['out']/total_out*100):>2}% of work")
    extra = []
    if launches:
        extra.append(f"{launches} launches")
    if t["models"]:
        extra.append(", ".join(sorted(m.replace("claude-", "") for m in t["models"]))[:48])
    if t["proj"]:
        extra.append("mostly " + max(t["proj"], key=t["proj"].get))
    if extra:
        print(f"  {'':28} {'':8} {' · '.join(extra)}")
    if t["limits"]:
        ago = int((time.time() - t["last"]) / 60)
        print(f"  {'':28} {'':8} ⚠ {t['limits']} limit refusals · probe this account before relying on it")
print()
PY2
}

# The Paseo panel is an optional companion that ships in this repo. Install it
# only when Paseo is actually present — the CLI never depends on it.
REPO_URL="https://github.com/itsjustanks/agent-link"
RAW_URL="https://raw.githubusercontent.com/itsjustanks/agent-link/main/agent-link"

# ---------------------------------------------------------------- apps
#
# Integrations live in apps/<id>/ with an app.json describing how to install
# them. Nothing here is required: the CLI works on its own, and an app only
# appears as installable when the tool it targets is present.

apps_dir() { # find the apps/ directory, fetching or refreshing the repo
  local here d
  here="$(cd "$(dirname "$0")" && pwd)"
  # A checkout next to the script is the developer's own tree: use it as-is.
  for d in "$here/apps" "$here/../apps"; do
    [ -d "$d" ] && { echo "$d"; return 0; }
  done
  command -v git >/dev/null 2>&1 || { [ -d "$ROOT/src/apps" ] && { echo "$ROOT/src/apps"; return 0; }; return 1; }
  # The managed copy must be brought up to date, or an install would keep
  # reinstalling whatever was published the first time the CLI ever ran.
  if [ -d "$ROOT/src/.git" ]; then
    git -C "$ROOT/src" fetch -q --depth 1 origin HEAD 2>/dev/null &&
      git -C "$ROOT/src" reset -q --hard FETCH_HEAD 2>/dev/null ||
      echo "could not refresh $ROOT/src — installing the copy already there" >&2
    [ -d "$ROOT/src/apps" ] && { echo "$ROOT/src/apps"; return 0; }
  fi
  echo "fetching integrations from ${REPO_URL}…" >&2
  rm -rf "$ROOT/src.tmp"
  if git clone --depth 1 -q "$REPO_URL" "$ROOT/src.tmp" >&2; then
    rm -rf "$ROOT/src"; mv "$ROOT/src.tmp" "$ROOT/src"
    [ -d "$ROOT/src/apps" ] && { echo "$ROOT/src/apps"; return 0; }
  fi
  return 1
}

# Updating is two things — this file, and the app sources it installs from.
cmd_update() {
  local self target
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  echo
  if [ -d "$(dirname "$self")/.git" ] || [ -d "$(dirname "$self")/../.git" ]; then
    echo "  ${C_DIM}$self is a git checkout — pull it yourself.${C_OFF}"
  else
    target="$RAW_URL"
    printf '  updating %s… ' "$self"
    if curl -fsSL "$target" -o "$self.new" 2>/dev/null && [ -s "$self.new" ]; then
      chmod +x "$self.new"; mv "$self.new" "$self"
      echo "${C_GREEN}done${C_OFF} (now $("$self" --version 2>/dev/null || echo "?"))"
    else
      rm -f "$self.new"
      echo "${C_RED}failed${C_OFF} — check your connection, or re-run the curl from the README"
    fi
  fi
  # Anything installed from this repo gets the new source too, or the CLI and
  # its Paseo panel drift apart.
  local base d id
  base="$(apps_dir)" || { echo "  no apps to update"; return 0; }
  for d in "$base"/*/; do
    [ -f "$d/app.json" ] || continue
    [ "$(app_state "$d")" = installed ] || continue
    id="$(app_field "$d" id)"
    echo "  reinstalling the '${id}' app (this repo's panel — Paseo itself is untouched)…"
    cmd_app install "$id"
  done
}

app_field() { # $1 app dir, $2 key
  python3 - "$1/app.json" "$2" <<'PY2'
import json, sys
try:
    print(json.load(open(sys.argv[1])).get(sys.argv[2], "") or "")
except Exception:
    print("")
PY2
}

app_state() { # $1 app dir -> installed|available|unavailable
  local req kind pid
  req="$(app_field "$1" requires)"
  kind="$(app_field "$1" kind)"
  [ -n "$req" ] && ! command -v "$req" >/dev/null 2>&1 && { echo unavailable; return; }
  case "$kind" in
    paseo-plugin)
      pid="$(app_field "$1" pluginId)"
      paseo plugin ls 2>/dev/null | grep -q "^$pid" && echo installed || echo available
      ;;
    *) echo available ;;
  esac
}

# Paseo keeps its plugins in <paseo home>/plugins/<id> and identifies each one
# by that id. Installing means putting the source there and registering the id,
# which is exactly what these two helpers make automatic.
paseo_home() {
  local home
  home="$(paseo daemon status --json 2>/dev/null | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
print(d.get("home") or d.get("daemon", {}).get("home") or "")' 2>/dev/null)"
  [ -n "$home" ] && [ -d "$home" ] && { echo "$home"; return; }
  echo "$HOME/.paseo"
}

paseo_plugins_on() { # plugins are off by default and only the user may turn them on
  python3 - "$(paseo_home)/config.json" <<'PY3'
import json, sys
try:
    print("yes" if json.load(open(sys.argv[1])).get("pluginsEnabled") else "no")
except Exception:
    print("no")
PY3
}

install_paseo_plugin() { # $1 source dir, $2 plugin id, $3 "link" to run from source
  local src="$1" pid="$2" mode="${3:-copy}" dest home status
  command -v paseo >/dev/null 2>&1 || {
    echo "Paseo is not installed on this machine — this app is optional." >&2
    echo "Get it at https://paseo.sh, then run: agent-link app install paseo" >&2
    return 1; }
  command -v npm >/dev/null 2>&1 || {
    echo "This app needs Node.js (for npm) to build. Install Node 20+, then run this again." >&2
    return 1; }
  if [ "$(paseo_plugins_on)" != yes ]; then
    echo "Paseo has plugins switched off." >&2
    echo "Turn them on in Paseo → Settings → Plugins, then run: agent-link app install paseo" >&2
    return 1
  fi

  home="$(paseo_home)"
  if [ "$mode" = link ]; then
    dest="$src"
  else
    dest="$home/plugins/$pid"
    echo "installing into ${dest}…"
    mkdir -p "$dest" || return 1
    # Copy the source only: node_modules is rebuilt in place and .git is noise.
    ( cd "$src" && tar --exclude=node_modules --exclude=.git -cf - . ) | ( cd "$dest" && tar -xf - ) || return 1
    # Stamp what was installed, so the panel can tell whether main has moved on.
    local sha; sha="$(git -C "$src" rev-parse HEAD 2>/dev/null || true)"
    [ -n "$sha" ] && printf '{ "sha": "%s", "builtAt": "%s" }\n' "$sha" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dest/build.json"
  fi

  [ -d "$dest/node_modules" ] || { echo "installing dependencies…"; (cd "$dest" && npm install --silent --no-audit --no-fund) || return 1; }
  (cd "$dest" && npm run --silent typecheck) || { echo "app failed to typecheck — not installing" >&2; return 1; }

  # Paseo refuses to install over an existing id, so an upgrade means dropping
  # the registration first. That removes configuration only — never source.
  paseo plugin ls 2>/dev/null | grep -q "^$pid " && paseo plugin remove "$pid" >/dev/null 2>&1
  paseo plugin install "$dest" --id "$pid" >/dev/null || return 1
  status="$(paseo plugin ls 2>/dev/null | awk -v id="$pid" '$1 == id { print $2 }')"
  case "$status" in
    running) echo "installed and running. Open Paseo → Agent Link or MCP." ;;
    "")      echo "installed, but Paseo does not list it yet — check: paseo plugin ls" >&2 ;;
    *)       echo "installed but $status — check: paseo plugin logs $pid" >&2; return 1 ;;
  esac
}

cmd_app() { # list|install|status|remove [id] [--link]
  local action="${1:-list}" id="${2:-}" mode=copy base d state kind pid dest
  case "${3:-}" in --link|--dev) mode=link ;; esac
  base="$(apps_dir)" || { echo "no apps/ directory found and could not fetch it" >&2; return 1; }
  case "$action" in
    list|status)
      for d in "$base"/*/; do
        [ -f "$d/app.json" ] || continue
        state="$(app_state "$d")"
        case "$state" in
          installed)   printf '  %s●%s %-10s %-46s %sinstalled%s\n' "$C_GREEN" "$C_OFF" "$(app_field "$d" id)" "$(app_field "$d" summary)" "$C_GREEN" "$C_OFF" ;;
          available)   printf '  %s○%s %-10s %-46s %savailable — agent-link app install %s%s\n' "$C_DIM" "$C_OFF" "$(app_field "$d" id)" "$(app_field "$d" summary)" "$C_DIM" "$(app_field "$d" id)" "$C_OFF" ;;
          *)           printf '  %s·%s %-10s %-46s %s%s not installed on this machine%s\n' "$C_DIM" "$C_OFF" "$(app_field "$d" id)" "$(app_field "$d" summary)" "$C_DIM" "$(app_field "$d" requires)" "$C_OFF" ;;
        esac
      done
      return 0
      ;;
    install|remove) [ -n "$id" ] || { echo "usage: agent-link app $action <id>   (see: agent-link app list)" >&2; return 1; } ;;
    *) echo "usage: agent-link app [list|install|remove] [id] [--link]" >&2; return 1 ;;
  esac
  d="$base/$id"
  [ -f "$d/app.json" ] || { echo "no app called '$id' — try: agent-link app list" >&2; return 1; }
  kind="$(app_field "$d" kind)"; pid="$(app_field "$d" pluginId)"
  case "$kind" in
    paseo-plugin)
      if [ "$action" = remove ]; then
        command -v paseo >/dev/null 2>&1 || { echo "Paseo is not installed here." >&2; return 1; }
        paseo plugin remove "$pid" >/dev/null 2>&1
        dest="$(paseo_home)/plugins/$pid"
        # Only ever delete our own copy — a --link install points at your repo.
        [ -d "$dest" ] && [ "$dest" != "$d" ] && rm -rf "$dest"
        echo "removed. The source in apps/$id is untouched."
        return 0
      fi
      install_paseo_plugin "$d" "$pid" "$mode"
      ;;
    docs-only)
      [ "$action" = remove ] && { echo "nothing to remove — this app is instructions only"; return 0; }
      echo; sed 's/^/  /' "$d/$(app_field "$d" doc)"
      ;;
    *) echo "unknown app kind: $kind" >&2; return 1 ;;
  esac
}

# Back-compat: `agent-link plugin …` still means the Paseo app.
cmd_plugin() {
  case "${1:-status}" in
    status) cmd_app list ;;
    install) cmd_app install paseo ;;
    remove) cmd_app remove paseo ;;
    *) echo "usage: agent-link plugin [install|status|remove]" >&2; return 1 ;;
  esac
}

# One key that does the obvious maintenance: sideline accounts that cannot serve
# your model, move conversations off them, and put every account back in step.
cmd_fix() { # [model]
  local model="${1:-}"
  echo
  printf '  %s1. testing each account%s\n' "$C_BOLD" "$C_OFF"
  cmd_probe claude "$model" --park || true
  printf '  %s2. conversations stopped by a limit%s\n' "$C_BOLD" "$C_OFF"
  cmd_rescue 6 --go || true
  printf '  %s3. bringing settings and MCP into line%s\n' "$C_BOLD" "$C_OFF"
  cmd_sync 2>&1 | sed 's/^/    /'
  echo
  printf '  %sdone — current state:%s\n' "$C_BOLD" "$C_OFF"
  cmd_status
}

cmd_whoami() { # [provider]
  local p pdir email kind runs nxt
  for p in ${1:-$PROVIDERS}; do
    prov_valid "$p" || continue
    pdir="$(eval "printf '%s' \"\${$(prov_env_var "$p"):-}\"")"
    if [ -n "$pdir" ]; then
      email="$(prov_email "$p" "$pdir")"
      kind="account"
      runs="$(cat "$(pools_dir)/count-$p-$(basename "$pdir")" 2>/dev/null || echo 0)"
    else
      email="$(primary_email "$p")"
      kind="primary"
      runs="$(cat "$(pools_dir)/count-$p-primary" 2>/dev/null || echo 0)"
    fi
    [ -n "$email" ] || continue
    nxt="$(pick_slot "$p" dry 2>/dev/null || echo "-")"
    printf '%s: %s (%s, %s launches) · next: %s\n' "$p" "$email" "$kind" "$runs" "$nxt"
  done
}

cmd_pools() { # show what auto-routing sees
  local p e now until last state
  now="$(date +%s)"
  for p in $PROVIDERS; do
    echo "$p"
    for e in $(slot_list "$p"); do
      until="$(cat "$(pools_dir)/cooldown-$p-$e" 2>/dev/null || echo 0)"
      last="$(cat "$(pools_dir)/last-$p-$e" 2>/dev/null || echo 0)"
      if ! prov_logged_in "$p" "$(slot_dir "$p" "$e")"; then
        state="not logged in"
      elif [ "$until" -gt "$now" ]; then
        state="cooling down $(( (until - now + 59) / 60 ))m"
      else
        state="available"
      fi
      if [ "$last" -gt 0 ]; then
        printf '  %-28s %-20s last used %sm ago\n' "$e" "$state" "$(( (now - last) / 60 ))"
      else
        printf '  %-28s %-20s never used\n' "$e" "$state"
      fi
    done
  done
  [ -x "$SHIM_BIN/claude-auto" ] || echo "(no auto launchers yet — run: agent-link auto)"
  return 0
}

cmd_shims() { # numbered per-slot shims: claude-1, codex-2, ...
  local p e i env_var f
  mkdir -p "$SHIM_BIN"
  for p in $PROVIDERS; do
    for f in "$SHIM_BIN/$p"-[0-9] "$SHIM_BIN/$p"-[0-9][0-9]; do
      [ -e "$f" ] && rm -f "$f"
    done
    env_var="$(prov_env_var "$p")"
    pemail="$(primary_email "$p")"
    pcov=""
    for e in $(slot_list "$p"); do
      [ "$(prov_email "$p" "$(slot_dir "$p" "$e")")" = "$pemail" ] && pcov=1
    done
    if [ -n "$pemail" ]; then
      pruns="$(cat "$(pools_dir)/count-$p-primary" 2>/dev/null || echo 0)"
      puntil="$(cat "$(pools_dir)/cooldown-$p-primary" 2>/dev/null || echo 0)"
      pnow="$(date +%s)"
      if [ -n "$pcov" ]; then
        pnote="duplicated by a slot below"
      elif [ "$puntil" -gt "$pnow" ]; then
        pnote="parked $(( (puntil - pnow + 59) / 60 ))m — $(cat "$(pools_dir)/reason-$p-primary" 2>/dev/null || echo 'routing skips it')"
      else
        pnote="in rotation · ${pruns} launches"
      fi
      printf '    %s %-30s %-14s %s%s%s\n' "${C_GREEN}●${C_OFF}" "$pemail" "primary" "$C_DIM" "$pnote" "$C_OFF"
    fi
    i=0
    for e in $(slot_list "$p"); do
      i=$((i+1))
      cat > "$SHIM_BIN/$p-$i" <<EOF
#!/usr/bin/env bash
# agent-link slot shim: $p account $e — managed by \`agent-link shims\`.
here="\$(cd "\$(dirname "\$0")" && pwd)"
real=""
old_ifs="\$IFS"; IFS=:
for d in \$PATH; do
  [ -n "\$d" ] || continue
  [ "\$d" = "\$here" ] && continue
  if [ -x "\$d/$p" ] && [ ! "\$d/$p" -ef "\$here/$p" ]; then real="\$d/$p"; break; fi
done
IFS="\$old_ifs"
[ -n "\$real" ] || { echo "agent-link: real '$p' binary not found in PATH" >&2; exit 127; }
export $env_var="\${AGENT_LINK_HOME:-\${AGENT_AUTH_HOME:-$ROOT}}/accounts/$p/$e"
exec "\$real" "\$@"
EOF
      chmod +x "$SHIM_BIN/$p-$i"
      echo "wrote $SHIM_BIN/$p-$i -> $e"
    done
  done
  case ":$PATH:" in
    *":$SHIM_BIN:"*) ;;
    *) echo; echo "note: $SHIM_BIN is not in PATH — add to your shell profile:"
       echo "  export PATH=\"$SHIM_BIN:\$PATH\"" ;;
  esac
}

cmd_env() { # provider email — print eval-able export
  prov_valid "${1:-}" && valid_account "${2:-}" || { echo "usage: agent-link env <claude|codex> <email>" >&2; return 1; }
  [ -d "$(slot_dir "$1" "$2")" ] || { echo "no $1 slot '$2'" >&2; return 1; }
  echo "export $(prov_env_var "$1")=\"$(slot_dir "$1" "$2")\""
}

cmd_run() { # provider email [cmd...]
  prov_valid "${1:-}" && valid_account "${2:-}" || { echo "usage: agent-link run <claude|codex> <email> [command...]" >&2; return 1; }
  local p="$1" e="$2" dir
  dir="$(slot_dir "$p" "$e")"
  [ -d "$dir" ] || { echo "no $p slot '$e'" >&2; return 1; }
  shift 2
  [ $# -gt 0 ] || set -- "$(prov_binary "$p")"
  env "$(prov_env_var "$p")=$dir" "$@"
}

cmd_remove() { # provider email — delete a slot (its credentials die with it)
  prov_valid "${1:-}" || { echo "usage: agent-link remove <claude|codex> <email>" >&2; return 1; }
  # Never let a path fragment through: this function deletes a directory.
  valid_account "${2:-}" || { echo "invalid account name: '${2:-}'" >&2; return 1; }
  local p="$1" e="$2" dir a
  dir="$(slot_dir "$p" "$e")"
  [ -d "$dir" ] || { echo "no $p slot '$e'" >&2; return 1; }
  printf "Delete the %s slot for %s, INCLUDING its login? [y/N] " "$p" "$e"
  read -r a || return 1
  case "$a" in y|Y|yes|YES) ;; *) echo "aborted"; return 1;; esac
  rm -rf "$dir"
  if [ -f "$(order_file "$p")" ]; then
    grep -vxF "$e" "$(order_file "$p")" > "$(order_file "$p").tmp" || true
    mv "$(order_file "$p").tmp" "$(order_file "$p")"
  fi
  if [ "$(cat "$(route_file "$p")" 2>/dev/null)" = "$e" ]; then
    echo primary > "$(route_file "$p")"
    echo "plain \`$p\` was routed to this slot — reset to primary"
  fi
  # Numbering is positional, so every later slot shifts down. Rewrite the
  # numbered shims now rather than leaving one pointing at a deleted slot.
  if ls "$SHIM_BIN/$p"-[0-9]* >/dev/null 2>&1; then
    rm -f "$SHIM_BIN/$p"-[0-9]*
    cmd_shims >/dev/null
    echo "removed. Numbered shims rebuilt — $p-N numbers may now refer to different accounts."
  else
    echo "removed."
  fi
}

cmd_sync() { # propagate MCP definitions + project trust from primaries into slots
  # codex: slot config.toml <- primary ~/.codex/config.toml (MCP servers live there),
  # re-pinned to file credential storage. Overwrites slot-local config edits.
  local d
  if [ -f "$HOME/.codex/config.toml" ]; then
    for d in "$ACCOUNTS/codex"/*/; do
      [ -d "$d" ] || continue
      cp "$HOME/.codex/config.toml" "${d}config.toml"
      codex_pin_file_store "${d}config.toml"
      echo "$(basename "$d"): codex config.toml synced from primary (file-store pinned)"
      [ -f "$HOME/.codex/AGENTS.md" ] && cp "$HOME/.codex/AGENTS.md" "${d}AGENTS.md" && echo "$(basename "$d"): AGENTS.md synced"
    done
  fi
  # claude: slot .claude.json <- definitions and trust from primary ~/.claude.json
  python3 - "$ACCOUNTS/claude" <<'PY'
import json, os, sys, glob

root = sys.argv[1]
primary_path = os.path.expanduser("~/.claude.json")
if not os.path.exists(primary_path):
    print("no primary ~/.claude.json — nothing to sync"); sys.exit(0)
primary = json.load(open(primary_path))
mcp = primary.get("mcpServers", {})
projects = primary.get("projects", {})
GLOBAL_FLAGS = ["hasCompletedOnboarding", "bypassPermissionsModeAccepted", "theme", "autoUpdates", "effortLevel"]
SETTINGS_KEYS = ["outputStyle", "includeCoAuthoredBy", "env", "permissions", "model"]
PROJECT_FIELDS = ["hasTrustDialogAccepted", "hasCompletedProjectOnboarding", "allowedTools",
                  "mcpServers", "enabledMcpjsonServers", "disabledMcpjsonServers", "dontCrawlDirectory"]
slots = sorted(glob.glob(os.path.join(root, "*/")))
if not slots:
    print("no claude slots yet"); sys.exit(0)
for slot_dir in slots:
    slot_path = os.path.join(slot_dir, ".claude.json")
    slot = {}
    if os.path.exists(slot_path):
        try:
            slot = json.load(open(slot_path))
        except Exception as exc:
            print(f"{os.path.basename(slot_dir.rstrip('/'))}: SKIPPED — unreadable .claude.json ({exc})")
            continue
    # Union, not replace: a server added inside a slot must survive a sync.
    merged = dict(slot.get("mcpServers") or {})
    merged.update(mcp)
    slot["mcpServers"] = merged
    for flag in GLOBAL_FLAGS:
        if flag in primary:
            slot[flag] = primary[flag]
    slot_projects = slot.setdefault("projects", {})
    trusted = 0
    for path, entry in projects.items():
        if not entry.get("hasTrustDialogAccepted"):
            continue
        trusted += 1
        tgt = slot_projects.setdefault(path, {})
        for field in PROJECT_FIELDS:
            if field in entry:
                tgt[field] = entry[field]
    tmp = slot_path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(slot, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, slot_path)
    print(f"{os.path.basename(slot_dir.rstrip('/'))}: {len(mcp)} MCP servers, {trusted} trusted projects")
# settings.json + custom output styles: preferences, never credentials
import shutil
src_settings = os.path.expanduser("~/.claude/settings.json")
src_styles = os.path.expanduser("~/.claude/output-styles")
if os.path.exists(src_settings):
    try:
        base = json.load(open(src_settings))
    except Exception:
        base = {}
    for slot_dir in slots:
        target = os.path.join(slot_dir, "settings.json")
        cur = {}
        if os.path.exists(target):
            try:
                cur = json.load(open(target))
            except Exception:
                cur = {}
        for k in SETTINGS_KEYS:
            if k in base:
                cur[k] = base[k]
        json.dump(cur, open(target, "w"), indent=2)
    print(f"settings synced ({', '.join(k for k in SETTINGS_KEYS if k in base)})")
if os.path.isdir(src_styles):
    for slot_dir in slots:
        dest = os.path.join(slot_dir, "output-styles")
        os.makedirs(dest, exist_ok=True)
        for f in os.listdir(src_styles):
            if f.endswith(".md"):
                shutil.copy(os.path.join(src_styles, f), os.path.join(dest, f))
    print("output styles synced")
print("==> synced definitions only; OAuth tokens are per-slot and never copied.")
PY
}

cmd_doctor() {
  local p ok=0
  command -v python3 >/dev/null || { echo "[!] python3 not found (required)"; ok=1; }
  for p in $PROVIDERS; do
    if command -v "$p" >/dev/null; then
      echo "[x] $p binary: $(command -v "$p")"
    else
      echo "[ ] $p binary not found (only needed if you manage $p accounts)"
    fi
  done
  if command -v claude >/dev/null && ! claude auth login --help >/dev/null 2>&1; then
    echo "[!] this Claude Code version predates 'claude auth login' — logins will open"
    echo "    the full REPL instead. Update with: claude update"
    ok=1
  fi
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    echo "[!] CLAUDE_CONFIG_DIR is set globally in this shell ($CLAUDE_CONFIG_DIR)."
    echo "    That re-points your PRIMARY claude. agent-link never needs this set globally."
    ok=1
  fi
  for d in "$ACCOUNTS/codex"/*/; do
    [ -d "$d" ] || continue
    grep -q '^cli_auth_credentials_store *= *"file"' "$d/config.toml" 2>/dev/null \
      || { echo "[!] $(basename "$d"): codex slot missing cli_auth_credentials_store=\"file\" pin"; ok=1; }
  done
  cmd_route status
  [ "$ok" = 0 ] && echo "All good."
  return "$ok"
}

cmd_interactive() {
  local choice p e n warn parked blocked
  while :; do
    printf '\n  %sagent-link %s%s   %s%s%s\n' "$C_BOLD" "$VERSION" "$C_OFF" "$C_DIM" "$ROOT" "$C_OFF"
    cmd_status
    # A single line that says whether anything needs you.
    warn=""
    parked=$(ls "$(pools_dir)"/cooldown-* 2>/dev/null | wc -l | tr -d ' ')
    blocked=$(for pr in $PROVIDERS; do for em in $(slot_list "$pr"); do
      prov_logged_in "$pr" "$(slot_dir "$pr" "$em")" || echo x; done; done | wc -l | tr -d ' ')
    [ "$parked" != 0 ] && warn="$warn${warn:+ · }$parked parked"
    [ "$blocked" != 0 ] && warn="$warn${warn:+ · }$blocked need sign-in"
    if [ -n "$warn" ]; then
      printf '\n  %s! %s%s  %spress f to sort it out%s\n' "$C_YELLOW" "$warn" "$C_OFF" "$C_DIM" "$C_OFF"
    else
      printf '\n  %s✓ every account is signed in and in rotation%s\n' "$C_GREEN" "$C_OFF"
    fi
    echo
    printf '  %sf%s %sfix everything%s   %sa%s add   %sl%s log in   %sr%s remove\n' \
      "$C_CYAN" "$C_OFF" "$C_BOLD" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF"
    printf '  %sd%s router   %su%s pin   %ss%s shims   %sp%s park   %sk%s unpark   %st%s test model   %sx%s rescue\n' \
      "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF"
    printf '  %si%s insights   %sw%s whoami   %sy%s sync   %sg%s apps   %s?%s doctor   %sq%s quit\n' \
      "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF"
    printf '  %s> %s' "$C_CYAN" "$C_OFF"
    # Single keypress when we have a terminal; fall back to a line otherwise.
    if [ -t 0 ]; then read -r -n 1 choice; echo; else read -r choice || return 0; fi
    case "$choice" in
      f|F)
        printf '  model to test [claude-fable-5]: '; read -r n
        cmd_fix "${n:-claude-fable-5}" || true
        ;;
      a|A)
        printf '  provider (claude/codex): '; read -r p
        printf '  account email: '; read -r e
        cmd_add "$p" "$e" || true
        ;;
      l|L) cmd_login all || true ;;
      r|R)
        printf '  provider (claude/codex): '; read -r p
        printf '  account email: '; read -r e
        cmd_remove "$p" "$e" || true
        ;;
      d|D) cmd_auto ;;
      u|U)
        printf '  provider (claude/codex): '; read -r p
        printf '  pin plain command to (email, number, or "primary"): '; read -r n
        cmd_use "$p" "$n" || true
        ;;
      s|S) cmd_shims ;;
      p|P)
        printf '  provider (claude/codex): '; read -r p
        printf '  account email (or "primary"): '; read -r e
        printf '  minutes [180]: '; read -r n
        cmd_cooldown "$p" "$e" "${n:-180}" || true
        ;;
      k|K)
        printf '  provider (claude/codex): '; read -r p
        printf '  account email (or "primary"): '; read -r e
        cmd_cooldown "$p" "$e" clear || true
        ;;
      t|T)
        printf '  model [claude-fable-5]: '; read -r n
        printf '  park the ones that refuse? [y/N] '; read -r e
        case "$e" in y|Y) cmd_probe claude "${n:-claude-fable-5}" --park || true ;; *) cmd_probe claude "${n:-claude-fable-5}" || true ;; esac
        ;;
      x|X)
        printf '  look back how many hours? [6] '; read -r n
        printf '  move them to a healthy account? [y/N] '; read -r e
        case "$e" in y|Y) cmd_rescue "${n:-6}" --go || true ;; *) cmd_rescue "${n:-6}" || true ;; esac
        ;;
      i|I)
        printf '  days [7]: '; read -r n
        cmd_insights "${n:-7}" || true
        ;;
      w|W) cmd_whoami || true ;;
      y|Y) cmd_sync || true ;;
      g|G)
        echo; cmd_app list
        printf '  install/remove which? [id, or enter to skip] '; read -r n
        if [ -n "$n" ]; then
          printf '  (i)nstall or (r)emove? [i] '; read -r e
          case "$e" in r|R) cmd_app remove "$n" || true ;; *) cmd_app install "$n" || true ;; esac
        fi
        ;;
      '?'|h|H) cmd_doctor || true ;;
      q|Q) return 0 ;;
      "") ;;
      *) printf '  %sunknown key: %s%s\n' "$C_DIM" "$choice" "$C_OFF" ;;
    esac
  done
}

usage() {
  cat <<EOF
agent-link $VERSION — multi-account manager for AI coding CLIs (claude, codex)

usage:
  agent-link                       interactive mode
  agent-link status                show every account slot and where routing points
  agent-link add <prov> <email>    create a slot and log it in
  agent-link login [prov] [email|all]   (re)login slots that need it
  agent-link use <prov> <email|N|primary>  route plain \`claude\`/\`codex\` to a slot
  agent-link route enable|disable|status   manage the routing shims
  agent-link shims                 write numbered shims: claude-1, claude-2, codex-1 ...
  agent-link auto                  write auto-routing launchers (one provider, many accounts)
  agent-link pools                 show what auto-routing sees (available / cooling down)
  agent-link cooldown <prov> <email> [min|clear]   park an exhausted account
  agent-link handoff <prov> <session-id> <email>   move a chat to another account
  agent-link env <prov> <email>    print an eval-able export for one slot
  agent-link run <prov> <email> [cmd...]   run a command under a slot's account
  agent-link claude [args...]      run Claude Code on the next account in rotation
  agent-link codex  [args...]      same for Codex
  agent-link remove <prov> <email> delete a slot and its login
  agent-link sync                  copy MCP servers + project trust from primaries into slots
  agent-link app [list|install|remove] [id] [--link]  optional integrations (Paseo panel, editors)
  agent-link update                update the CLI and reinstall the apps you have
  agent-link fix [model]           test accounts, rescue stuck chats, resync — the one-shot cleanup
  agent-link doctor                sanity checks

slots live in \$AGENT_AUTH_HOME (default ~/.agent-link), one folder per account email.
Your primary ~/.claude and ~/.codex are never modified.
EOF
}

main() {
  mkdir -p "$ACCOUNTS/claude" "$ACCOUNTS/codex" "$STATE"
  case "${1:-}" in
    "") if [ -t 0 ]; then cmd_interactive; else cmd_status; fi ;;
    status)  cmd_status ;;
    add)     shift; cmd_add "$@" ;;
    login)   shift; cmd_login "$@" ;;
    use)     shift; cmd_use "$@" ;;
    route)   shift; cmd_route "${1:-status}" ;;
    shims)   cmd_shims ;;
    auto)    cmd_auto ;;
    pick)    shift; cmd_pick "$@" ;;
    handoff) shift; cmd_handoff "$@" ;;
    pools)   cmd_pools ;;
    whoami)  shift; cmd_whoami "$@" ;;
    plugin)  shift; cmd_plugin "$@" ;;
    app)     shift; cmd_app "$@" ;;
    update)  cmd_update ;;
    insights) shift; cmd_insights "$@" ;;
    rescue)  shift; cmd_rescue "$@" ;;
    probe)   shift; cmd_probe "$@" ;;
    next)    shift; prov_valid "${1:-claude}" && pick_slot "${1:-claude}" dry ;;
    cooldown) shift; cmd_cooldown "$@" ;;
    env)     shift; cmd_env "$@" ;;
    run)     shift; cmd_run "$@" ;;
    remove)  shift; cmd_remove "$@" ;;
    sync)    cmd_sync ;;
    fix)     shift; cmd_fix "$@" ;;
    doctor)  cmd_doctor ;;
    claude|codex) cmd_exec_auto "$@" ;;
    version|--version|-v) echo "$VERSION" ;;
    help|--help|-h|*) usage ;;
  esac
}

main "$@"
