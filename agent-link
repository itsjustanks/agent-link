# ---------------------------------------------------------------- presentation

# Colour only for a real terminal, and never when NO_COLOR is set.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  C_OFF=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_CYAN=$'\033[36m'
else
  C_OFF=""; C_BOLD=""; C_DIM=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_CYAN=""
fi

# One place that knows how an account should look: dot colour + words.
slot_state() { # $1 provider, $2 email -> "dot|state|note"
  local dir got until now last mins runs held_models suffix
  dir="$(slot_dir "$1" "$2")"
  if ! prov_logged_in "$1" "$dir"; then
    printf '%s|%s|%s' "${C_YELLOW}○${C_OFF}" "not logged in" "run 'l' to log in"
    return
  fi
  got="$(prov_email "$1" "$dir")"
  if [ -n "$got" ] && [ "$got" != "$2" ]; then
    printf '%s|%s|%s' "${C_RED}●${C_OFF}" "WRONG ACCOUNT" "signed in as $got"
    return
  fi
  now="$(date +%s)"
  until="$(cat "$(pools_dir)/cooldown-$1-$2" 2>/dev/null || echo 0)"
  last="$(cat "$(pools_dir)/last-$1-$2" 2>/dev/null || echo 0)"
  held_models="$(model_holds_text "$1" "$2")"
  suffix="${held_models:+ · unavailable: $held_models}"
  if [ "$until" -gt "$now" ]; then
    printf '%s|%s|%s' "${C_RED}●${C_OFF}" "logged in" "parked $(( (until - now + 59) / 60 ))m — $(cat "$(pools_dir)/reason-$1-$2" 2>/dev/null || echo 'routing skips it')"
    return
  fi
  local runs
  runs="$(cat "$(pools_dir)/count-$1-$2" 2>/dev/null || echo 0)"
  if [ "$last" -gt 0 ]; then
    mins=$(( (now - last) / 60 ))
    printf '%s|%s|%s' "${C_GREEN}●${C_OFF}" "logged in" "in rotation · ${runs} launches · last ${mins}m ago${suffix}"
  else
    printf '%s|%s|%s' "${C_GREEN}●${C_OFF}" "logged in" "in rotation · never used${suffix}"
  fi
}

cmd_status() {
  local p e i pointer state dot words note auto right pad pemail pcov pruns pnote puntil pnow
  for p in $PROVIDERS; do
    pointer="primary"
    [ -f "$(route_file "$p")" ] && pointer="$(cat "$(route_file "$p")")"
    echo
    right="plain \`$p\` → $pointer"
    pad=$(( 60 - ${#p} - ${#right} )); [ "$pad" -lt 2 ] && pad=2
    printf '  %s%s%s%*s%s%s%s\n' "$C_BOLD" "$(echo "$p" | tr '[:lower:]' '[:upper:]')" "$C_OFF" \
      "$pad" "" "$C_DIM" "$right" "$C_OFF"
    pemail="$(primary_email "$p")"
    pcov=""
    for e in $(slot_list "$p"); do
      [ "$(prov_email "$p" "$(slot_dir "$p" "$e")")" = "$pemail" ] && pcov=1
    done
    if [ -n "$pemail" ]; then
      pruns="$(cat "$(pools_dir)/count-$p-primary" 2>/dev/null || echo 0)"
      puntil="$(cat "$(pools_dir)/cooldown-$p-primary" 2>/dev/null || echo 0)"
      pnow="$(date +%s)"
      if [ -n "$pcov" ]; then
        pnote="duplicated by a slot below"
      elif [ "$puntil" -gt "$pnow" ]; then
        pnote="parked $(( (puntil - pnow + 59) / 60 ))m — $(cat "$(pools_dir)/reason-$p-primary" 2>/dev/null || echo 'routing skips it')"
      else
        pnote="in rotation · ${pruns} launches"
      fi
      printf '    %s %-30s %-14s %s%s%s\n' "${C_GREEN}●${C_OFF}" "$pemail" "primary" "$C_DIM" "$pnote" "$C_OFF"
    fi
    i=0
    for e in $(slot_list "$p"); do
      i=$((i+1))
      state="$(slot_state "$p" "$e")"
      dot="${state%%|*}"; words="$(echo "$state" | cut -d'|' -f2)"; note="${state##*|}"
      printf '    %s %-30s %-14s %s%s%s\n' "$dot" "$e" "$words" "$C_DIM" "$note" "$C_OFF"
    done
    [ "$i" = 0 ] && printf '    %sno accounts yet — press %sa%s to add one%s\n' "$C_DIM" "$C_BOLD" "$C_DIM" "$C_OFF"
    if [ -x "$SHIM_BIN/$p-auto" ]; then
      auto="${C_GREEN}ready${C_OFF} ${C_DIM}($SHIM_BIN/$p-auto)${C_OFF}"
    else
      auto="${C_DIM}not set up — press d${C_OFF}"
    fi
    printf '    %sdynamic routing:%s %b\n' "$C_DIM" "$C_OFF" "$auto"
  done
  return 0
}

cmd_add() { # provider email
  prov_valid "${1:-}" || { echo "usage: agent-link add <claude|codex> <email>" >&2; return 1; }
  valid_account "${2:-}" || { echo "invalid account name: '${2:-}'" >&2; return 1; }
  slot_login "$1" "$2"
}

cmd_login() { # [provider] [email|all]
  local p e i
  case "${1:-all}" in
    all)
      for p in $PROVIDERS; do
        i=0
        for e in $(slot_list "$p"); do
          i=$((i+1))
          slot_check "$p" "$e" "$i" >/dev/null || slot_login "$p" "$e"
        done
      done
      ;;
    claude|codex)
      p="$1"
      if [ -n "${2:-}" ] && [ "${2:-}" != all ]; then
        [ -d "$(slot_dir "$p" "$2")" ] || { echo "no $p slot for '$2' — use: agent-link add $p $2" >&2; return 1; }
        slot_login "$p" "$2"
      else
        i=0
        for e in $(slot_list "$p"); do
          i=$((i+1))
          slot_check "$p" "$e" "$i" >/dev/null || slot_login "$p" "$e"
        done
      fi
      ;;
    *)
      # bare email — find it in any provider
      local found=0
      for p in $PROVIDERS; do
        [ -d "$(slot_dir "$p" "$1")" ] && { slot_login "$p" "$1"; found=1; }
      done
      [ "$found" = 1 ] || { echo "no slot folder for '$1'" >&2; return 1; }
      ;;
  esac
}

cmd_use() { # provider email|primary|<number>
  prov_valid "${1:-}" || { echo "usage: agent-link use <claude|codex> <email|primary|N>" >&2; return 1; }
  local p="$1" target="${2:-}" e i
  [ -n "$target" ] || { echo "usage: agent-link use <claude|codex> <email|primary|N>" >&2; return 1; }
  if [ "$target" != primary ] && ! [ -d "$(slot_dir "$p" "$target")" ]; then
    # allow numeric selection
    if echo "$target" | grep -q '^[0-9][0-9]*$'; then
      i=0
      for e in $(slot_list "$p"); do
        i=$((i+1))
        [ "$i" = "$target" ] && { target="$e"; break; }
      done
    fi
    [ -d "$(slot_dir "$p" "$target")" ] || { echo "no $p slot '$2'" >&2; return 1; }
  fi
  mkdir -p "$STATE"
  echo "$target" > "$(route_file "$p")"
  echo "plain \`$p\` now routes to: $target (new processes only; running ones are unaffected)"
  if [ ! -x "$SHIM_BIN/$p" ]; then
    echo "note: routing shim not installed yet — run: agent-link route enable"
  fi
}

write_router_shim() { # $1 provider
  local p="$1" trust_block=""
  [ "$p" = claude ] && trust_block="$(claude_trust_block)"
  mkdir -p "$SHIM_BIN"
  cat > "$SHIM_BIN/$p" <<EOF
#!/usr/bin/env bash
# agent-link router shim — managed by \`agent-link route\`. Do not edit.
here="\$(cd "\$(dirname "\$0")" && pwd)"
aa_root="\${AGENT_LINK_HOME:-\${AGENT_AUTH_HOME:-$ROOT}}"
target="\$(cat "\$aa_root/state/route-$p" 2>/dev/null || true)"
real=""
old_ifs="\$IFS"; IFS=:
for d in \$PATH; do
  [ -n "\$d" ] || continue
  [ "\$d" = "\$here" ] && continue
  if [ -x "\$d/$p" ] && [ ! "\$d/$p" -ef "\$here/$p" ]; then real="\$d/$p"; break; fi
done
IFS="\$old_ifs"
[ -n "\$real" ] || { echo "agent-link: real '$p' binary not found in PATH" >&2; exit 127; }
# An explicitly inherited value always wins: otherwise this shim would rewrite
# the env of \`agent-link add/run/env\` and send a login into the routed slot.
if [ -z "\${$(prov_env_var "$p"):-}" ] && [ -n "\$target" ] && [ "\$target" != "primary" ]; then
  export $(prov_env_var "$p")="\$aa_root/accounts/$p/\$target"
fi
$trust_block
exec "\$real" "\$@"
EOF
  chmod +x "$SHIM_BIN/$p"
}

cmd_route() { # enable|disable|status
  local p
  case "${1:-status}" in
    enable)
      for p in $PROVIDERS; do write_router_shim "$p"; done
      echo "Router shims written to $SHIM_BIN"
      echo
      echo "Put them FIRST in PATH by adding this to your shell profile:"
      echo "  export PATH=\"$SHIM_BIN:\$PATH\""
      echo
      echo "Then: agent-link use claude <email>   # or 'primary' to route back"
      ;;
    disable)
      for p in $PROVIDERS; do rm -f "$SHIM_BIN/$p"; done
      echo "Router shims removed. Plain commands hit your real binaries again."
      ;;
    status|*)
      for p in $PROVIDERS; do
        if [ -x "$SHIM_BIN/$p" ]; then
          printf '%s: shim installed, routing to %s\n' "$p" "$(cat "$(route_file "$p")" 2>/dev/null || echo primary)"
        else
          printf '%s: no shim (plain `%s` is untouched)\n' "$p" "$p"
        fi
      done
      case ":$PATH:" in
        *":$SHIM_BIN:"*) ;;
        *)
          if [ -x "$SHIM_BIN/claude" ] || [ -x "$SHIM_BIN/codex" ]; then
            echo "warning: $SHIM_BIN is not in PATH — routing is inert until it is (and first)"
          fi
          ;;
      esac
      return 0
      ;;
  esac
}

# An untrusted project makes Claude IGNORE every permissions.allow entry, and a
# freshly created slot trusts nothing — agents routed there stall on permission
# prompts until their runtime dies (measured: repeated "Ignoring 69
# permissions.allow entries" stderr, every one on an unsynced slot). Launching
# in a directory IS the user's trust decision, so each claude launcher marks
# its cwd trusted in the chosen account first. Unreadable config: touch nothing.
claude_trust_block() {
  cat <<'TRUST'
aa_cfg="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"
if [ -f "$aa_cfg" ]; then
  python3 - "$aa_cfg" "$PWD" <<'AAPY' 2>/dev/null
import json, os, sys
path, cwd = sys.argv[1], sys.argv[2]
try:
    config = json.load(open(path))
except Exception:
    sys.exit(0)  # exists but unreadable: never rewrite what could not be read
projects = config.setdefault("projects", {})
entry = projects.setdefault(cwd, {})
if entry.get("hasTrustDialogAccepted") is not True:
    entry["hasTrustDialogAccepted"] = True
    tmp = path + ".al-tmp"
    with open(tmp, "w") as fh:
        json.dump(config, fh, indent=2)
    os.replace(tmp, path)
AAPY
fi
TRUST
}

write_auto_launcher() { # $1 provider — one command that routes to a live account
  local p="$1" env_var self primary_search cont_flags
  # Continue-style flags differ by CLI — and clash: codex uses -c for a CONFIG
  # override, so treating it as "continue" would reroute a fresh launch.
  case "$p" in
    claude) cont_flags='-c|--continue' ;;
    *)      cont_flags='--last' ;;
  esac
  local trust_block=""
  [ "$p" = claude ] && trust_block="$(claude_trust_block)"
  primary_search="$(primary_dir "$1")"
  env_var="$(prov_env_var "$p")"
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  mkdir -p "$SHIM_BIN"
  cat > "$SHIM_BIN/$p-auto" <<EOF
#!/usr/bin/env bash
# agent-link auto-routing launcher for $p — managed by \`agent-link auto\`.
# Picks a logged-in, non-cooled-down account at launch and execs the real CLI.
# Point one editor/orchestrator provider at this file instead of picking
# accounts by hand. Running processes are never re-routed.
here="\$(cd "\$(dirname "\$0")" && pwd)"
aa_root="\${AGENT_LINK_HOME:-\${AGENT_AUTH_HOME:-$ROOT}}"
real=""
old_ifs="\$IFS"; IFS=:
for d in \$PATH; do
  [ -n "\$d" ] || continue
  [ "\$d" = "\$here" ] && continue
  if [ -x "\$d/$p" ] && [ ! "\$d/$p" -ef "\$here/$p" ]; then real="\$d/$p"; break; fi
done
IFS="\$old_ifs"
[ -n "\$real" ] || real="$(command -v "$p" 2>/dev/null || echo "$p")"
# A resumed session only exists in the account that created it, so routing a
# resume elsewhere fails with "No conversation found with session ID". Detect a
# session id in the args and pin to the account that owns it.
aa_sid=""
aa_cont=""
aa_prev=""
aa_model=""
for aa_a in "\$@"; do
  case "\$aa_a" in
    --resume=*) aa_sid="\${aa_a#--resume=}" ;;
    --model=*) aa_model="\${aa_a#--model=}" ;;
    $cont_flags) aa_cont=1 ;;
    -*) ;;
    *)
      case "\$aa_prev" in
        --resume|-r|resume) aa_sid="\$aa_a" ;;
        --model) aa_model="\$aa_a" ;;
      esac
      ;;
  esac
  aa_prev="\$aa_a"
done
# Paseo persists the selected model on the agent record. Some resume launches
# do not repeat --model, so recover it before model-scoped health filtering.
aa_agent_file=""
if [ -n "\${PASEO_AGENT_ID:-}" ]; then
  aa_paseo_home="\${PASEO_HOME:-\$HOME/.paseo}"
  aa_agent_file="\$(find "\$aa_paseo_home/agents" -maxdepth 2 -type f -name "\${PASEO_AGENT_ID}.json" -print -quit 2>/dev/null || true)"
  if [ -z "\$aa_model" ] && [ -n "\$aa_agent_file" ]; then
    aa_model="\$(sed -n 's/.*"model":[[:space:]]*"\([^"]*\)".*/\1/p' "\$aa_agent_file" | head -1)"
  fi
fi
[ -n "\$aa_model" ] && export AGENT_LINK_ROUTE_MODEL="\$aa_model"
# Paseo starts Codex as an app-server, then sends the thread id over RPC. That
# means it is absent from argv when this launcher has to choose an account.
# Paseo does provide the persisted agent id, so recover the thread id from that
# agent record before normal owner-or-healthiest resume routing runs below.
if [ "$p" = codex ] && [ -z "\$aa_sid" ] && [ -n "\${PASEO_AGENT_ID:-}" ]; then
  if [ -n "\$aa_agent_file" ]; then
    aa_sid="\$(sed -n 's/.*"sessionId":[[:space:]]*"\([^"]*\)".*/\1/p' "\$aa_agent_file" | head -1)"
  fi
fi
aa_pin=""
# An explicitly inherited env var means the caller already chose the account —
# compute nothing for it, or a mere launch would copy transcripts around.
if [ -n "\${$env_var:-}" ]; then aa_sid=""; aa_cont=""; fi
# "continue" means the newest chat — which may live in any account. The CLI
# finds it and routes it like a resume of that session.
if [ -z "\$aa_sid" ] && [ -n "\$aa_cont" ] && [ -x "$self" ]; then
  aa_pin="\$("$self" continue-target $p "\$PWD" --go "\$aa_model" 2>/dev/null || true)"
fi
if [ -n "\$aa_sid" ]; then
  # The CLI resolves which account owns this session — and when that account is
  # parked or was just refused for a limit, it hands the transcript to a
  # healthy account and answers with THAT dir, so a plain --resume recovers a
  # chat that died on a limit. "primary" means: leave the env var unset.
  if [ -x "$self" ]; then
    aa_pin="\$("$self" resume-target $p "\$aa_sid" --go "\$aa_model" 2>/dev/null || true)"
  fi
  if [ -z "\$aa_pin" ]; then
    # The CLI was missing or failed — at least pin to the owner so the resume
    # still works. The primary owns sessions too, so it must be searched.
    if [ -n "\$(find "$primary_search" -maxdepth 5 -name "*\$aa_sid*" -print -quit 2>/dev/null)" ]; then
      aa_pin="primary"
    else
      for aa_d in "\$aa_root/accounts/$p"/*/; do
        [ -d "\$aa_d" ] || continue
        if [ -n "\$(find "\$aa_d" -maxdepth 5 -name "*\$aa_sid*" -print -quit 2>/dev/null)" ]; then
          aa_pin="\${aa_d%/}"
          break
        fi
      done
    fi
  fi
fi
# An explicitly inherited value always wins, then a pinned resume, then rotation.
if [ -z "\${$env_var:-}" ] && [ "\$aa_pin" != primary ]; then
  if [ -n "\$aa_pin" ]; then
    export $env_var="\$aa_pin"
  elif [ -x "$self" ]; then
    # Paseo starts short-lived provider discovery processes from / without an
    # agent id. They need a valid account, but they are not real launches and
    # must not advance LRU or inflate launch counts.
    if [ -z "\${PASEO_AGENT_ID:-}" ] && [ -z "\${PASEO_AGENT_CWD:-}" ] && [ "\$PWD" = / ]; then
      slot="\$("$self" pick $p dry "\$aa_model" 2>/dev/null || true)"
    else
      slot="\$("$self" pick $p live "\$aa_model" 2>/dev/null || true)"
    fi
    if [ -z "\$slot" ]; then
      echo "agent-link: no healthy $p account is available; wait for a cooldown or release an account" >&2
      exit 75
    elif [ "\$slot" != primary ]; then
      export $env_var="\$aa_root/accounts/$p/\$slot"
    fi
  fi
fi
$trust_block
exec "\$real" "\$@"
EOF
  chmod +x "$SHIM_BIN/$p-auto"
  echo "wrote $SHIM_BIN/$p-auto"
}

cmd_auto() { # write auto launchers and print the provider snippet
  local p
  for p in $PROVIDERS; do write_auto_launcher "$p"; done
  cat <<EOF

Point ONE provider at each launcher and it spreads new agents across your
accounts automatically (health gate, priority groups, then least-recently-used).

Paseo — ~/.paseo/config.json under agents.providers (restart the daemon after):

  "claude-auto": {
    "extends": "claude",
    "label": "Claude (Dynamic Agent Link)",
    "command": ["$SHIM_BIN/claude-auto"]
  },
  "codex-auto": {
    "extends": "codex",
    "label": "Codex (Dynamic Agent Link)",
    "command": ["$SHIM_BIN/codex-auto"]
  }

Anything else that runs a command works too — just run $SHIM_BIN/claude-auto
in place of claude.
EOF
}


# Run a provider's real CLI with dynamic routing applied:
#   agent-link claude          -> Claude Code on the next account in rotation
#   agent-link codex -m ...    -> args pass straight through
# An inherited CLAUDE_CONFIG_DIR/CODEX_HOME still wins. With no healthy account
# the launcher refuses cleanly instead of silently falling onto the primary.
cmd_exec_auto() { # $1 provider, rest = args for the real CLI
  local p="$1" env_var real d slot
  shift
  env_var="$(prov_env_var "$p")"
  real=""
  local old_ifs="$IFS"; IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    [ "$d" = "$SHIM_BIN" ] && continue
    if [ -x "$d/$p" ]; then real="$d/$p"; break; fi
  done
  IFS="$old_ifs"
  [ -n "$real" ] || { prov_binary_check "$p"; return 127; }
  if [ -z "$(eval "printf '%s' \"\${$env_var:-}\"")" ]; then
    slot="$(pick_slot "$p" 2>/dev/null || true)"
    if [ -z "$slot" ]; then
      echo "agent-link: no healthy $p account is available; wait for a cooldown or release an account" >&2
      return 75
    elif [ "$slot" != primary ]; then
      export "$env_var=$(slot_dir "$p" "$slot")"
    fi
  fi
  exec "$real" "$@"
}

# Which account owns a session? Prints "primary" or a slot email. A moved
# session is a COPY, so several accounts can hold the same id — the owner is
# wherever the newest write happened, or a repeat resume would clobber the
# account that has been doing the work with a stale copy. The primary counts
# too: it owns every conversation started before any slots existed.
session_owner() { # $1 provider, $2 session-id
  local d f m best="" best_m=0 label
  for d in "$(primary_dir "$1")" "$ACCOUNTS/$1"/*/; do
    d="${d%/}"
    [ -d "$d" ] || continue
    if [ "$d" = "$(primary_dir "$1")" ]; then label=primary; else label="$(basename "$d")"; fi
    f="$(find "$d" -maxdepth 5 -name "*$2*" -not -name "*.al-moved" -type f 2>/dev/null | head -20)"
    [ -n "$f" ] || continue
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      m="$(stat -f %m "$hit" 2>/dev/null || stat -c %Y "$hit" 2>/dev/null || echo 0)"
      if [ "$m" -gt "$best_m" ]; then best_m="$m"; best="$label"; fi
    done <<EOF2
$f
EOF2
  done
  [ -n "$best" ] || return 1
  echo "$best"
}

session_dir() { # $1 provider, $2 owner (primary|email) — the config dir behind it
  if [ "$2" = primary ]; then primary_dir "$1"; else slot_dir "$1" "$2"; fi
}

# Copy every file of one session between config dirs, preserving layout. A
# session can be more than one file (transcript plus sidecars), so copy every
# match rather than the first — a partial copy resumes with holes.
session_copy() { # $1 src dir, $2 dest dir, $3 session-id
  local hit rel copied=""
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    case "$hit" in *.al-moved) continue ;; esac
    rel="${hit#$1/}"
    # A destination copy that is newer than the source has real work in it —
    # overwriting it would destroy conversation turns. Leave it (and its
    # .al-moved floor) alone; the resume runs against the newer copy.
    if [ -f "$2/$rel" ]; then
      local src_m dest_m
      src_m="$(stat -f %m "$hit" 2>/dev/null || stat -c %Y "$hit" 2>/dev/null || echo 0)"
      dest_m="$(stat -f %m "$2/$rel" 2>/dev/null || stat -c %Y "$2/$rel" 2>/dev/null || echo 0)"
      if [ "$dest_m" -ge "$src_m" ]; then copied=1; continue; fi
    fi
    mkdir -p "$(dirname "$2/$rel")"
    if cp "$hit" "$2/$rel"; then
      copied=1
      # The copied tail describes the SOURCE account — its refusals and its
      # rate_limits. Record where the move ended so the health scanners only
      # read what THIS account appends afterwards; without this, moving a dead
      # chat parks the healthy account it just moved to.
      wc -c < "$2/$rel" | tr -d ' ' > "$2/$rel.al-moved"
    fi
  done <<EOF2
$(find "$1" -maxdepth 5 -name "*$3*" -type f 2>/dev/null)
EOF2
  [ -n "$copied" ]
}

# Move a conversation to another account so it can be continued there.
# Sessions are stored per config dir, so a chat started on account A simply
# does not exist for account B — this copies the transcript across. The model
# re-sends the transcript on resume, so the conversation continues; the new
# account is billed from that point on. "primary" works on both ends.
cmd_handoff() { # $1 provider, $2 session-id, $3 target email|primary
  prov_valid "${1:-}" || { echo "usage: agent-link handoff <claude|codex> <session-id> <email|primary>" >&2; return 1; }
  [ -n "${2:-}" ] || { echo "usage: agent-link handoff <claude|codex> <session-id> <email|primary>" >&2; return 1; }
  { [ "${3:-}" = primary ] || valid_account "${3:-}"; } || { echo "usage: agent-link handoff <claude|codex> <session-id> <email|primary>" >&2; return 1; }
  local p="$1" sid="$2" target="$3" owner src dest_dir
  dest_dir="$(session_dir "$p" "$target")"
  [ -d "$dest_dir" ] || { echo "no $p account '$target'" >&2; return 1; }
  owner="$(session_owner "$p" "$sid")" || { echo "session '$sid' not found in any $p account" >&2; return 1; }
  src="$(session_dir "$p" "$owner")"
  [ "$src" = "$dest_dir" ] && { echo "already on $target"; return 0; }
  session_copy "$src" "$dest_dir" "$sid" || { echo "copying session '$sid' failed" >&2; return 1; }
  record_route_decision "$p" "$target" "session ${sid%%-*} handed off from $owner" fallback
  echo "copied session $sid"
  echo "  from: $owner"
  echo "    to: $target"
  if [ "$target" = primary ]; then
    echo "continue it with: $p --resume $sid"
  else
    echo "continue it with: agent-link run $p $target $p --resume $sid"
  fi
}

# Where should a resume run? Prints the config dir to export, "primary" for the
# primary login (leave the env var unset), or nothing when the session is
# unknown (the caller falls back to rotation). A running process can never
# change accounts — but its NEXT resume can: when the owning account is parked,
# or was just refused for a limit, the transcript is handed to the healthiest
# other account and THAT dir is printed. This is what lets a chat that died on
# a limit continue with a plain --resume, no rescue by hand.
cmd_resume_target() { # $1 provider, $2 session-id [--go] [model]
  prov_valid "${1:-}" && [ -n "${2:-}" ] || {
    echo "usage: agent-link resume-target <claude|codex> <session-id> [--go]" >&2; return 1; }
  # Without --go this is a pure query: it prints where a resume would land and
  # touches nothing. The launchers pass --go, which is when the transcript
  # actually moves and the LRU stamp is written.
  local p="$1" sid="$2" go="" model="${4:-}" owner owner_dir healthy="" e ts best="" best_ts="" pemail covered dest_dir
  [ "${3:-}" = --go ] && go=1
  owner="$(session_owner "$p" "$sid")" || return 0
  owner_dir="$(session_dir "$p" "$owner")"
  if [ "$owner" = primary ]; then slot_available_primary "$p" "$model" && healthy=1
  else slot_available "$p" "$owner" "$model" && healthy=1; fi
  if [ -n "$healthy" ]; then
    if [ -n "$go" ]; then
      local owner_group="standard" owner_rank
      owner_rank="$(pref_rank "$p" "$owner")"
      case "$owner_rank" in 0) owner_group="preferred" ;; 2) owner_group="reserve" ;; 9) owner_group="fallback" ;; esac
      date +%s > "$(pools_dir)/last-$p-$owner"
      record_route_decision "$p" "$owner" "session ${sid%%-*} resumed on owner" "$owner_group"
    fi
    echo "$([ "$owner" = primary ] && echo primary || echo "$owner_dir")"
    return 0
  fi
  # The owner is benched. LRU among the healthy others, nearing accounts last;
  # the primary counts unless a slot already holds that account (pick_slot's rule).
  mkdir -p "$(pools_dir)"
  pemail="$(primary_email "$p")"
  covered=""
  if [ -n "$pemail" ] && [ "$owner" != primary ]; then
    for e in $(slot_list "$p"); do
      [ "$(prov_email "$p" "$(slot_dir "$p" "$e")")" = "$pemail" ] && covered=1
    done
  fi
  local pass rank best_rank=""
  for pass in fresh nearing; do
    if [ -n "$pemail" ] && [ "$owner" != primary ] && [ -z "$covered" ] && slot_available_primary "$p" "$model"; then
      if [ "$pass" = nearing ] || ! slot_nearing "$p" primary; then
        best=primary; best_ts="$(cat "$(pools_dir)/last-$p-primary" 2>/dev/null || echo 0)"; best_rank="$(pref_rank "$p" primary)"
      fi
    fi
    for e in $(slot_list "$p"); do
      [ "$e" = "$owner" ] && continue
      slot_available "$p" "$e" "$model" || continue
      [ "$pass" = fresh ] && slot_nearing "$p" "$e" && continue
      ts="$(cat "$(pools_dir)/last-$p-$e" 2>/dev/null || echo 0)"
      rank="$(pref_rank "$p" "$e")"
      if [ -z "$best" ] || [ "$rank" -lt "$best_rank" ] || { [ "$rank" -eq "$best_rank" ] && [ "$ts" -lt "$best_ts" ]; }; then
        best="$e"; best_ts="$ts"; best_rank="$rank"
      fi
    done
    [ -n "$best" ] && break
  done
  if [ -z "$best" ]; then
    # Nowhere healthier to go — stay with the owner, where the transcript is.
    echo "$([ "$owner" = primary ] && echo primary || echo "$owner_dir")"; return 0
  fi
  dest_dir="$(session_dir "$p" "$best")"
  if [ -z "$go" ]; then
    echo "$([ "$best" = primary ] && echo primary || echo "$dest_dir")"; return 0
  fi
  if ! session_copy "$owner_dir" "$dest_dir" "$sid"; then
    echo "$([ "$owner" = primary ] && echo primary || echo "$owner_dir")"; return 0
  fi
  date +%s > "$(pools_dir)/last-$p-$best"
  record_route_decision "$p" "$best" "session ${sid%%-*} resumed from $owner" fallback
  echo "$(date '+%Y-%m-%d %H:%M')  moved session $sid $owner -> $best on resume (owner parked)" >> "$STATE/autopark.log"
  echo "$([ "$best" = primary ] && echo primary || echo "$dest_dir")"
}

# `claude -c` means "continue the newest chat in this project" — but newest in
# WHICH account? Find the freshest transcript for this cwd across the primary
# and every slot, then route it exactly like a --resume of that session (so a
# parked owner hands the chat to a healthy account first). Claude names project
# dirs by replacing every non-alphanumeric in the cwd with a dash.
cmd_continue_target() { # $1 provider, $2 cwd [--go]
  prov_valid "${1:-}" && [ -n "${2:-}" ] || return 0
  local p="$1" slug d f m best="" best_m=0 sid
  slug="$(printf %s "$2" | LC_ALL=C sed 's/[^A-Za-z0-9]/-/g')"
  for d in "$(primary_dir "$p")" "$ACCOUNTS/$p"/*/; do
    d="${d%/}"
    if [ "$p" = claude ]; then
      # Claude keys history by project: newest transcript for THIS cwd.
      [ -d "$d/projects/$slug" ] || continue
      f="$(ls -t "$d/projects/$slug"/*.jsonl 2>/dev/null | head -1)"
    else
      # Codex `resume --last` is global: newest rollout, whatever the cwd.
      f="$(ls -t "$d"/sessions/*/*/*/*.jsonl 2>/dev/null | head -1)"
    fi
    [ -n "$f" ] || continue
    m="$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0)"
    if [ "$m" -gt "$best_m" ]; then best_m="$m"; best="$f"; fi
  done
  [ -n "$best" ] || return 0
  if [ "$p" = claude ]; then
    sid="$(basename "$best" .jsonl)"
  else
    # rollout-<timestamp>-<uuid>.jsonl — the uuid is the session id.
    sid="$(basename "$best" .jsonl | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || true)"
    [ -n "$sid" ] || return 0
  fi
  cmd_resume_target "$p" "$sid" "${3:-}" "${4:-}"
}

cmd_pick() { # provider — print the account to use next (used by the launchers)
  prov_valid "${1:-}" || { echo "usage: agent-link pick <claude|codex>" >&2; return 1; }
  pick_slot "$@"
}

cmd_cooldown() { # provider email minutes — park an exhausted account
  prov_valid "${1:-}" && valid_account "${2:-}" || {
    echo "usage: agent-link cooldown <claude|codex> <email> [minutes|clear]" >&2; return 1; }
  local p="$1" e="$2" arg="${3:-180}"
  mkdir -p "$(pools_dir)"
  if [ "$arg" = clear ]; then
    rm -f "$(pools_dir)/cooldown-$p-$e" "$(pools_dir)/reason-$p-$e" "$(pools_dir)/hold-$p-$e"
    echo "$p · $e: released (cooldown and hold cleared)"
    return 0
  fi
  if [ "$arg" = hold ]; then
    hold_set "$p" "$e" "held by you — release with: agent-link cooldown $p $e clear"
    echo "held by you" > "$(pools_dir)/reason-$p-$e"
    echo "$p · $e: HELD — routing skips it until you clear it (no expiry)"
    return 0
  fi
  echo "$(( $(date +%s) + arg * 60 ))" > "$(pools_dir)/cooldown-$p-$e"
  echo "parked by you" > "$(pools_dir)/reason-$p-$e"
  echo "$p · $e: parked for ${arg}m — auto-routing will skip it until then"
}

# One line, for an agent to run mid-conversation without dumping context.
# Ask each account to answer one token on a given model. Config flags proved
# unreliable — an account marked "out of credits" can still serve, and one that
# looks fine can refuse — so this measures instead of guessing.
cmd_probe() { # $1 provider (default claude), $2 model, [--park]
  local p="${1:-claude}" model="${2:-}" park="" e dir out rc ok model_slug
  case "${3:-}" in --park) park=1 ;; esac
  prov_valid "$p" || { echo "usage: agent-link probe <claude|codex> [model] [--park]" >&2; return 1; }
  [ "$p" = claude ] || { echo "probe currently supports claude only" >&2; return 1; }
  for e in primary $(slot_list "$p"); do
    if [ "$e" = primary ]; then
      [ -n "$(primary_email "$p")" ] || continue
      dir=""
    else
      prov_logged_in "$p" "$(slot_dir "$p" "$e")" || continue
      dir="$(slot_dir "$p" "$e")"
    fi
    printf '  %-28s ' "$e"
    if [ -n "$dir" ]; then
      out="$(CLAUDE_CONFIG_DIR="$dir" claude -p "ok" ${model:+--model "$model"} 2>&1)"
      rc=$?
    else
      out="$(claude -p "ok" ${model:+--model "$model"} 2>&1)"
      rc=$?
    fi
    out="$(printf '%s' "$out" | tr '\n' ' ')"
    if [ "$rc" -ne 0 ]; then
      ok=""
      printf '%sCHECK FAILED%s — account remains unavailable\n' "$C_RED" "$C_OFF"
    elif is_limit_refusal_text "$out"; then
      ok=""
      printf '%sCANNOT SERVE%s %s\n' "$C_RED" "$C_OFF" "${model:-default}"
    else
      ok=1
      printf '%sok%s\n' "$C_GREEN" "$C_OFF"
    fi
    if [ -n "$ok" ]; then
      model_slug="$(model_key "$model")"
      if [ -n "$model_slug" ] && [ -f "$(pools_dir)/holdmodel-$p-$e-$model_slug" ]; then
        rm -f "$(pools_dir)/holdmodel-$p-$e-$model_slug"
        echo "      released ${model:-model} — it just served"
      fi
      # Proof of service releases whatever was holding the account back.
      if [ -f "$(pools_dir)/hold-$p-$e" ] || [ -f "$(pools_dir)/cooldown-$p-$e" ]; then
        rm -f "$(pools_dir)/hold-$p-$e" "$(pools_dir)/cooldown-$p-$e" "$(pools_dir)/reason-$p-$e"
        echo "      released — it just served, so its park is over"
      fi
    elif [ -n "$park" ]; then
      case "$out" in
        *"spend limit"*)
          hold_set "$p" "$e" "monthly spend limit — raise it at claude.ai/settings/usage, then: agent-link probe $p"
          echo "auto: monthly spend limit" > "$(pools_dir)/reason-$p-$e"
          echo "      HELD (spend limit) — no expiry; probe again or clear to release"
          ;;
        *)
          if [ -n "$model" ]; then
            autopark "$p" "$e" "hold:model:$(model_key "$model")"
            echo "      HELD for $model — other Claude models remain routable"
          else
            autopark "$p" "$e" hold:unknown
            echo "      HELD — routing skips it until a probe actually serves"
          fi
          ;;
      esac
    fi
  done
}

# What the numbers actually say: where work went, what it cost in tokens, how
# much came from cache, and which accounts got refused.
# Find conversations that died on a limit and move them to a healthy account.
# A running agent cannot be re-routed mid-flight — its account is fixed when the
# process starts — so the honest recovery is: park the exhausted account, copy
# the transcript to one that works, resume there.
cmd_rescue() { # [hours] [--go]
  local hours="${1:-6}" go=""
  case "${2:-}" in --go) go=1 ;; esac
  case "${1:-}" in --go) hours=6; go=1 ;; esac
  local found=0 sid acct proj target
  while IFS='|' read -r sid acct proj; do
    [ -n "$sid" ] || continue
    found=1
    printf '  %s%s%s in %s\n' "$C_BOLD" "$sid" "$C_OFF" "$acct"
    printf '    project: %s\n' "$proj"
    if [ -z "$go" ]; then continue; fi
    if [ "$acct" != primary ]; then
      cmd_cooldown claude "$acct" 180 >/dev/null && printf '    parked %s for 180m\n' "$acct"
    else
      echo "$(( $(date +%s) + 10800 ))" > "$(pools_dir)/cooldown-claude-primary"
      printf '    parked the primary for 180m\n'
    fi
    target="$(pick_slot claude dry 2>/dev/null || true)"
    if [ -z "$target" ] || [ "$target" = "$acct" ]; then
      printf '    %sno healthy account to move it to%s\n' "$C_RED" "$C_OFF"
      continue
    fi
    if [ "$target" = primary ]; then
      printf '    %sthe only healthy account is your primary — resume with: claude --resume %s%s\n' "$C_DIM" "$sid" "$C_OFF"
      continue
    fi
    cmd_handoff claude "$sid" "$target" >/dev/null 2>&1 &&
      printf '    moved to %s%s%s — resume with: agent-link run claude %s claude --resume %s\n' "$C_GREEN" "$target" "$C_OFF" "$target" "$sid"
  done <<EOF
$(python3 - "$ACCOUNTS" "$HOME" "$hours" <<'PY2'
import glob, os, sys, time
accounts_root, home, hours = sys.argv[1], sys.argv[2], float(sys.argv[3])
since = time.time() - hours * 3600
seen = set()
def scan(root, label):
    for f in glob.glob(os.path.join(root, "projects", "*", "*.jsonl")):
        try:
            st = os.stat(f)
        except OSError:
            continue
        if st.st_mtime < since or st.st_size > 25_000_000:
            continue
        # Content before the .al-moved floor was copied in from another
        # account; blaming this account for it would park a healthy account
        # and move the chat AGAIN — the exact loop the marker exists to stop.
        floor = 0
        try:
            floor = int(open(f + ".al-moved").read().strip())
        except (OSError, ValueError):
            pass
        if st.st_size <= floor:
            continue
        try:
            fh = open(f, errors="ignore")
            fh.seek(floor)
            text = fh.read()
        except OSError:
            continue
        if "spend limit" not in text and "usage limit" not in text:
            continue
        sid = os.path.basename(f)[:-6]
        if sid in seen:
            continue
        seen.add(sid)
        print(f"{sid}|{label}|{os.path.basename(os.path.dirname(f)).split('--')[-1]}")
scan(os.path.join(home, ".claude"), "primary")
for d in sorted(glob.glob(os.path.join(accounts_root, "claude", "*"))):
    scan(d, os.path.basename(d))
PY2
)
EOF
  [ "$found" = 1 ] || echo "  no conversations hit a limit in the last ${hours}h"
  [ -n "$go" ] || echo "  (add --go to park the account and move these to a healthy one)"
}

cmd_insights() { # [days]
  local days="${1:-7}"
  python3 - "$ACCOUNTS" "$HOME" "$days" "$(pools_dir)" <<'PY2'
import json, os, sys, time, glob
accounts_root, home, days, pools = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
since = time.time() - days * 86400

def email_of(d):
    try:
        return (json.load(open(os.path.join(d, ".claude.json"))).get("oauthAccount") or {}).get("emailAddress") or ""
    except Exception:
        return ""

def scan(d):
    t = dict(sessions=0, inp=0, out=0, cread=0, ccreate=0, limits=0, last=0, models=set(), daily=[0]*days, proj={})
    for f in glob.glob(os.path.join(d, "projects", "*", "*.jsonl")):
        try:
            st = os.stat(f)
        except OSError:
            continue
        if st.st_mtime < since or st.st_size > 25_000_000:
            continue
        t["sessions"] += 1
        t["last"] = max(t["last"], st.st_mtime)
        label = os.path.basename(os.path.dirname(f)).split("--")[-1]
        t["proj"][label] = t["proj"].get(label, 0) + 1
        # Skip content copied in from another account (see .al-moved): its
        # tokens were spent there and its refusals happened there.
        floor = 0
        try:
            floor = int(open(f + ".al-moved").read().strip())
        except (OSError, ValueError):
            pass
        if st.st_size <= floor:
            continue
        try:
            fh = open(f, errors="ignore")
            fh.seek(floor)
            text = fh.read()
        except OSError:
            continue
        for line in text.split("\n"):
            if '"usage"' not in line and "spend limit" not in line and "usage limit" not in line:
                continue
            try:
                o = json.loads(line)
            except Exception:
                continue
            if "spend limit" in line or "usage limit" in line:
                t["limits"] += 1
            m = o.get("message") or {}
            u = m.get("usage") or {}
            if not u:
                continue
            out = u.get("output_tokens") or 0
            t["inp"] += u.get("input_tokens") or 0
            t["out"] += out
            t["cread"] += u.get("cache_read_input_tokens") or 0
            t["ccreate"] += u.get("cache_creation_input_tokens") or 0
            if m.get("model") and m["model"] != "<synthetic>":
                t["models"].add(m["model"])
            ts = o.get("timestamp")
            when = None
            if ts:
                try:
                    when = time.mktime(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
                except Exception:
                    when = None
            when = when or st.st_mtime
            idx = days - 1 - int((time.time() - when) // 86400)
            if 0 <= idx < days:
                t["daily"][idx] += out
    return t

def human(n):
    return f"{n/1_000_000:.1f}M" if n >= 1_000_000 else (f"{round(n/1000)}k" if n >= 1000 else str(n))

def spark(vals):
    blocks = "▁▂▃▄▅▆▇█"
    top = max(vals) or 1
    return "".join(blocks[min(7, int(v / top * 7))] if v else "·" for v in vals)

dirs = [(email_of(home) or "primary", os.path.join(home, ".claude"), "primary")]
for d in sorted(glob.glob(os.path.join(accounts_root, "claude", "*"))):
    dirs.append((os.path.basename(d), d, "account"))

rows = [(name, kind, scan(d), d) for name, d, kind in dirs]
total_out = sum(r[2]["out"] for r in rows) or 1
print(f"\n  Last {days} days\n")
for name, kind, t, d in rows:
    if t["sessions"] == 0:
        print(f"  {name:28} {kind:8} no activity")
        continue
    tin = t["inp"] + t["cread"] + t["ccreate"]
    cache = round(t["cread"] / tin * 100) if tin else 0
    launches = 0
    key = "primary" if kind == "primary" else name
    try:
        launches = int(open(os.path.join(pools, f"count-claude-{key}")).read().strip())
    except Exception:
        pass
    print(f"  {name:28} {kind:8} {spark(t['daily'])}  {t['sessions']:>3} sessions · {human(t['out']):>5} out · {cache:>2}% cached · {round(t['out']/total_out*100):>2}% of work")
    extra = []
    if launches:
        extra.append(f"{launches} launches")
    if t["models"]:
        extra.append(", ".join(sorted(m.replace("claude-", "") for m in t["models"]))[:48])
    if t["proj"]:
        extra.append("mostly " + max(t["proj"], key=t["proj"].get))
    if extra:
        print(f"  {'':28} {'':8} {' · '.join(extra)}")
    if t["limits"]:
        ago = int((time.time() - t["last"]) / 60)
        print(f"  {'':28} {'':8} ⚠ {t['limits']} limit refusals · probe this account before relying on it")
print()
PY2
}

# The Paseo panel is an optional companion that ships in this repo. Install it
# only when Paseo is actually present — the CLI never depends on it.
REPO_URL="https://github.com/itsjustanks/agent-link"
RAW_URL="https://raw.githubusercontent.com/itsjustanks/agent-link/main/agent-link"
RELEASES_URL="https://api.github.com/repos/itsjustanks/agent-link/releases/latest"

# Updates follow RELEASES, not main: a release is a version someone chose to
# announce, main is whatever landed last. Falls back to main when the API is
# unreachable, so an update is never impossible.
latest_release_tag() {
  curl -fsSL -m 8 "$RELEASES_URL" 2>/dev/null |
    python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("tag_name") or "")
except Exception: pass' 2>/dev/null
}

# ---------------------------------------------------------------- apps
#
# Integrations live in apps/<id>/ with an app.json describing how to install
# them. Nothing here is required: the CLI works on its own, and an app only
# appears as installable when the tool it targets is present.

apps_dir() { # find the apps/ directory, fetching or refreshing the repo
  local here d
  here="$(cd "$(dirname "$0")" && pwd)"
  # A checkout next to the script is the developer's own tree: use it as-is.
  for d in "$here/apps" "$here/../apps"; do
    [ -d "$d" ] && { echo "$d"; return 0; }
  done
  command -v git >/dev/null 2>&1 || { [ -d "$ROOT/src/apps" ] && { echo "$ROOT/src/apps"; return 0; }; return 1; }
  # The managed copy must be brought up to date, or an install would keep
  # reinstalling whatever was published the first time the CLI ever ran.
  if [ -d "$ROOT/src/.git" ]; then
    # The panel must match the CLI, so the managed clone follows the same
    # release tag the updater installs — main only when no release resolves.
    local tag ref
    tag="$(latest_release_tag)"
    ref="${tag:+refs/tags/$tag}"; ref="${ref:-HEAD}"
    git -C "$ROOT/src" fetch -q --depth 1 origin "$ref" 2>/dev/null &&
      git -C "$ROOT/src" reset -q --hard FETCH_HEAD 2>/dev/null ||
      echo "could not refresh $ROOT/src — installing the copy already there" >&2
    [ -d "$ROOT/src/apps" ] && { echo "$ROOT/src/apps"; return 0; }
  fi
  echo "fetching integrations from ${REPO_URL}…" >&2
  rm -rf "$ROOT/src.tmp"
  if git clone --depth 1 -q "$REPO_URL" "$ROOT/src.tmp" >&2; then
    rm -rf "$ROOT/src"; mv "$ROOT/src.tmp" "$ROOT/src"
    [ -d "$ROOT/src/apps" ] && { echo "$ROOT/src/apps"; return 0; }
  fi
  return 1
}

# Updating is two things — this file, and the app sources it installs from.
cmd_update() {
  local self target
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  echo
  if [ -d "$(dirname "$self")/.git" ] || [ -d "$(dirname "$self")/../.git" ]; then
    echo "  ${C_DIM}$self is a git checkout — pull it yourself.${C_OFF}"
  else
    local tag; tag="$(latest_release_tag)"
    if [ -n "$tag" ]; then
      target="https://raw.githubusercontent.com/itsjustanks/agent-link/$tag/agent-link"
      printf '  updating %s to %s… ' "$self" "$tag"
    else
      target="$RAW_URL"
      printf '  updating %s (no release info — using main)… ' "$self"
    fi
    if curl -fsSL "$target" -o "$self.new" 2>/dev/null && [ -s "$self.new" ]; then
      chmod +x "$self.new"; mv "$self.new" "$self"
      echo "${C_GREEN}done${C_OFF} (now $("$self" --version 2>/dev/null || echo "?"))"
    else
      rm -f "$self.new"
      echo "${C_RED}failed${C_OFF} — check your connection, or re-run the curl from the README"
    fi
  fi
  # Anything installed from this repo gets the new source too, or the CLI and
  # its Paseo panel drift apart.
  local base d id
  base="$(apps_dir)" || { echo "  no apps to update"; return 0; }
  for d in "$base"/*/; do
    [ -f "$d/app.json" ] || continue
    [ "$(app_state "$d")" = installed ] || continue
    id="$(app_field "$d" id)"
    echo "  reinstalling the '${id}' app (this repo's panel — Paseo itself is untouched)…"
    cmd_app install "$id"
  done
}

app_field() { # $1 app dir, $2 key
  python3 - "$1/app.json" "$2" <<'PY2'
import json, sys
try:
    print(json.load(open(sys.argv[1])).get(sys.argv[2], "") or "")
except Exception:
    print("")
PY2
}

app_state() { # $1 app dir -> installed|available|unavailable
  local req kind pid
  req="$(app_field "$1" requires)"
  kind="$(app_field "$1" kind)"
  [ -n "$req" ] && ! command -v "$req" >/dev/null 2>&1 && { echo unavailable; return; }
  case "$kind" in
    paseo-plugin)
      pid="$(app_field "$1" pluginId)"
      paseo plugin ls 2>/dev/null | grep -q "^$pid" && echo installed || echo available
      ;;
    *) echo available ;;
  esac
}

# Paseo keeps its plugins in <paseo home>/plugins/<id> and identifies each one
# by that id. Installing means putting the source there and registering the id,
# which is exactly what these two helpers make automatic.
paseo_home() {
  local home
  home="$(paseo daemon status --json 2>/dev/null | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
print(d.get("home") or d.get("daemon", {}).get("home") or "")' 2>/dev/null)"
  [ -n "$home" ] && [ -d "$home" ] && { echo "$home"; return; }
  echo "$HOME/.paseo"
}

paseo_plugins_on() { # plugins are off by default and only the user may turn them on
  python3 - "$(paseo_home)/config.json" <<'PY3'
import json, sys
try:
    print("yes" if json.load(open(sys.argv[1])).get("pluginsEnabled") else "no")
except Exception:
    print("no")
PY3
}

install_paseo_plugin() { # $1 source dir, $2 plugin id, $3 "link" to run from source
  local src="$1" pid="$2" mode="${3:-copy}" dest home status
  command -v paseo >/dev/null 2>&1 || {
    echo "Paseo is not installed on this machine — this app is optional." >&2
    echo "Get it at https://paseo.sh, then run: agent-link app install paseo" >&2
    return 1; }
  command -v npm >/dev/null 2>&1 || {
    echo "This app needs Node.js (for npm) to build. Install Node 20+, then run this again." >&2
    return 1; }
  if [ "$(paseo_plugins_on)" != yes ]; then
    echo "Paseo has plugins switched off." >&2
    echo "Turn them on in Paseo → Settings → Plugins, then run: agent-link app install paseo" >&2
    return 1
  fi

  home="$(paseo_home)"
  if [ "$mode" = link ]; then
    dest="$src"
  else
    dest="$home/plugins/$pid"
    echo "installing into ${dest}…"
    mkdir -p "$dest" || return 1
    # Copy the source only: node_modules is rebuilt in place and .git is noise.
    ( cd "$src" && tar --exclude=node_modules --exclude=.git -cf - . ) | ( cd "$dest" && tar -xf - ) || return 1
    # Stamp what was installed, so the panel can compare it with the release.
    local sha; sha="$(git -C "$src" rev-parse HEAD 2>/dev/null || true)"
    [ -n "$sha" ] && printf '{ "sha": "%s", "builtAt": "%s" }\n' "$sha" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dest/build.json"
  fi

  [ -d "$dest/node_modules" ] || { echo "installing dependencies…"; (cd "$dest" && npm install --silent --no-audit --no-fund) || return 1; }
  (cd "$dest" && npm run --silent typecheck) || { echo "app failed to typecheck — not installing" >&2; return 1; }

  # Paseo refuses to install over an existing id, so an upgrade means dropping
  # the registration first. That removes configuration only — never source.
  paseo plugin ls 2>/dev/null | grep -q "^$pid " && paseo plugin remove "$pid" >/dev/null 2>&1
  paseo plugin install "$dest" --id "$pid" >/dev/null || return 1
  status="$(paseo plugin ls 2>/dev/null | awk -v id="$pid" '$1 == id { print $2 }')"
  case "$status" in
    running) echo "installed and running. Open Paseo → Agent Link or MCP." ;;
    "")      echo "installed, but Paseo does not list it yet — check: paseo plugin ls" >&2 ;;
    *)       echo "installed but $status — check: paseo plugin logs $pid" >&2; return 1 ;;
  esac
}

cmd_app() { # list|install|status|remove [id] [--link]
  local action="${1:-list}" id="${2:-}" mode=copy base d state kind pid dest
  case "${3:-}" in --link|--dev) mode=link ;; esac
  base="$(apps_dir)" || { echo "no apps/ directory found and could not fetch it" >&2; return 1; }
  case "$action" in
    list|status)
      for d in "$base"/*/; do
        [ -f "$d/app.json" ] || continue
        state="$(app_state "$d")"
        case "$state" in
          installed)   printf '  %s●%s %-10s %-46s %sinstalled%s\n' "$C_GREEN" "$C_OFF" "$(app_field "$d" id)" "$(app_field "$d" summary)" "$C_GREEN" "$C_OFF" ;;
          available)   printf '  %s○%s %-10s %-46s %savailable — agent-link app install %s%s\n' "$C_DIM" "$C_OFF" "$(app_field "$d" id)" "$(app_field "$d" summary)" "$C_DIM" "$(app_field "$d" id)" "$C_OFF" ;;
          *)           printf '  %s·%s %-10s %-46s %s%s not installed on this machine%s\n' "$C_DIM" "$C_OFF" "$(app_field "$d" id)" "$(app_field "$d" summary)" "$C_DIM" "$(app_field "$d" requires)" "$C_OFF" ;;
        esac
      done
      return 0
      ;;
    install|remove) [ -n "$id" ] || { echo "usage: agent-link app $action <id>   (see: agent-link app list)" >&2; return 1; } ;;
    *) echo "usage: agent-link app [list|install|remove] [id] [--link]" >&2; return 1 ;;
  esac
  d="$base/$id"
  [ -f "$d/app.json" ] || { echo "no app called '$id' — try: agent-link app list" >&2; return 1; }
  kind="$(app_field "$d" kind)"; pid="$(app_field "$d" pluginId)"
  case "$kind" in
    paseo-plugin)
      if [ "$action" = remove ]; then
        command -v paseo >/dev/null 2>&1 || { echo "Paseo is not installed here." >&2; return 1; }
        paseo plugin remove "$pid" >/dev/null 2>&1
        dest="$(paseo_home)/plugins/$pid"
        # Only ever delete our own copy — a --link install points at your repo.
        [ -d "$dest" ] && [ "$dest" != "$d" ] && rm -rf "$dest"
        echo "removed. The source in apps/$id is untouched."
        return 0
      fi
      install_paseo_plugin "$d" "$pid" "$mode"
      ;;
    docs-only)
      [ "$action" = remove ] && { echo "nothing to remove — this app is instructions only"; return 0; }
      echo; sed 's/^/  /' "$d/$(app_field "$d" doc)"
      ;;
