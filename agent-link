#!/usr/bin/env bash
# agent-link — multi-account manager for AI coding CLIs (Claude Code, OpenAI Codex).
#
# Every account lives in its own credential slot (a folder named by the account
# email). Slots are used two ways, at the same time if you like:
#
#   PARALLEL  each slot is independently usable (shims like `claude-2`, or env
#             vars for orchestrators such as Paseo) — N accounts, N quota pools,
#             all live at once.
#   SWITCH    `agent-link use claude you@work.com` re-routes the plain `claude`
#             command to that slot via a pointer file. No credentials are ever
#             copied, backed up, or restored — every slot's OAuth tokens refresh
#             in place, so nothing decays and nothing gets logged out. Your
#             original ~/.claude and ~/.codex are never touched ("primary").
#             A switch affects new processes only; running agents keep the
#             account they started with.
#
# Works on macOS and Linux. Requires: bash, python3, and the CLIs you manage.
set -u

VERSION="0.8.2"
# Home dir. Prefer whichever location actually holds accounts — Claude binds
# credentials to the literal config-dir path, so an existing install must keep
# using the directory its logins were created under, whatever it is called.
aa_has_accounts() { [ -n "$(ls -A "$1/accounts/claude" "$1/accounts/codex" 2>/dev/null)" ]; }
if [ -n "${AGENT_LINK_HOME:-}" ]; then ROOT="$AGENT_LINK_HOME"
elif [ -n "${AGENT_AUTH_HOME:-}" ]; then ROOT="$AGENT_AUTH_HOME"
elif aa_has_accounts "$HOME/.agent-link"; then ROOT="$HOME/.agent-link"
elif aa_has_accounts "$HOME/.agent-auth"; then ROOT="$HOME/.agent-auth"
elif [ -d "$HOME/.agent-link" ]; then ROOT="$HOME/.agent-link"
elif [ -d "$HOME/.agent-auth" ]; then ROOT="$HOME/.agent-auth"
else ROOT="$HOME/.agent-link"
fi

ACCOUNTS="$ROOT/accounts"
SHIM_BIN="$ROOT/bin"
STATE="$ROOT/state"
PROVIDERS="claude codex"

# ---------------------------------------------------------------- provider registry

prov_valid() { case "$1" in claude|codex) return 0;; *) return 1;; esac; }

prov_env_var() { case "$1" in claude) echo CLAUDE_CONFIG_DIR;; codex) echo CODEX_HOME;; esac; }

# Is this slot logged in? Claude Code does NOT write a credentials file into
# CLAUDE_CONFIG_DIR on macOS — the tokens go to the OS keychain, keyed per
# config dir (verified: three config dirs report three different accounts from
# `claude auth status` at the same time). So a slot's recorded identity is the
# signal for Claude. Codex does keep auth.json inside CODEX_HOME.
prov_logged_in() { # $1 provider, $2 slot dir
  case "$1" in
    claude) [ -n "$(prov_email claude "$2")" ] ;;
    codex)  [ -f "$2/auth.json" ] ;;
  esac
}

# Reject anything that is not a plain account name — these values are
# interpolated into paths that get created and (for `remove`) deleted.
valid_account() { # $1 candidate
  case "${1:-}" in
    ""|.|..|*/*|*'\'*) return 1 ;;
    *) return 0 ;;
  esac
}

prov_binary() { echo "$1"; } # binary name == provider name for both

# Find the provider binary without accidentally invoking AgentLink's own
# routing shim. This matters for primary-account auth, where inheriting no
# config-dir variable is intentional.
prov_real_binary() { # $1 provider
  local p="$1" d old_ifs="$IFS"
  IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    [ "$d" = "$SHIM_BIN" ] && continue
    if [ -x "$d/$p" ]; then
      IFS="$old_ifs"
      printf '%s\n' "$d/$p"
      return 0
    fi
  done
  IFS="$old_ifs"
  return 1
}

# Print the logged-in account email for a slot dir (empty if none/unreadable).
prov_email() { # $1 provider, $2 slot dir
  case "$1" in
    claude)
      python3 - "$2" <<'PY'
import json, sys, os
p = os.path.join(sys.argv[1], ".claude.json")
try: print(json.load(open(p)).get("oauthAccount", {}).get("emailAddress", ""))
except Exception: pass
PY
      ;;
    codex)
      python3 - "$2" <<'PY'
import json, sys, os, base64
p = os.path.join(sys.argv[1], "auth.json")
try:
    tok = json.load(open(p))["tokens"]["id_token"].split(".")[1]
    tok += "=" * (-len(tok) % 4)
    print(json.loads(base64.urlsafe_b64decode(tok)).get("email", ""))
except Exception: pass
PY
      ;;
  esac
}

# Force file-based credential storage in a codex slot config. A copied config
# may say "keyring", which would silently break slot isolation (credentials
# would land in the shared OS keyring instead of inside CODEX_HOME).
codex_pin_file_store() { # $1 config.toml path
  python3 - "$1" <<'PY'
import re, sys, os
p = sys.argv[1]
s = open(p).read() if os.path.exists(p) else ""
line = 'cli_auth_credentials_store = "file"'
if re.search(r'^\s*cli_auth_credentials_store\s*=', s, re.M):
    s = re.sub(r'^\s*cli_auth_credentials_store\s*=.*$', line, s, flags=re.M)
else:
    # Must go at the ROOT of the document. Appending would land it inside
    # whatever [table] the file happens to end with (e.g. [mcp_servers.x]),
    # where codex ignores it and silently falls back to the shared keyring.
    s = line + "\n" + s
open(p, "w").write(s)
PY
}

# One-time slot preparation after mkdir.
prov_prepare() { # $1 provider, $2 slot dir
  case "$1" in
    claude)
      # A config dir carries its own system prompt and settings; a fresh slot
      # without them runs bare. Seed from the primary so the account behaves
      # like the others from its first launch.
      for f in CLAUDE.md settings.json; do
        [ ! -f "$2/$f" ] && [ -f "$HOME/.claude/$f" ] && cp "$HOME/.claude/$f" "$2/$f"
      done
      if [ -d "$HOME/.claude/output-styles" ] && [ ! -d "$2/output-styles" ]; then
        cp -R "$HOME/.claude/output-styles" "$2/output-styles"
      fi
      ;;
    codex)
      # Seed from the user's real config so slots behave like the primary
      # (MCP servers etc.), then pin credentials to file storage.
      if [ ! -f "$2/config.toml" ]; then
        [ -f "$HOME/.codex/config.toml" ] && cp "$HOME/.codex/config.toml" "$2/config.toml"
      fi
      codex_pin_file_store "$2/config.toml"
      ;;
  esac
}

prov_binary_check() { # $1 provider — fail with install hints if the CLI is missing
  command -v "$(prov_binary "$1")" >/dev/null 2>&1 && return 0
  echo "error: the '$(prov_binary "$1")' CLI is not in PATH." >&2
  case "$1" in
    claude)
      echo "  install: npm install -g @anthropic-ai/claude-code   (https://claude.com/claude-code)" >&2
      echo "  note: if 'claude' works in your shell only via an alias (the old installer)," >&2
      echo "  run 'claude install' there to get a real binary on PATH." >&2
      ;;
    codex)
      echo "  install: npm install -g @openai/codex" >&2
      ;;
  esac
  return 127
}

prov_login() { # $1 provider, $2 slot dir, $3 email
  case "$1" in
    claude)
      if claude auth login --help >/dev/null 2>&1; then
        CLAUDE_CONFIG_DIR="$2" claude auth login --email "$3"
      else
        echo "note: this Claude Code version predates 'claude auth login', so the full"
        echo "      REPL will open. After the login completes, type /exit to come back."
        echo "      (Or update first: claude update)"
        CLAUDE_CONFIG_DIR="$2" claude /login
      fi
      ;;
    codex)  CODEX_HOME="$2" codex login ;;
  esac
}

# ---------------------------------------------------------------- slot helpers

slot_dir() { echo "$ACCOUNTS/$1/$2"; }

order_file() { echo "$STATE/order-$1"; }

route_file() { echo "$STATE/route-$1"; }

# Emails for a provider in stable numbered order (order file first, strays after).
slot_list() { # $1 provider
  local seen="" e d
  if [ -f "$(order_file "$1")" ]; then
    while IFS= read -r e; do
      [ -n "$e" ] && [ -d "$(slot_dir "$1" "$e")" ] && { echo "$e"; seen="$seen|$e|"; }
    done < "$(order_file "$1")"
  fi
  for d in "$ACCOUNTS/$1"/*/; do
    [ -d "$d" ] || continue
    e="$(basename "$d")"
    case "$seen" in *"|$e|"*) ;; *) echo "$e" ;; esac
  done
}

# ---------------------------------------------------------------- auto-routing pools
#
# One "auto" launcher per provider picks a real slot at LAUNCH time, so a single
# Paseo/editor provider spreads new agents across accounts. It must resolve to a
# real slot path: Claude keys credentials to the literal config-dir path, so a
# symlink that swings between slots reports logged-out (verified).
# Selection filters health first, applies preferred/default/reserve groups,
# then picks the least-recently-used target. A running process keeps whatever
# it started with, always.

pools_dir() { echo "$STATE/pools"; }

# The primary login (~/.claude, ~/.codex) is a perfectly good pool member, so
# rotation includes it. That avoids duplicating the primary's account as a slot
# — which wastes a credential entry and double-weights that account.
primary_dir() { case "$1" in claude) echo "$HOME/.claude";; codex) echo "$HOME/.codex";; esac; }

primary_email() { # $1 provider
  case "$1" in
    claude) prov_email claude "$HOME" ;;
    codex)  prov_email codex "$HOME/.codex" ;;
  esac
}

# An account that has hit its spend limit cannot serve requests, so routing
# must skip it without waiting for you to park it by hand. Claude records this
# in its own config: extra usage exhausted AND no subscription allowance left.
prov_blocked() { # $1 provider, $2 config dir ($HOME for the primary)
  [ "$1" = claude ] || return 1
  python3 - "$2" <<'PY2'
import json, os, sys
d = sys.argv[1]
p = os.path.join(d, ".claude.json")
try:
    c = json.load(open(p))
except Exception:
    sys.exit(1)
blocked = c.get("cachedExtraUsageDisabledReason") == "out_of_credits" and c.get("hasAvailableSubscription") is False
sys.exit(0 if blocked else 1)
PY2
}

# The primary has no slot dir, so its cooldown is tracked under "primary".
slot_available_primary() { # $1 provider, $2 requested model
  local until now reset
  [ -f "$(pools_dir)/hold-$1-primary" ] && return 1
  model_held "$1" primary "${2:-}" && return 1
  until="$(cat "$(pools_dir)/cooldown-$1-primary" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  [ "$until" -gt "$now" ] && return 1
  if reset="$(recently_refused "$1" "$([ "$1" = claude ] && echo "$HOME/.claude" || echo "$HOME/.codex")")"; then
    autopark "$1" primary "$reset"
    case "$reset" in hold:model:*) model_held "$1" primary "${2:-}" && return 1 ;; *) return 1 ;; esac
  fi
  if [ "$1" = claude ]; then
    claude_quota_scan primary "$HOME/.claude" || return 1
  elif [ "$1" = codex ]; then
    codex_quota_scan primary "$HOME/.codex" || return 1
  fi
  return 0
}

# Self-healing: if an account was refused for a limit in its most recent
# activity, sideline it automatically. This is what makes a limit recover
# without anyone running a command — the dead agent is lost either way, but
# every launch after it avoids that account.
REFUSAL_WINDOW_MIN=45
# On a real refusal, prints the epoch to park until (parsed from Claude's own
# "resets 3am" when present, else an hour) and exits 0. A transcript that merely
# TALKS about limits is not a refusal — only API-error records count, which is
# what stops an account being benched for having a conversation about quotas.
recently_refused() { # $1 provider, $2 config dir
  [ "$1" = claude ] || return 1
  python3 - "$2" "$REFUSAL_WINDOW_MIN" <<'PY2'
import glob, os, re, sys, time
d, window = sys.argv[1], float(sys.argv[2])
cutoff = time.time() - window * 60
newest, newest_m = None, 0
for f in glob.glob(os.path.join(d, "projects", "*", "*.jsonl")):
    try:
        m = os.stat(f).st_mtime
    except OSError:
        continue
    if m > newest_m:
        newest, newest_m = f, m
if not newest or newest_m < cutoff:
    sys.exit(1)
floor = 0
try:
    floor = int(open(newest + ".al-moved").read().strip())
except (OSError, ValueError):
    pass
try:
    size = os.path.getsize(newest)
    if size <= floor:
        sys.exit(1)  # nothing written since the move — the tail is another account's story
    with open(newest, "rb") as fh:
        fh.seek(max(floor, size - 20000))
        tail = fh.read().decode("utf-8", "ignore")
except OSError:
    sys.exit(1)
now = time.time()
for line in tail.splitlines():
    # Claude Code stamps the assistant message it synthesises for an API error;
    # a limit phrase anywhere else is just conversation. ponytail: marker string,
    # parse the JSON per line if a future CLI changes the spelling.
    if '"isApiErrorMessage":true' not in line:
        continue
    low = line.lower()
    refusal = re.search(r"you(?:'|’)?ve\s+(?:hit|reached)\s+[^.!\n]{0,80}\blimit\b", low)
    if not refusal and "usage limit" not in low and "spend limit" not in low and "limit reached" not in low:
        continue
    until = None
    # A spend limit is monthly, or a budget someone must raise. No amount of
    # waiting proves it over, so it is a HOLD, not a bench — the caller parks
    # it with no expiry and only a probe or an explicit clear releases it.
    if "spend limit" in low:
        print("hold:spend")
        sys.exit(0)
    m = re.search(r"resets?\s*(?:at\s*)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)", low)
    if m:
        hour = int(m.group(1)) % 12 + (12 if m.group(3) == "pm" else 0)
        t = time.localtime(now)
        target = time.mktime((t.tm_year, t.tm_mon, t.tm_mday, hour, int(m.group(2) or 0), 0, 0, 0, -1))
        if target <= now:
            target += 24 * 60 * 60
        until = target
    if until is None:
        # A guessed one-hour timer made a still-refusing account eligible again.
        # Keep unknown resets out until an explicit probe serves or the user
        # clears the hold. Account checks never launch in the background.
        # Named model limits are scoped to that model. A Fable refusal must not
        # remove the same account from Sonnet/Opus routing.
        named = re.search(r"(?:hit|reached)\s+(?:your\s+)?([a-z0-9 ._-]{2,50})\s+limit", low)
        label = (named.group(1).strip() if named else "")
        if label and label not in {"session", "weekly", "usage", "rate", "monthly", "spend"}:
            slug = re.sub(r"[^a-z0-9]+", "-", label).strip("-")
            print(f"hold:model:{slug}")
        else:
            print("hold:unknown")
    else:
        # Never bench longer than one rolling window, never shorter than 10 minutes.
        until = max(now + 10 * 60, min(until, now + 5 * 60 * 60))
        print(int(until))
    sys.exit(0)
sys.exit(1)
PY2
}

# "Nearing" is a soft tier between healthy and parked: routing drains NEW work
# off the account while anything already running rides it to the actual limit.
# Written by a Claude Code Notification hook (see `agent-link hooks`) the
# moment the CLI warns about the approaching limit — which is as early as the
# machine can know. A nearing account still serves when nothing better exists,
# so a false warning costs load-balancing, never availability.
NEARING_TTL_MIN=90
slot_nearing() { # $1 provider, $2 key (email or "primary") — 0 if marked and fresh
  local f m
  f="$(pools_dir)/nearing-$1-$2"
  [ -f "$f" ] || return 1
  m="$(cat "$f" 2>/dev/null || echo 0)"
  if [ $(( $(date +%s) - m )) -gt $(( NEARING_TTL_MIN * 60 )) ]; then
    rm -f "$f"; return 1
  fi
  return 0
}

# Called by a Claude Code StopFailure hook the moment a turn dies on a
# rate/billing limit: park the calling session's own account right away, using
# Claude's parsed reset time when the transcript has one. Without this the park
# happens lazily at the next pick; with it, even a launch racing the failure
# avoids the account.
cmd_refused() { # $1 provider
  prov_valid "${1:-}" || { echo "usage: agent-link refused <claude|codex>" >&2; return 1; }
  local p="$1" d key e until model limit
  d="$(eval "printf '%s' \"\${$(prov_env_var "$p"):-}\"")"
  if [ -z "$d" ]; then key=primary; d="$(primary_dir "$p")"
  else
    key=""
    for e in $(slot_list "$p"); do
      [ "$(slot_dir "$p" "$e")" = "$d" ] && key="$e"
    done
    [ -n "$key" ] || key="$(basename "$d")"
  fi
  until="${AGENT_LINK_REFUSAL_HOLD:-$(recently_refused "$p" "$d" 2>/dev/null || true)}"
  autopark "$p" "$key" "${until:-}"
  model="${AGENT_LINK_ROUTE_MODEL:-}"
  if [ -n "${AGENT_LINK_REFUSAL_LIMIT:-}" ]; then
    limit="$AGENT_LINK_REFUSAL_LIMIT"
  else
    case "${until:-}" in
      hold:spend) limit="monthly spend limit" ;;
      hold:model:*) limit="${until#hold:model:} limit" ;;
      *) limit="usage limit" ;;
    esac
  fi
  rm -f "$(pools_dir)/nearing-$p-$key"
  echo "$p · $key: parked (limit hit; choose another AgentLink model/account for the next turn)"
}

cmd_nearing() { # $1 provider [$2 email|primary] [clear] — mark from a hook or by hand
  prov_valid "${1:-}" || { echo "usage: agent-link nearing <claude|codex> [email|primary] [clear]" >&2; return 1; }
  local p="$1" key="${2:-}" verb="${3:-}" d e
  # `nearing claude clear` (no account named) clears the calling session's own.
  if [ "$key" = clear ]; then key=""; verb=clear; fi
  # No account named: resolve the calling session's own slot from its env var,
  # which Claude Code passes through to hook commands.
  if [ -z "$key" ]; then
    d="$(eval "printf '%s' \"\${$(prov_env_var "$p"):-}\"")"
    if [ -z "$d" ]; then key=primary
    else
      key=""
      for e in $(slot_list "$p"); do
        [ "$(slot_dir "$p" "$e")" = "$d" ] && key="$e"
      done
      [ -n "$key" ] || key="$(basename "$d")"
    fi
  fi
  mkdir -p "$(pools_dir)"
  if [ "$verb" = clear ]; then
    rm -f "$(pools_dir)/nearing-$p-$key"
    echo "$p · $key: nearing mark cleared"
  else
    date +%s > "$(pools_dir)/nearing-$p-$key"
    echo "$(date '+%Y-%m-%d %H:%M')  nearing mark on $p/$key (new work drains elsewhere)" >> "$STATE/autopark.log"
    echo "$p · $key: marked nearing — new launches prefer other accounts for ${NEARING_TTL_MIN}m"
  fi
}

# The statusline wrapper: Claude Code feeds every render a JSON blob that (on
# Pro/Max) includes rate_limits.{five_hour,seven_day}.used_percentage and
# resets_at — the only signal that exists BEFORE the wall. The wrapper tees it:
# >=85%% on either window marks the account nearing (new work drains off it),
# >=99%% parks it until Claude's own resets_at, and dropping back under 75%%
# clears the mark (hysteresis so it never flaps). Then it chains to whatever
# statusline the user already had, so nothing visible changes.
write_statusline_helper() {
  mkdir -p "$SHIM_BIN"
  cat > "$SHIM_BIN/claude-quota-statusline" <<'EOF'
#!/bin/bash
# agent-link quota statusline — managed by `agent-link hooks`.
# Reads the statusline JSON, updates the router's nearing/parked state for the
# account this session runs on, then chains to the original statusline command
# (saved next to this session's settings.json as agent-link-statusline.orig).
# Root resolution mirrors the CLI exactly (env override, then whichever dir
# actually holds accounts) — diverging here writes quota marks into a pools
# dir the router never reads, and the whole before-the-wall lifecycle no-ops.
if [ -n "${AGENT_LINK_HOME:-}" ]; then root="$AGENT_LINK_HOME"
elif [ -n "${AGENT_AUTH_HOME:-}" ]; then root="$AGENT_AUTH_HOME"
elif [ -n "$(ls -A "$HOME/.agent-link/accounts/claude" "$HOME/.agent-link/accounts/codex" 2>/dev/null)" ]; then root="$HOME/.agent-link"
elif [ -n "$(ls -A "$HOME/.agent-auth/accounts/claude" "$HOME/.agent-auth/accounts/codex" 2>/dev/null)" ]; then root="$HOME/.agent-auth"
elif [ -d "$HOME/.agent-link" ]; then root="$HOME/.agent-link"
else root="$HOME/.agent-auth"
fi
input="$(cat)"
dir="${CLAUDE_CONFIG_DIR:-}"
key=primary
if [ -n "$dir" ]; then
  key="$(basename "$dir")"
else
  dir="$HOME/.claude"
fi
pools="$root/state/pools"
mkdir -p "$pools" 2>/dev/null
# Debounce: state writes at most once a minute, so a busy session costs nothing.
stamp="$pools/.quota-check-claude-$key"
now="$(date +%s)"
last="$(cat "$stamp" 2>/dev/null || echo 0)"
if [ $(( now - last )) -ge 60 ]; then
  echo "$now" > "$stamp"
  # The heredoc IS python's stdin, so the JSON travels via the environment —
  # piping it as well would be silently swallowed by the heredoc.
  AL_JSON="$input" python3 - "$pools" "$key" "$now" <<'PY2' 2>/dev/null
import json, os, sys
pools, key, now = sys.argv[1], sys.argv[2], int(sys.argv[3])
try:
    data = json.loads(os.environ.get("AL_JSON", ""))
except Exception:
    sys.exit(0)
rl = data.get("rate_limits") or {}
worst, resets = 0.0, None
snap = {"at": now, "model": ((data.get("model") or {}).get("display_name") or ""), "source": "Claude statusline"}
for w in ("five_hour", "seven_day"):
    win = rl.get(w) or {}
    u = win.get("used_percentage")
    if u is None:
        continue
    snap[w] = {"pct": float(u), "resets_at": win.get("resets_at")}
    if u > worst:
        worst, resets = float(u), win.get("resets_at")
# The /usage numbers Claude showed this session, kept where the panel and
# `agent-link usage` can render them per account.
if len(snap) > 2:
    try:
        open(os.path.join(pools, f"quota-claude-{key}.json"), "w").write(json.dumps(snap))
    except OSError:
        pass
nearing = os.path.join(pools, f"nearing-claude-{key}")
cooldown = os.path.join(pools, f"cooldown-claude-{key}")
log = os.path.join(os.path.dirname(pools), "autopark.log")
def note(msg):
    try:
        from time import strftime, localtime
        open(log, "a").write(strftime("%Y-%m-%d %H:%M", localtime(now)) + "  " + msg + "\n")
    except OSError:
        pass
if worst >= 99 and resets:
    until = int(resets)
    prev = 0
    try: prev = int(open(cooldown).read().strip())
    except Exception: pass
    if until > now and prev < until:
        open(cooldown, "w").write(str(until))
        open(os.path.join(pools, f"reason-claude-{key}"), "w").write("auto: quota exhausted (statusline)")
        note(f"parked claude/{key} at {worst:.0f}% until its reset (statusline)")
elif worst >= 85:
    if not os.path.exists(nearing):
        open(nearing, "w").write(str(now))
        note(f"nearing mark on claude/{key} at {worst:.0f}% (statusline)")
    else:
        open(nearing, "w").write(str(now))
elif worst and worst < 75 and os.path.exists(nearing):
    os.remove(nearing)
    note(f"cleared nearing mark on claude/{key} — back to {worst:.0f}%")
PY2
fi
orig="$dir/agent-link-statusline.orig"
if [ -s "$orig" ]; then
  printf '%s' "$input" | bash "$orig"
else
  # No prior statusline: render a useful default from the same JSON.
  AL_JSON="$input" python3 - <<'PY3' 2>/dev/null
import json, os, sys
try: d = json.loads(os.environ.get("AL_JSON", ""))
except Exception: sys.exit(0)
model = (d.get("model") or {}).get("display_name") or ""
rl = d.get("rate_limits") or {}
parts = [model] if model else []
for label, w in (("5h", "five_hour"), ("7d", "seven_day")):
    u = (rl.get(w) or {}).get("used_percentage")
    if u is not None:
        parts.append(f"{label} {u:.0f}%")
print(" · ".join(parts))
PY3
fi
EOF
  chmod +x "$SHIM_BIN/claude-quota-statusline"
}

# Wire the two signals Claude Code actually offers into the router, per config
# dir: the statusline JSON plus cached /usage (the before-the-wall signals) and a StopFailure
# hook on rate/billing errors (the instant hard-park). Slots only by default —
# the primary is opt-in, because "your primary is never modified" is a promise.
cmd_hooks() { # [install|remove|status] [--primary]
  local action="${1:-status}" with_primary="" e dirs d self_bin
  case "${2:-}" in --primary) with_primary=1 ;; esac
  case "${1:-}" in --primary) action=status; with_primary=1 ;; esac
  self_bin="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  dirs=""
  for e in $(slot_list claude); do dirs="$dirs $(slot_dir claude "$e")"; done
  [ -n "$with_primary" ] && dirs="$dirs $HOME/.claude"
  case "$action" in
    install)
      write_statusline_helper
      for d in $dirs; do
        hooks_wire_dir "$d" "$self_bin" || return 1
      done
      echo "hooks installed. New Claude sessions mark accounts nearing at 85%, park at 99% and on hard refusals."
      if [ -z "$with_primary" ]; then
        echo "(slots only — add the primary with: agent-link hooks install --primary)"
      fi
      return 0
      ;;
    remove)
      for d in $dirs; do hooks_unwire_dir "$d"; done
      echo "hooks removed"
      ;;
    *)
      for d in $dirs; do
        if python3 -c "
import json,sys
try: s=json.load(open('$d/settings.json'))
except Exception: sys.exit(1)
sl=(s.get('statusLine') or {}).get('command','')
hk=json.dumps(s.get('hooks') or {})
sys.exit(0 if 'claude-quota-statusline' in sl and 'agent-link refused' in hk else 1)
" 2>/dev/null; then echo "  [x] $d"; else echo "  [ ] $d"; fi
      done
      ;;
  esac
}

# Merge our statusline + StopFailure hook into one settings.json. Missing file:
# create it. Unreadable file: refuse and write NOTHING — a running session can
# leave settings momentarily unparseable, and a blind write would destroy it.
hooks_wire_dir() { # $1 config dir, $2 absolute agent-link path
  mkdir -p "$1"
  python3 - "$1" "$2" "$SHIM_BIN" <<'PY2'
import json, os, sys
d, self_bin, shim = sys.argv[1], sys.argv[2], sys.argv[3]
path = os.path.join(d, "settings.json")
if os.path.exists(path):
    try:
        settings = json.load(open(path))
    except Exception:
        print(f"refusing to touch unreadable {path}", file=sys.stderr)
        sys.exit(1)
else:
    settings = {}
wrapper = os.path.join(shim, "claude-quota-statusline")
sl = settings.get("statusLine") or {}
orig_path = os.path.join(d, "agent-link-statusline.orig")
if sl.get("command") and wrapper not in sl["command"]:
    with open(orig_path, "w") as f:
        f.write(sl["command"] + "\n")
settings["statusLine"] = {"type": "command", "command": wrapper}
hooks = settings.setdefault("hooks", {})
entries = hooks.setdefault("StopFailure", [])
marker = f"{self_bin} refused claude"
# Paths change between a checkout and ~/.local/bin. Keeping both registrations
# executes the same refusal twice, races recovery and can globally park an
# account before the newer model-scoped hook runs. Replace every AgentLink
# refusal registration with exactly the current one.
entries[:] = [
    entry for entry in entries
    if not ("agent-link" in json.dumps(entry) and " refused claude" in json.dumps(entry))
]
entries.append({
    "matcher": "rate_limit|billing_error",
    "hooks": [{"type": "command", "command": marker}],
})
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(settings, f, indent=2)
os.replace(tmp, path)
PY2
}

hooks_unwire_dir() { # $1 config dir
  python3 - "$1" <<'PY2'
import json, os, sys
d = sys.argv[1]
path = os.path.join(d, "settings.json")
try:
    settings = json.load(open(path))
except Exception:
    sys.exit(0)
orig_path = os.path.join(d, "agent-link-statusline.orig")
sl = settings.get("statusLine") or {}
if "claude-quota-statusline" in sl.get("command", ""):
    orig = ""
    try: orig = open(orig_path).read().strip()
    except OSError: pass
    if orig:
        settings["statusLine"] = {"type": "command", "command": orig}
        os.remove(orig_path)
    else:
        settings.pop("statusLine", None)
hooks = settings.get("hooks") or {}
if "StopFailure" in hooks:
    hooks["StopFailure"] = [e for e in hooks["StopFailure"] if "agent-link" not in json.dumps(e)]
    if not hooks["StopFailure"]:
        del hooks["StopFailure"]
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(settings, f, indent=2)
os.replace(tmp, path)
PY2
}

# A HOLD is a park that never expires: a monthly spend limit, or a person
# saying "keep this account out". Time cannot prove either one over — only a
# passing probe or an explicit clear releases it.
hold_set() { # $1 provider, $2 key, $3 reason
  mkdir -p "$(pools_dir)"
  printf '%s\n' "${3:-held}" > "$(pools_dir)/hold-$1-$2"
  rm -f "$(pools_dir)/nearing-$1-$2"
}
hold_get() { # $1 provider, $2 key — prints the reason if held
  cat "$(pools_dir)/hold-$1-$2" 2>/dev/null
}
hold_clear() { rm -f "$(pools_dir)/hold-$1-$2"; }

model_key() {
  printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | sed -E 's/^claude-//; s/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

model_held() { # provider account model — true only for this requested model
  local key
  [ -n "${3:-}" ] || return 1
  key="$(model_key "$3")"
  [ -n "$key" ] && [ -f "$(pools_dir)/holdmodel-$1-$2-$key" ]
}

model_holds_text() { # provider account — comma-separated model slugs
  local f prefix out="" label
  prefix="holdmodel-$1-$2-"
  for f in "$(pools_dir)/$prefix"*; do
    [ -f "$f" ] || continue
    label="$(basename "$f")"; label="${label#$prefix}"
    out="${out}${out:+, }$label"
  done
  printf '%s' "$out"
}

is_limit_refusal_text() {
  printf '%s' "$1" | grep -Eqi "you.?ve (hit|reached) .{0,80}limit|usage limit|rate limit|spend limit|limit reached|credit balance|quota exceeded|out of credits"
}

is_auth_failure_text() {
  printf '%s' "$1" | grep -Eqi "failed to authenticate|authentication failed|oauth access token has been revoked|access token.{0,40}(revoked|expired)|api error: *401|not logged in|login required|unauthori[sz]ed"
}

# Park an account that just refused, until the reset time when one was parsed.
autopark() { # $1 provider, $2 key (email or "primary"), $3 until-epoch or hold:<reason>
  mkdir -p "$(pools_dir)"
  case "${3:-}" in
  hold:model:*)
    local model_slug="${3#hold:model:}"
    [ -n "$model_slug" ] || return 1
    printf '%s\n' "model limit refusal — probe this model to release" > "$(pools_dir)/holdmodel-$1-$2-$model_slug"
    # Account health changes affect future turns only. Never terminate a live
    # provider process or manufacture a replacement Paseo chat.
    echo "$(date '+%Y-%m-%d %H:%M')  HELD $1/$2 for model $model_slug" >> "$STATE/autopark.log"
    return 0
    ;;
  hold|hold:spend|hold:unknown)
    local hold_reason="limit refusal with no verified reset — release only after Probe accounts serves"
    [ "${3:-}" = hold:spend ] && hold_reason="monthly spend limit — raise it at claude.ai/settings/usage, then probe the account"
    hold_set "$1" "$2" "$hold_reason"
    # The active turn owns its own lifecycle. Holding an account only prevents
    # it from being selected for a later turn.
    echo "$(date '+%Y-%m-%d %H:%M')  HELD $1/$2 (limit refusal — probe must pass before release)" >> "$STATE/autopark.log"
    if [ "${3:-}" = hold:spend ]; then
      echo "auto: monthly spend limit" > "$(pools_dir)/reason-$1-$2"
    else
      echo "auto: limit refusal — awaiting successful probe" > "$(pools_dir)/reason-$1-$2"
    fi
    return 0
    ;;
  esac
  echo "${3:-$(( $(date +%s) + 60 * 60 ))}" > "$(pools_dir)/cooldown-$1-$2"
  echo "auto: refused for a limit" > "$(pools_dir)/reason-$1-$2"
  echo "$(date '+%Y-%m-%d %H:%M')  auto-parked $1/$2 after a limit refusal" >> "$STATE/autopark.log"
}

slot_available() { # $1 provider, $2 email, $3 requested model
  local until now reset actual
  prov_logged_in "$1" "$(slot_dir "$1" "$2")" || return 1
  actual="$(prov_email "$1" "$(slot_dir "$1" "$2")")"
  [ -n "$actual" ] && [ "$actual" != "$2" ] && return 1
  [ -f "$(pools_dir)/hold-$1-$2" ] && return 1
  model_held "$1" "$2" "${3:-}" && return 1
  until="$(cat "$(pools_dir)/cooldown-$1-$2" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  [ "$until" -gt "$now" ] && return 1
  if reset="$(recently_refused "$1" "$(slot_dir "$1" "$2")")"; then
    autopark "$1" "$2" "$reset"
    case "$reset" in hold:model:*) model_held "$1" "$2" "${3:-}" && return 1 ;; *) return 1 ;; esac
  fi
  if [ "$1" = claude ]; then
    claude_quota_scan "$2" "$(slot_dir "$1" "$2")" || return 1
  elif [ "$1" = codex ]; then
    codex_quota_scan "$2" "$(slot_dir "$1" "$2")" || return 1
  fi
  return 0
}

# Claude's interactive /usage view also caches its exact windows in
# .claude.json. Paseo launches Claude non-interactively, where a statusline is
# never rendered, so use this token-free cache when it exists. Fresh generic
# account windows participate in routing; model-scoped windows are display
# evidence only because exhausting one model does not exhaust the account.
claude_quota_scan() { # $1 key (email|primary), $2 config dir — 1 = just parked
  local key="$1" dir="$2" state used resets fresh now
  now="$(date +%s)"
  state="$(python3 - "$dir" "$(pools_dir)" "$key" <<'PY2' 2>/dev/null
import json, os, sys, time
config_dir, pools, key = sys.argv[1:4]
path = os.path.join(config_dir, ".claude.json")
if os.path.basename(config_dir) == ".claude":
    path = os.path.join(os.path.dirname(config_dir), ".claude.json")
try:
    config = json.load(open(path))
    cached = config.get("cachedUsageUtilization") or {}
    usage = cached.get("utilization") or {}
except Exception:
    sys.exit(0)
fetched = cached.get("fetchedAtMs") or 0
try:
    fetched = int(fetched / 1000) if fetched > 10_000_000_000 else int(fetched)
except Exception:
    fetched = 0
def epoch(value):
    if isinstance(value, (int, float)):
        return int(value / 1000) if value > 10_000_000_000 else int(value)
    if isinstance(value, str) and value:
        try:
            from datetime import datetime
            return int(datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())
        except Exception:
            return 0
    return 0
snap = {"at": fetched, "source": "Claude /usage cache", "windows": []}
generic = []
for name, label, kind, minutes in (
    ("five_hour", "Session limit", "session", 300),
    ("seven_day", "Weekly limit", "weekly", 10080),
):
    window = usage.get(name) or {}
    pct = window.get("utilization")
    if not isinstance(pct, (int, float)):
        continue
    reset = epoch(window.get("resets_at"))
    snap[name] = {"pct": float(pct), "resets_at": reset}
    snap["windows"].append({"label": label, "kind": kind, "duration_minutes": minutes,
                            "pct": float(pct), "resets_at": reset})
    generic.append((float(pct), reset))
for limit in usage.get("limits") or []:
    if not isinstance(limit, dict):
        continue
    model = (((limit.get("scope") or {}).get("model") or {}).get("display_name"))
    pct = limit.get("percent")
    if not model or not isinstance(pct, (int, float)):
        continue
    snap["windows"].append({"label": f"{model} weekly limit", "kind": "weekly", "duration_minutes": 10080,
                            "pct": float(pct), "resets_at": epoch(limit.get("resets_at"))})
if not generic:
    sys.exit(0)
try:
    os.makedirs(pools, exist_ok=True)
    open(os.path.join(pools, f"quota-claude-{key}.json"), "w").write(json.dumps(snap))
except OSError:
    pass
worst = max(generic, key=lambda item: item[0])
fresh = 1 if fetched and time.time() - fetched < 45 * 60 else 0
print(f"{worst[0]:.1f} {worst[1]} {fresh}")
PY2
)"
  [ -n "$state" ] || return 0
  IFS=' ' read -r used resets fresh <<< "$state"
  used="${used%%.*}"
  mkdir -p "$(pools_dir)"
  if [ "$fresh" = 1 ] && [ "$used" -ge 99 ] && [ "$resets" -gt "$now" ]; then
    echo "$resets" > "$(pools_dir)/cooldown-claude-$key"
    echo "auto: quota exhausted (Claude /usage cache)" > "$(pools_dir)/reason-claude-$key"
    rm -f "$(pools_dir)/nearing-claude-$key"
    echo "$(date '+%Y-%m-%d %H:%M')  parked claude/$key at ${used}% until its reset (/usage cache)" >> "$STATE/autopark.log"
    return 1
  fi
  if [ "$fresh" = 1 ] && [ "$used" -ge 85 ]; then
    [ -f "$(pools_dir)/nearing-claude-$key" ] || \
      echo "$(date '+%Y-%m-%d %H:%M')  nearing mark on claude/$key at ${used}% (/usage cache)" >> "$STATE/autopark.log"
    date +%s > "$(pools_dir)/nearing-claude-$key"
  elif [ "$fresh" = 1 ] && [ "$used" -lt 75 ]; then
    rm -f "$(pools_dir)/nearing-claude-$key"
  fi
  return 0
}

# Codex needs no hooks at all: every turn's rollout line carries
# rate_limits.primary.{used_percent,resets_at} and rate_limit_reached_type.
# Read the newest rollout's tail at routing time and apply the same policy as
# Claude's statusline wrapper — reached or >=99%% parks until Codex's own
# resets_at, >=85%% (fresh data only) flags nearing, back under 75%% clears.
codex_quota_scan() { # $1 key (email|primary), $2 config dir — 1 = just parked
  local key="$1" dir="$2" f state used resets reached fresh now
  f="$(ls -t "$dir"/sessions/*/*/*/*.jsonl 2>/dev/null | head -1)"
  [ -n "$f" ] || return 0
  now="$(date +%s)"
  state="$(python3 - "$f" "$(pools_dir)" "$key" <<'PY2' 2>/dev/null
import json, os, sys, time
path = sys.argv[1]
floor = 0
try:
    floor = int(open(path + ".al-moved").read().strip())
except (OSError, ValueError):
    pass
try:
    size = os.path.getsize(path)
    if size <= floor:
        sys.exit(0)  # untouched since the move: the tail is old-account data
    with open(path, "rb") as fh:
        fh.seek(max(floor, size - 60000))
        tail = fh.read().decode("utf-8", "ignore")
except OSError:
    sys.exit(0)
for line in reversed(tail.splitlines()):
    if '"rate_limits"' not in line:
        continue
    try:
        rl = json.loads(line)["payload"]["rate_limits"]
    except Exception:
        continue
    prim = rl.get("primary") or {}
    sec = rl.get("secondary") or {}
    available = [w for w in (prim, sec) if w.get("used_percent") is not None]
    if not available:
        continue
    worst = max(available, key=lambda w: float(w.get("used_percent") or 0))
    used = worst.get("used_percent")
    resets = worst.get("resets_at") or 0
    reached = 1 if rl.get("rate_limit_reached_type") else 0
    fresh = 1 if time.time() - os.stat(path).st_mtime < 45 * 60 else 0
    try:
        pools = sys.argv[2] if len(sys.argv) > 2 else ""
        key = sys.argv[3] if len(sys.argv) > 3 else ""
        if pools and key:
            snap = {"at": int(os.stat(path).st_mtime), "plan": rl.get("plan_type")}
            for name, window in (("primary", prim), ("secondary", sec)):
                pct = window.get("used_percent")
                if pct is not None:
                    snap[name] = {"pct": float(pct), "resets_at": int(window.get("resets_at") or 0),
                                  "window_minutes": window.get("window_minutes")}
            credits = rl.get("credits") or {}
            if isinstance(credits.get("has_credits"), bool):
                snap["credits"] = {"has_credits": credits.get("has_credits"),
                                   "unlimited": bool(credits.get("unlimited")),
                                   "balance": str(credits.get("balance") or "")}
            open(os.path.join(pools, f"quota-codex-{key}.json"), "w").write(json.dumps(snap))
    except OSError:
        pass
    print(f"{float(used):.1f} {int(resets)} {reached} {fresh}")
    break
PY2
)"
  [ -n "$state" ] || return 0
  set -- $state
  used="${1%%.*}"; resets="$2"; reached="$3"; fresh="$4"
  mkdir -p "$(pools_dir)"
  if { [ "$reached" = 1 ] || [ "$used" -ge 99 ]; } && [ "$resets" -gt "$now" ]; then
    echo "$resets" > "$(pools_dir)/cooldown-codex-$key"
    echo "auto: quota exhausted (rollout)" > "$(pools_dir)/reason-codex-$key"
    rm -f "$(pools_dir)/nearing-codex-$key"
    echo "$(date '+%Y-%m-%d %H:%M')  parked codex/$key at ${used}% until its reset (rollout)" >> "$STATE/autopark.log"
    return 1
  fi
  if [ "$used" -ge 85 ] && [ "$fresh" = 1 ]; then
    [ -f "$(pools_dir)/nearing-codex-$key" ] ||       echo "$(date '+%Y-%m-%d %H:%M')  nearing mark on codex/$key at ${used}% (rollout)" >> "$STATE/autopark.log"
    date +%s > "$(pools_dir)/nearing-codex-$key"
  elif [ "$used" -lt 75 ]; then
    rm -f "$(pools_dir)/nearing-codex-$key"
  fi
  return 0
}

# Routing preference: 0 = prefer first, 1 = normal, 2 = prefer last. Set with
# `agent-link prefer <prov> <email|primary> first|last|clear`. Preference is a
# tie-breaker ABOVE recency but BELOW health — a preferred account that is
# parked, held or nearing still loses to a healthy ordinary one.
pref_rank() { # $1 provider, $2 key
  if grep -qxF "$2" "$STATE/prefer-$1-first" 2>/dev/null; then echo 0
  elif grep -qxF "$2" "$STATE/prefer-$1-last" 2>/dev/null; then echo 2
  else echo 1
  fi
}

# The /usage view, across every account: live window percentages captured from
# each session's own telemetry (Claude statusline, Codex rollouts), with age,
# park/hold state and routing preference. Stale snapshots say so — an account
# that has not run recently has no fresher truth to offer without a paid probe.
# ------------------------------------------------------------ AgentRouter
# An OPTIONAL Paseo provider profile: a configurable Claude-compatible
# controller interprets every prompt and delegates the answer to a concrete
# provider/model through Paseo. The default claude-auto controller keeps
# account health routing intact.
probe_account_once() { # $1 provider, $2 config dir (empty = primary), $3 optional model
  local p="$1" dir="${2:-}" model="${3:-}" args=()
  if [ "$p" = claude ]; then
    [ -n "$model" ] && args+=(--model "$model")
    if [ -n "$dir" ]; then
      CLAUDE_CONFIG_DIR="$dir" claude -p "Reply with exactly ok." "${args[@]}"
    else
      env -u CLAUDE_CONFIG_DIR claude -p "Reply with exactly ok." "${args[@]}"
    fi
  else
    args=(exec --skip-git-repo-check --ephemeral --color never)
    [ -n "$model" ] && args+=(--model "$model")
    args+=("Reply with exactly ok.")
    if [ -n "$dir" ]; then
      CODEX_HOME="$dir" codex "${args[@]}"
    else
      env -u CODEX_HOME codex "${args[@]}"
    fi
  fi
}

cmd_revalidate() { # [provider] — probe only HELD accounts, release those that serve
  local p="${1:-claude}" e dir out rc held=0
  prov_valid "$p" || { echo "usage: agent-link revalidate [claude|codex]" >&2; return 1; }
  for e in primary $(slot_list "$p"); do
    [ -f "$(pools_dir)/hold-$p-$e" ] || continue
    held=$((held+1))
    if [ "$e" = primary ]; then dir=""; else dir="$(slot_dir "$p" "$e")"; fi
    printf '  %-28s ' "$e"
    out="$(probe_account_once "$p" "$dir" "" 2>&1)"
    rc=$?
    out="$(printf '%s' "$out" | tr '\n' ' ')"
    if [ "$rc" -ne 0 ]; then
      printf 'probe failed — hold stands\n'
    elif is_limit_refusal_text "$out"; then
      printf 'still refusing — hold stands\n'
    else
        rm -f "$(pools_dir)/hold-$p-$e" "$(pools_dir)/cooldown-$p-$e" "$(pools_dir)/reason-$p-$e"
        printf 'RECOVERED — released back into rotation\n'
        echo "$(date '+%Y-%m-%d %H:%M')  released $p/$e — it serves again (revalidate)" >> "$STATE/autopark.log"
    fi
    date +%s > "$(pools_dir)/holdcheck-$p-$e"
  done
  [ "$held" -gt 0 ] || echo "  no held $p accounts to re-prove"
}

# Fired detached from a launch when a hold has gone stale, so recovery happens
# without anyone remembering to run anything.
cmd_usage() {
  local p e key f state pref quota_dir
  for p in $PROVIDERS; do
    echo "$p"
    for key in primary $(slot_list "$p"); do
      if [ "$key" = primary ]; then
        e="$(primary_email "$p")"; [ -n "$e" ] || continue
        e="$e (primary)"
      else
        prov_logged_in "$p" "$(slot_dir "$p" "$key")" || continue
        e="$key"
      fi
      if [ -f "$(pools_dir)/hold-$p-$key" ]; then state="HELD"
      elif [ "$(cat "$(pools_dir)/cooldown-$p-$key" 2>/dev/null || echo 0)" -gt "$(date +%s)" ]; then state="parked"
      elif slot_nearing "$p" "$key" 2>/dev/null; then state="nearing"
      else state="ok"
      fi
      pref="$(pref_rank "$p" "$key")"
      case "$pref" in 0) pref=" · prefer first" ;; 2) pref=" · prefer last" ;; *) pref="" ;; esac
      if [ "$p" = claude ]; then
        if [ "$key" = primary ]; then quota_dir="$HOME/.claude"; else quota_dir="$(slot_dir "$p" "$key")"; fi
        claude_quota_scan "$key" "$quota_dir" >/dev/null 2>&1 || true
      fi
      f="$(pools_dir)/quota-$p-$key.json"
      printf '  %-34s %-8s%s\n' "$e" "$state" "$pref"
      if [ -f "$f" ]; then
        python3 - "$f" <<'PY3'
import json, sys, time
try: q = json.load(open(sys.argv[1]))
except Exception: sys.exit(0)
age = int((time.time() - q.get("at", 0)) / 60)
stale = f" (as of {age}m ago)" if age > 30 else ""
def bar(pct):
    filled = int(round(pct / 10))
    return "#" * filled + "-" * (10 - filled)
def when(ts):
    if not ts: return ""
    return time.strftime("resets %a %H:%M", time.localtime(ts))
rows = []
custom = q.get("windows") or []
if custom:
    for w in custom:
        if not isinstance(w, dict) or not isinstance(w.get("pct"), (int, float)):
            continue
        label = w.get("label") or "limit"
        rows.append(f"{label} [{bar(w['pct'])}] {w['pct']:.0f}%  {when(w.get('resets_at'))}")
else:
    for fallback, k in (("5h", "five_hour"), ("7d", "seven_day"), ("limit", "primary"), ("limit", "secondary")):
        w = q.get(k)
        if not w: continue
        minutes = w.get("window_minutes") or (q.get("window_minutes") if k == "primary" else 0)
        if minutes and minutes <= 360: label = "session"
        elif minutes and minutes >= 10080: label = "weekly"
        else: label = fallback
        rows.append(f"{label} [{bar(w['pct'])}] {w['pct']:.0f}%  {when(w.get('resets_at'))}")
model = q.get("model") or q.get("plan") or ""
for r in rows:
    print(f"      {r}")
if model or stale:
    print(f"      {model}{stale}")
PY3
      else
        if [ "$p" = claude ]; then
          if [ "$key" = primary ]; then
            echo "      no quota report — open 'claude', send one message, then check again"
          else
            echo "      no quota report — run: agent-link run claude $key claude  (then send one message)"
          fi
        else
          echo "      no telemetry yet — run one Codex session on it"
        fi
      fi
    done
  done
}

cmd_prefer() { # $1 provider [$2 email|primary] [first|last|clear]
  prov_valid "${1:-}" || { echo "usage: agent-link prefer <claude|codex> [email|primary] [first|last|clear]" >&2; return 1; }
  local p="$1" key="${2:-}" verb="${3:-}" f
  if [ -z "$key" ]; then
    echo "$p routing preference:"
    for f in first last; do
      [ -s "$STATE/prefer-$p-$f" ] && while IFS= read -r e; do echo "  $f: $e"; done < "$STATE/prefer-$p-$f"
    done
    [ -s "$STATE/prefer-$p-first" ] || [ -s "$STATE/prefer-$p-last" ] || echo "  (none — pure least-recently-used)"
    return 0
  fi
  { [ "$key" = primary ] || valid_account "$key"; } || { echo "bad account '$key'" >&2; return 1; }
  mkdir -p "$STATE"
  for f in first last; do
    [ -f "$STATE/prefer-$p-$f" ] && grep -vxF "$key" "$STATE/prefer-$p-$f" > "$STATE/prefer-$p-$f.tmp" 2>/dev/null && mv "$STATE/prefer-$p-$f.tmp" "$STATE/prefer-$p-$f" || rm -f "$STATE/prefer-$p-$f.tmp"
  done
  case "$verb" in
    first|last) echo "$key" >> "$STATE/prefer-$p-$verb"; echo "$p · $key: preferred $verb" ;;
    clear|"")   echo "$p · $key: preference cleared" ;;
    *) echo "usage: agent-link prefer <claude|codex> <email|primary> first|last|clear" >&2; return 1 ;;
  esac
}

record_route_decision() { # provider target decision group
  local route_log route_lines agent_id route_cwd route_model agent_file
  mkdir -p "$(pools_dir)"
  route_log="$(pools_dir)/routes.log"
  agent_id="$(printf '%s' "${PASEO_AGENT_ID:-}" | tr '\t\r\n' '   ')"
  route_cwd="$(printf '%s' "${PASEO_AGENT_CWD:-$PWD}" | tr '\t\r\n' '   ')"
  route_model="$(printf '%s' "${AGENT_LINK_ROUTE_MODEL:-}" | tr '\t\r\n' '   ')"
  if [ -z "$route_model" ] && [ -n "$agent_id" ]; then
    agent_file="$(find "${PASEO_HOME:-$HOME/.paseo}/agents" -maxdepth 2 -type f -name "$agent_id.json" -print -quit 2>/dev/null || true)"
    [ -n "$agent_file" ] && route_model="$(sed -n 's/.*"model":[[:space:]]*"\([^"]*\)".*/\1/p' "$agent_file" | head -1)"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$1" "$2" "$3" "$4" "$agent_id" "$route_cwd" "$route_model" >> "$route_log"
  route_lines="$(wc -l < "$route_log" 2>/dev/null | tr -d ' ' || echo 0)"
  if [ "${route_lines:-0}" -gt 240 ]; then
    tail -n 200 "$route_log" > "$route_log.tmp" && mv "$route_log.tmp" "$route_log"
  fi
}

# Print the slot to use next ("primary" or an email), and stamp it as used.
pick_slot() { # $1 provider, $2 dry|live, $3 requested model
  local best="" best_ts="" e ts pemail covered pass decision="" rank_label="standard" model="${3:-}"
  mkdir -p "$(pools_dir)"
  # The primary counts as a candidate unless a slot already holds that account.
  pemail="$(primary_email "$1")"
  covered=""
  if [ -n "$pemail" ]; then
    for e in $(slot_list "$1"); do
      [ "$(prov_email "$1" "$(slot_dir "$1" "$e")")" = "$pemail" ] && covered=1
    done
  fi
  # Two passes: accounts flagged as nearing their limit are only considered
  # when nothing unflagged is available — drain new work off them early.
  local rank best_rank=""
  for pass in fresh nearing; do
    if [ -n "$pemail" ] && [ -z "$covered" ] && slot_available_primary "$1" "$model"; then
      if [ "$pass" = nearing ] || ! slot_nearing "$1" primary; then
        ts="$(cat "$(pools_dir)/last-$1-primary" 2>/dev/null || echo 0)"
        best="primary"; best_ts="$ts"; best_rank="$(pref_rank "$1" primary)"
      fi
    fi
    for e in $(slot_list "$1"); do
      slot_available "$1" "$e" "$model" || continue
      [ "$pass" = fresh ] && slot_nearing "$1" "$e" && continue
      ts="$(cat "$(pools_dir)/last-$1-$e" 2>/dev/null || echo 0)"
      rank="$(pref_rank "$1" "$e")"
      if [ -z "$best" ] || [ "$rank" -lt "$best_rank" ] || { [ "$rank" -eq "$best_rank" ] && [ "$ts" -lt "$best_ts" ]; }; then
        best="$e"; best_ts="$ts"; best_rank="$rank"
      fi
    done
    if [ -n "$best" ]; then
      [ "$pass" = fresh ] && decision="healthy" || decision="nearing fallback"
      break
    fi
  done
  # Health filtering is fail-closed: handing out a known parked
  # target only creates another doomed process and can start a restart loop.
  if [ -z "$best" ]; then
    [ "${2:-}" = dry ] || record_route_decision "$1" "-" "blocked · no healthy targets" fallback
    echo "$(date '+%Y-%m-%d %H:%M')  all $1 accounts parked — launch blocked" >> "$STATE/autopark.log"
    return 1
  fi
  [ "${2:-}" = dry ] && { echo "$best"; return 0; }
  date +%s > "$(pools_dir)/last-$1-$best"
  # Launch counter: how many agents this account has actually been handed.
  local n
  n="$(cat "$(pools_dir)/count-$1-$best" 2>/dev/null || echo 0)"
  echo $(( n + 1 )) > "$(pools_dir)/count-$1-$best"
  case "$best_rank" in 0) rank_label="preferred" ;; 2) rank_label="reserve" ;; 9) rank_label="fallback" ;; esac
  # Decision trace: real launches only, never dry previews.
  record_route_decision "$1" "$best" "$decision" "$rank_label"
  echo "$best"
}

slot_register() { # $1 provider, $2 email — record in order file once
  mkdir -p "$STATE"
  touch "$(order_file "$1")"
  grep -qxF "$2" "$(order_file "$1")" || echo "$2" >> "$(order_file "$1")"
}

# Status of one slot. Prints a line; returns 0 only if logged in as the right account.
slot_check() { # $1 provider, $2 email, $3 index
  local dir got
  dir="$(slot_dir "$1" "$2")"
  if ! prov_logged_in "$1" "$dir" || { [ "$1" = claude ] && ! claude_auth_live "$dir"; }; then
    printf '  [ ] %s-%s  %s  — not logged in\n' "$1" "$3" "$2"
    return 1
  fi
  got="$(prov_email "$1" "$dir")"
  if [ -n "$got" ] && [ "$got" != "$2" ]; then
    printf '  [!] %s-%s  %s  — logged in as %s (WRONG ACCOUNT — rerun: agent-link login %s %s)\n' \
      "$1" "$3" "$2" "$got" "$1" "$2"
    return 1
  fi
  printf '  [x] %s-%s  %s  — logged in\n' "$1" "$3" "$2"
  return 0
}

slot_login() { # $1 provider, $2 email
  local dir
  prov_binary_check "$1" || return 127
  dir="$(slot_dir "$1" "$2")"
  mkdir -p "$dir"
  prov_prepare "$1" "$dir"
  slot_register "$1" "$2"
  echo
  echo "==> $1 login for: $2"
  echo "    In the browser, sign in as EXACTLY this account: $2"
  echo "    Tip: if the browser is already signed into another account, paste the"
  echo "    login URL into a private/incognito window instead."
  prov_login "$1" "$dir" "$2"
  local i=0 e
  for e in $(slot_list "$1"); do i=$((i+1)); [ "$e" = "$2" ] && break; done
  if ! slot_check "$1" "$2" "$i"; then
    # The CLI's own errors are terse ("status code 400") and the causes are
    # always the same three, so name them and hand back the retry.
    echo
    echo "    The sign-in didn't complete. A 'status code 400' means the pasted code"
    echo "    was refused — the usual reasons:"
    echo "      - the URL came from an EARLIER run: every run mints a fresh single-use"
    echo "        link, and a code from an old link is always rejected"
    echo "      - only part of the code was pasted: include everything after '#'"
    echo "      - the code expired: they only live a few minutes"
    echo "    Try again (a fresh link is printed each time):"
    echo "      agent-link login $1 $2"
    return 1
  fi
  clear_auth_hold "$1" "$2"
}

claude_auth_live() { # primary | config dir
  local target="${1:-primary}" real out
  real="$(prov_real_binary claude 2>/dev/null || true)"
  [ -n "$real" ] || return 1
  if [ "$target" = primary ]; then
    out="$( ( unset CLAUDE_CONFIG_DIR; "$real" auth status --json ) 2>/dev/null)"
  else
    out="$(CLAUDE_CONFIG_DIR="$target" "$real" auth status --json 2>/dev/null)"
  fi
  printf '%s' "$out" | python3 -c 'import json,sys
try: raise SystemExit(0 if json.load(sys.stdin).get("loggedIn") is True else 1)
except Exception: raise SystemExit(1)'
}

clear_auth_hold() { # provider key
  local reason
  reason="$(hold_get "$1" "$2" 2>/dev/null || true)"
  case "$reason" in
    authentication\ failed*)
      hold_clear "$1" "$2"
      rm -f "$(pools_dir)/reason-$1-$2"
      echo "    authentication restored; account released"
      ;;
  esac
}

primary_claude_login() {
  local real email
  real="$(prov_real_binary claude 2>/dev/null || true)"
  [ -n "$real" ] || { prov_binary_check claude; return 127; }
  email="$(primary_email claude)"
  echo
  echo "==> claude login for: primary${email:+ ($email)}"
  if [ -n "$email" ]; then
    ( unset CLAUDE_CONFIG_DIR; "$real" auth login --email "$email" )
  else
    ( unset CLAUDE_CONFIG_DIR; "$real" auth login )
  fi
  if ! claude_auth_live primary; then
    echo "primary Claude sign-in did not complete" >&2
    return 1
  fi
  clear_auth_hold claude primary
}

primary_codex_login() {
  local real
  real="$(prov_real_binary codex 2>/dev/null || true)"
  [ -n "$real" ] || { prov_binary_check codex; return 127; }
  echo
  echo "==> codex login for: primary"
  ( unset CODEX_HOME; "$real" login )
  if ! prov_logged_in codex "$HOME/.codex"; then
    echo "primary Codex sign-in did not complete" >&2
    return 1
  fi
  clear_auth_hold codex primary
}

# ---------------------------------------------------------------- commands

# ---------------------------------------------------------------- presentation

# Colour only for a real terminal, and never when NO_COLOR is set.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  C_OFF=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_CYAN=$'\033[36m'
else
  C_OFF=""; C_BOLD=""; C_DIM=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_CYAN=""
fi

# One place that knows how an account should look: dot colour + words.
slot_state() { # $1 provider, $2 email -> "dot|state|note"
  local dir got until now last mins runs held held_models suffix
  dir="$(slot_dir "$1" "$2")"
  if ! prov_logged_in "$1" "$dir"; then
    printf '%s|%s|%s' "${C_YELLOW}○${C_OFF}" "not logged in" "run 'l' to log in"
    return
  fi
  got="$(prov_email "$1" "$dir")"
  if [ -n "$got" ] && [ "$got" != "$2" ]; then
    printf '%s|%s|%s' "${C_RED}●${C_OFF}" "WRONG ACCOUNT" "signed in as $got"
    return
  fi
  held="$(hold_get "$1" "$2" 2>/dev/null || true)"
  if [ -n "$held" ]; then
    printf '%s|%s|%s' "${C_RED}●${C_OFF}" "held" "$held"
    return
  fi
  now="$(date +%s)"
  until="$(cat "$(pools_dir)/cooldown-$1-$2" 2>/dev/null || echo 0)"
  last="$(cat "$(pools_dir)/last-$1-$2" 2>/dev/null || echo 0)"
  held_models="$(model_holds_text "$1" "$2")"
  suffix="${held_models:+ · unavailable: $held_models}"
  if [ "$until" -gt "$now" ]; then
    printf '%s|%s|%s' "${C_RED}●${C_OFF}" "logged in" "parked $(( (until - now + 59) / 60 ))m — $(cat "$(pools_dir)/reason-$1-$2" 2>/dev/null || echo 'routing skips it')"
    return
  fi
  local runs
  runs="$(cat "$(pools_dir)/count-$1-$2" 2>/dev/null || echo 0)"
  if [ "$last" -gt 0 ]; then
    mins=$(( (now - last) / 60 ))
    printf '%s|%s|%s' "${C_GREEN}●${C_OFF}" "logged in" "in rotation · ${runs} launches · last ${mins}m ago${suffix}"
  else
    printf '%s|%s|%s' "${C_GREEN}●${C_OFF}" "logged in" "in rotation · never used${suffix}"
  fi
}

cmd_status() {
  local p e i pointer state dot words note auto right pad pemail pcov pruns pnote puntil pnow phold pdot
  for p in $PROVIDERS; do
    pointer="primary"
    [ -f "$(route_file "$p")" ] && pointer="$(cat "$(route_file "$p")")"
    echo
    right="plain \`$p\` → $pointer"
    pad=$(( 60 - ${#p} - ${#right} )); [ "$pad" -lt 2 ] && pad=2
    printf '  %s%s%s%*s%s%s%s\n' "$C_BOLD" "$(echo "$p" | tr '[:lower:]' '[:upper:]')" "$C_OFF" \
      "$pad" "" "$C_DIM" "$right" "$C_OFF"
    pemail="$(primary_email "$p")"
    pcov=""
    for e in $(slot_list "$p"); do
      [ "$(prov_email "$p" "$(slot_dir "$p" "$e")")" = "$pemail" ] && pcov=1
    done
    if [ -n "$pemail" ]; then
      pruns="$(cat "$(pools_dir)/count-$p-primary" 2>/dev/null || echo 0)"
      puntil="$(cat "$(pools_dir)/cooldown-$p-primary" 2>/dev/null || echo 0)"
      pnow="$(date +%s)"
      phold="$(hold_get "$p" primary 2>/dev/null || true)"
      pdot="${C_GREEN}●${C_OFF}"
      if [ -n "$phold" ]; then
        pdot="${C_RED}●${C_OFF}"
        pnote="HELD — $phold"
      elif [ -n "$pcov" ]; then
        pnote="duplicated by a slot below"
      elif [ "$puntil" -gt "$pnow" ]; then
        pdot="${C_RED}●${C_OFF}"
        pnote="parked $(( (puntil - pnow + 59) / 60 ))m — $(cat "$(pools_dir)/reason-$p-primary" 2>/dev/null || echo 'routing skips it')"
      else
        pnote="in rotation · ${pruns} launches"
      fi
      printf '    %s %-30s %-14s %s%s%s\n' "$pdot" "$pemail" "primary" "$C_DIM" "$pnote" "$C_OFF"
    fi
    i=0
    for e in $(slot_list "$p"); do
      i=$((i+1))
      state="$(slot_state "$p" "$e")"
      dot="${state%%|*}"; words="$(echo "$state" | cut -d'|' -f2)"; note="${state##*|}"
      printf '    %s %-30s %-14s %s%s%s\n' "$dot" "$e" "$words" "$C_DIM" "$note" "$C_OFF"
    done
    [ "$i" = 0 ] && printf '    %sno accounts yet — press %sa%s to add one%s\n' "$C_DIM" "$C_BOLD" "$C_DIM" "$C_OFF"
    if [ -x "$SHIM_BIN/$p-auto" ]; then
      auto="${C_GREEN}ready${C_OFF} ${C_DIM}($SHIM_BIN/$p-auto)${C_OFF}"
    else
      auto="${C_DIM}not set up — press d${C_OFF}"
    fi
    printf '    %sdynamic routing:%s %b\n' "$C_DIM" "$C_OFF" "$auto"
  done
  return 0
}

cmd_add() { # provider email
  prov_valid "${1:-}" || { echo "usage: agent-link add <claude|codex> <email>" >&2; return 1; }
  valid_account "${2:-}" || { echo "invalid account name: '${2:-}'" >&2; return 1; }
  slot_login "$1" "$2"
}

cmd_login() { # [provider] [email|all]
  local p e i
  case "${1:-all}" in
    all)
      for p in $PROVIDERS; do
        if [ "$p" = claude ] && ! claude_auth_live primary; then
          primary_claude_login || true
        elif [ "$p" = codex ] && ! prov_logged_in codex "$HOME/.codex"; then
          primary_codex_login || true
        fi
        i=0
        for e in $(slot_list "$p"); do
          i=$((i+1))
          slot_check "$p" "$e" "$i" >/dev/null || slot_login "$p" "$e"
        done
      done
      ;;
    claude|codex)
      p="$1"
      if [ "$p" = claude ] && [ "${2:-}" = primary ]; then
        primary_claude_login
      elif [ "$p" = codex ] && [ "${2:-}" = primary ]; then
        primary_codex_login
      elif [ -n "${2:-}" ] && [ "${2:-}" != all ]; then
        [ -d "$(slot_dir "$p" "$2")" ] || { echo "no $p slot for '$2' — use: agent-link add $p $2" >&2; return 1; }
        slot_login "$p" "$2"
      else
        if [ "$p" = claude ] && ! claude_auth_live primary; then
          primary_claude_login || true
        elif [ "$p" = codex ] && ! prov_logged_in codex "$HOME/.codex"; then
          primary_codex_login || true
        fi
        i=0
        for e in $(slot_list "$p"); do
          i=$((i+1))
          slot_check "$p" "$e" "$i" >/dev/null || slot_login "$p" "$e"
        done
      fi
      ;;
    *)
      # bare email — find it in any provider
      local found=0
      for p in $PROVIDERS; do
        [ -d "$(slot_dir "$p" "$1")" ] && { slot_login "$p" "$1"; found=1; }
      done
      [ "$found" = 1 ] || { echo "no slot folder for '$1'" >&2; return 1; }
      ;;
  esac
}

cmd_use() { # provider email|primary|<number>
  prov_valid "${1:-}" || { echo "usage: agent-link use <claude|codex> <email|primary|N>" >&2; return 1; }
  local p="$1" target="${2:-}" e i
  [ -n "$target" ] || { echo "usage: agent-link use <claude|codex> <email|primary|N>" >&2; return 1; }
  if [ "$target" != primary ] && ! [ -d "$(slot_dir "$p" "$target")" ]; then
    # allow numeric selection
    if echo "$target" | grep -q '^[0-9][0-9]*$'; then
      i=0
      for e in $(slot_list "$p"); do
        i=$((i+1))
        [ "$i" = "$target" ] && { target="$e"; break; }
      done
    fi
    [ -d "$(slot_dir "$p" "$target")" ] || { echo "no $p slot '$2'" >&2; return 1; }
  fi
  mkdir -p "$STATE"
  echo "$target" > "$(route_file "$p")"
  echo "plain \`$p\` now routes to: $target (new processes only; running ones are unaffected)"
  if [ ! -x "$SHIM_BIN/$p" ]; then
    echo "note: routing shim not installed yet — run: agent-link route enable"
  fi
}

write_router_shim() { # $1 provider
  local p="$1" trust_block=""
  [ "$p" = claude ] && trust_block="$(claude_trust_block)"
  mkdir -p "$SHIM_BIN"
  cat > "$SHIM_BIN/$p" <<EOF
#!/usr/bin/env bash
# agent-link router shim — managed by \`agent-link route\`. Do not edit.
here="\$(cd "\$(dirname "\$0")" && pwd)"
aa_root="\${AGENT_LINK_HOME:-\${AGENT_AUTH_HOME:-$ROOT}}"
target="\$(cat "\$aa_root/state/route-$p" 2>/dev/null || true)"
real=""
old_ifs="\$IFS"; IFS=:
for d in \$PATH; do
  [ -n "\$d" ] || continue
  [ "\$d" = "\$here" ] && continue
  if [ -x "\$d/$p" ] && [ ! "\$d/$p" -ef "\$here/$p" ]; then real="\$d/$p"; break; fi
done
IFS="\$old_ifs"
[ -n "\$real" ] || { echo "agent-link: real '$p' binary not found in PATH" >&2; exit 127; }
# An explicitly inherited value always wins: otherwise this shim would rewrite
# the env of \`agent-link add/run/env\` and send a login into the routed slot.
if [ -z "\${$(prov_env_var "$p"):-}" ] && [ -n "\$target" ] && [ "\$target" != "primary" ]; then
  export $(prov_env_var "$p")="\$aa_root/accounts/$p/\$target"
fi
$trust_block
exec "\$real" "\$@"
EOF
  chmod +x "$SHIM_BIN/$p"
}

cmd_route() { # enable|disable|status
  local p
  case "${1:-status}" in
    enable)
      for p in $PROVIDERS; do write_router_shim "$p"; done
      echo "Router shims written to $SHIM_BIN"
      echo
      echo "Put them FIRST in PATH by adding this to your shell profile:"
      echo "  export PATH=\"$SHIM_BIN:\$PATH\""
      echo
      echo "Then: agent-link use claude <email>   # or 'primary' to route back"
      ;;
    disable)
      for p in $PROVIDERS; do rm -f "$SHIM_BIN/$p"; done
      echo "Router shims removed. Plain commands hit your real binaries again."
      ;;
    status|*)
      for p in $PROVIDERS; do
        if [ -x "$SHIM_BIN/$p" ]; then
          printf '%s: shim installed, routing to %s\n' "$p" "$(cat "$(route_file "$p")" 2>/dev/null || echo primary)"
        else
          printf '%s: no shim (plain `%s` is untouched)\n' "$p" "$p"
        fi
      done
      case ":$PATH:" in
        *":$SHIM_BIN:"*) ;;
        *)
          if [ -x "$SHIM_BIN/claude" ] || [ -x "$SHIM_BIN/codex" ]; then
            echo "warning: $SHIM_BIN is not in PATH — routing is inert until it is (and first)"
          fi
          ;;
      esac
      return 0
      ;;
  esac
}

# An untrusted project makes Claude IGNORE every permissions.allow entry, and a
# freshly created slot trusts nothing — agents routed there stall on permission
# prompts until their runtime dies (measured: repeated "Ignoring 69
# permissions.allow entries" stderr, every one on an unsynced slot). Launching
# in a directory IS the user's trust decision, so each claude launcher marks
# its cwd trusted in the chosen account first. Unreadable config: touch nothing.
claude_trust_block() {
  cat <<'TRUST'
aa_cfg="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"
if [ -f "$aa_cfg" ]; then
  python3 - "$aa_cfg" "$PWD" <<'AAPY' 2>/dev/null
import json, os, sys
path, cwd = sys.argv[1], sys.argv[2]
try:
    config = json.load(open(path))
except Exception:
    sys.exit(0)  # exists but unreadable: never rewrite what could not be read
projects = config.setdefault("projects", {})
entry = projects.setdefault(cwd, {})
if entry.get("hasTrustDialogAccepted") is not True:
    entry["hasTrustDialogAccepted"] = True
    tmp = path + ".al-tmp"
    with open(tmp, "w") as fh:
        json.dump(config, fh, indent=2)
    os.replace(tmp, path)
AAPY
fi
TRUST
}

acp_runtime_source() {
  local here candidate
  here="$(cd "$(dirname "$0")" && pwd)"
  # A source checkout is authoritative during development. A standalone CLI
  # uses the release-matched managed clone, never an older installed runtime.
  if [ -d "$here/.git" ] || [ -d "$here/../.git" ]; then
    candidate="$here/agent-link-acp.mjs"
    [ -f "$candidate" ] && { echo "$candidate"; return 0; }
    candidate="$here/../agent-link-acp.mjs"
    [ -f "$candidate" ] && { echo "$candidate"; return 0; }
  fi
  candidate="$ROOT/src/agent-link-acp.mjs"
  [ -f "$candidate" ] && { echo "$candidate"; return 0; }
  return 1
}

