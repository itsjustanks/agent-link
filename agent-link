}

cmd_sync() { # propagate MCP definitions + project trust from primaries into slots
  # codex: slot config.toml <- primary ~/.codex/config.toml (MCP servers live there),
  # re-pinned to file credential storage. Overwrites slot-local config edits.
  local d
  if [ -f "$HOME/.codex/config.toml" ]; then
    for d in "$ACCOUNTS/codex"/*/; do
      [ -d "$d" ] || continue
      cp "$HOME/.codex/config.toml" "${d}config.toml"
      codex_pin_file_store "${d}config.toml"
      echo "$(basename "$d"): codex config.toml synced from primary (file-store pinned)"
      [ -f "$HOME/.codex/AGENTS.md" ] && cp "$HOME/.codex/AGENTS.md" "${d}AGENTS.md" && echo "$(basename "$d"): AGENTS.md synced"
    done
  fi
  # claude: slot .claude.json <- definitions and trust from primary ~/.claude.json
  python3 - "$ACCOUNTS/claude" <<'PY'
import json, os, sys, glob

root = sys.argv[1]
primary_path = os.path.expanduser("~/.claude.json")
if not os.path.exists(primary_path):
    print("no primary ~/.claude.json — nothing to sync"); sys.exit(0)
primary = json.load(open(primary_path))
mcp = primary.get("mcpServers", {})
projects = primary.get("projects", {})
GLOBAL_FLAGS = ["hasCompletedOnboarding", "bypassPermissionsModeAccepted", "theme", "autoUpdates", "effortLevel"]
SETTINGS_KEYS = ["outputStyle", "includeCoAuthoredBy", "env", "permissions", "model"]
PROJECT_FIELDS = ["hasTrustDialogAccepted", "hasCompletedProjectOnboarding", "allowedTools",
                  "mcpServers", "enabledMcpjsonServers", "disabledMcpjsonServers", "dontCrawlDirectory"]
slots = sorted(glob.glob(os.path.join(root, "*/")))
if not slots:
    print("no claude slots yet"); sys.exit(0)
for slot_dir in slots:
    slot_path = os.path.join(slot_dir, ".claude.json")
    slot = {}
    if os.path.exists(slot_path):
        try:
            slot = json.load(open(slot_path))
        except Exception as exc:
            print(f"{os.path.basename(slot_dir.rstrip('/'))}: SKIPPED — unreadable .claude.json ({exc})")
            continue
    # Union, not replace: a server added inside a slot must survive a sync.
    merged = dict(slot.get("mcpServers") or {})
    merged.update(mcp)
    slot["mcpServers"] = merged
    for flag in GLOBAL_FLAGS:
        if flag in primary:
            slot[flag] = primary[flag]
    slot_projects = slot.setdefault("projects", {})
    trusted = 0
    for path, entry in projects.items():
        if not entry.get("hasTrustDialogAccepted"):
            continue
        trusted += 1
        tgt = slot_projects.setdefault(path, {})
        for field in PROJECT_FIELDS:
            if field in entry:
                tgt[field] = entry[field]
    tmp = slot_path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(slot, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, slot_path)
    print(f"{os.path.basename(slot_dir.rstrip('/'))}: {len(mcp)} MCP servers, {trusted} trusted projects")
# settings.json + custom output styles: preferences, never credentials
import shutil
src_settings = os.path.expanduser("~/.claude/settings.json")
src_styles = os.path.expanduser("~/.claude/output-styles")
if os.path.exists(src_settings):
    try:
        base = json.load(open(src_settings))
    except Exception:
        base = {}
    for slot_dir in slots:
        target = os.path.join(slot_dir, "settings.json")
        cur = {}
        if os.path.exists(target):
            try:
                cur = json.load(open(target))
            except Exception:
                cur = {}
        for k in SETTINGS_KEYS:
            if k in base:
                cur[k] = base[k]
        json.dump(cur, open(target, "w"), indent=2)
    print(f"settings synced ({', '.join(k for k in SETTINGS_KEYS if k in base)})")
if os.path.isdir(src_styles):
    for slot_dir in slots:
        dest = os.path.join(slot_dir, "output-styles")
        os.makedirs(dest, exist_ok=True)
        for f in os.listdir(src_styles):
            if f.endswith(".md"):
                shutil.copy(os.path.join(src_styles, f), os.path.join(dest, f))
    print("output styles synced")
print("==> synced definitions only; OAuth tokens are per-slot and never copied.")
PY
}

cmd_doctor() {
  local p ok=0
  command -v python3 >/dev/null || { echo "[!] python3 not found (required)"; ok=1; }
  command -v node >/dev/null || { echo "[!] node not found (required by the AgentLink ACP provider)"; ok=1; }
  for p in $PROVIDERS; do
    if command -v "$p" >/dev/null; then
      echo "[x] $p binary: $(command -v "$p")"
    else
      echo "[ ] $p binary not found (only needed if you manage $p accounts)"
    fi
  done
  if command -v claude >/dev/null && ! claude auth login --help >/dev/null 2>&1; then
    echo "[!] this Claude Code version predates 'claude auth login' — logins will open"
    echo "    the full REPL instead. Update with: claude update"
    ok=1
  fi
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    echo "[!] CLAUDE_CONFIG_DIR is set globally in this shell ($CLAUDE_CONFIG_DIR)."
    echo "    That re-points your PRIMARY claude. agent-link never needs this set globally."
    ok=1
  fi
  for d in "$ACCOUNTS/codex"/*/; do
    [ -d "$d" ] || continue
    grep -q '^cli_auth_credentials_store *= *"file"' "$d/config.toml" 2>/dev/null \
      || { echo "[!] $(basename "$d"): codex slot missing cli_auth_credentials_store=\"file\" pin"; ok=1; }
  done
  if [ -x "$SHIM_BIN/agent-link-acp" ]; then
    echo "[x] AgentLink ACP runtime: $SHIM_BIN/agent-link-acp"
  else
    echo "[!] AgentLink ACP runtime missing — run: agent-link auto"
    ok=1
  fi
  cmd_route status
  [ "$ok" = 0 ] && echo "All good."
  return "$ok"
}

cmd_interactive() {
  local choice p e n warn parked blocked
  while :; do
    printf '\n  %sagent-link %s%s   %s%s%s\n' "$C_BOLD" "$VERSION" "$C_OFF" "$C_DIM" "$ROOT" "$C_OFF"
    cmd_status
    # A single line that says whether anything needs you.
    warn=""
    parked=$(ls "$(pools_dir)"/cooldown-* 2>/dev/null | wc -l | tr -d ' ')
    blocked=$(for pr in $PROVIDERS; do for em in $(slot_list "$pr"); do
      prov_logged_in "$pr" "$(slot_dir "$pr" "$em")" || echo x; done; done | wc -l | tr -d ' ')
    [ "$parked" != 0 ] && warn="$warn${warn:+ · }$parked parked"
    [ "$blocked" != 0 ] && warn="$warn${warn:+ · }$blocked need sign-in"
    if [ -n "$warn" ]; then
      printf '\n  %s! %s%s  %sopen Accounts in Paseo to repair sign-ins%s\n' "$C_YELLOW" "$warn" "$C_OFF" "$C_DIM" "$C_OFF"
    else
      printf '\n  %s✓ every account is signed in and in rotation%s\n' "$C_GREEN" "$C_OFF"
    fi
    echo
    printf '  %sd%s install AgentLink   %sa%s add   %sl%s log in   %sr%s remove\n' \
      "$C_CYAN" "$C_OFF" "$C_BOLD" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF"
    printf '  %su%s pin   %ss%s shims   %sp%s park   %sk%s unpark   %st%s test model\n' \
      "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF"
    printf '  %si%s insights   %sw%s whoami   %sy%s sync   %sg%s apps   %s?%s doctor   %sq%s quit\n' \
      "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF" "$C_CYAN" "$C_OFF"
    printf '  %s> %s' "$C_CYAN" "$C_OFF"
    # Single keypress when we have a terminal; fall back to a line otherwise.
    if [ -t 0 ]; then read -r -n 1 choice; echo; else read -r choice || return 0; fi
    case "$choice" in
      a|A)
        printf '  provider (claude/codex): '; read -r p
        printf '  account email: '; read -r e
        cmd_add "$p" "$e" || true
        ;;
      l|L) cmd_login all || true ;;
      r|R)
        printf '  provider (claude/codex): '; read -r p
        printf '  account email: '; read -r e
        cmd_remove "$p" "$e" || true
        ;;
      d|D) cmd_auto ;;
      u|U)
        printf '  provider (claude/codex): '; read -r p
        printf '  pin plain command to (email, number, or "primary"): '; read -r n
        cmd_use "$p" "$n" || true
        ;;
      s|S) cmd_shims ;;
      p|P)
        printf '  provider (claude/codex): '; read -r p
        printf '  account email (or "primary"): '; read -r e
        printf '  minutes [180]: '; read -r n
        cmd_cooldown "$p" "$e" "${n:-180}" || true
        ;;
      k|K)
        printf '  provider (claude/codex): '; read -r p
        printf '  account email (or "primary"): '; read -r e
        cmd_cooldown "$p" "$e" clear || true
        ;;
      t|T)
        printf '  model [claude-fable-5]: '; read -r n
        printf '  park the ones that refuse? [y/N] '; read -r e
        case "$e" in y|Y) cmd_probe claude "${n:-claude-fable-5}" --park || true ;; *) cmd_probe claude "${n:-claude-fable-5}" || true ;; esac
        ;;
      i|I)
        printf '  days [7]: '; read -r n
        cmd_insights "${n:-7}" || true
        ;;
      w|W) cmd_whoami || true ;;
      y|Y) cmd_sync || true ;;
      g|G)
        echo; cmd_app list
        printf '  install/remove which? [id, or enter to skip] '; read -r n
        if [ -n "$n" ]; then
          printf '  (i)nstall or (r)emove? [i] '; read -r e
          case "$e" in r|R) cmd_app remove "$n" || true ;; *) cmd_app install "$n" || true ;; esac
        fi
        ;;
      '?'|h|H) cmd_doctor || true ;;
      q|Q) return 0 ;;
      "") ;;
      *) printf '  %sunknown key: %s%s\n' "$C_DIM" "$choice" "$C_OFF" ;;
    esac
  done
}

usage() {
