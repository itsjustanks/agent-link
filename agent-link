#!/usr/bin/env bash
# agent-link — Paseo front-end for 9router.
#
# 9router (npm i -g 9router) owns your Claude Code / Codex accounts, OAuth,
# quotas, rotation and fallback, and rewrites each CLI's own config so every
# launch of that binary routes through it — Paseo's native providers included.
# agent-link lists 9router's models on those providers and gives you a small
# CLI to start/inspect 9router from a terminal.
#
# Requires: bash, python3, curl, 9router, paseo.
set -u

VERSION="0.9.0"
REPO="itsjustanks/paseo-plugin-9router"
RAW="https://raw.githubusercontent.com/$REPO/main"

# ROOT — prefer whichever location actually holds accounts (older installs
# keep working under ~/.agent-auth).
has_accounts() { [ -n "$(ls -A "$1/accounts/claude" "$1/accounts/codex" 2>/dev/null)" ]; }
if [ -n "${AGENT_LINK_HOME:-}" ]; then ROOT="$AGENT_LINK_HOME"
elif [ -n "${AGENT_AUTH_HOME:-}" ]; then ROOT="$AGENT_AUTH_HOME"
elif has_accounts "$HOME/.agent-link"; then ROOT="$HOME/.agent-link"
elif has_accounts "$HOME/.agent-auth"; then ROOT="$HOME/.agent-auth"
elif [ -d "$HOME/.agent-link" ]; then ROOT="$HOME/.agent-link"
elif [ -d "$HOME/.agent-auth" ]; then ROOT="$HOME/.agent-auth"
else ROOT="$HOME/.agent-link"
fi
BIN="$ROOT/bin"
SETTINGS="$ROOT/9router.json"
PASEO_CONFIG="$HOME/.paseo/config.json"
LEGACY_PROVIDERS="agent-link claude-auto codex-auto agent-router"
LEGACY_SHIMS="agent-link-acp claude-auto codex-auto agent-router codex-app-server-proxy claude codex claude-quota-statusline"
HERE="$(cd "$(dirname "$0")" && pwd)"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_OFF=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'
else C_OFF=""; C_BOLD=""; C_DIM=""; C_GREEN=""; C_YELLOW=""; C_RED=""; fi
ok()   { printf '  %s●%s %s\n' "$C_GREEN" "$C_OFF" "$*"; }
warn() { printf '  %s○%s %s\n' "$C_YELLOW" "$C_OFF" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$C_RED" "$C_OFF" "$*"; }
die()  { echo "$*" >&2; exit 1; }

# ---------------------------------------------------------------- settings (ROOT/9router.json)

setting() { # $1 key -> value or ""
  python3 - "$SETTINGS" "$1" <<'PY' 2>/dev/null
import json, sys
try: print(json.load(open(sys.argv[1])).get(sys.argv[2]) or "")
except Exception: print("")
PY
}
r_url()  { local u="${AGENT_LINK_9ROUTER_URL:-$(setting url)}"; echo "${u:-http://127.0.0.1:20128}"; }
r_key()  { echo "${AGENT_LINK_9ROUTER_KEY:-$(setting apiKey)}"; }
r_port() { local u; u="$(r_url)"; u="${u##*:}"; echo "${u%%/*}"; }
last4()  { [ -n "$1" ] && echo "…${1: -4}" || echo "none"; }

settings_set() { # key value — atomic write, mode 0600
  python3 - "$SETTINGS" "$1" "$2" <<'PY'
import json, os, sys, tempfile
path, key, value = sys.argv[1:4]
try: data = json.load(open(path))
except Exception: data = {}
data[key] = value
os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
fd, tmp = tempfile.mkstemp(prefix=".9router-", dir=os.path.dirname(path))
with os.fdopen(fd, "w") as h: json.dump(data, h, indent=2); h.write("\n")
os.chmod(tmp, 0o600); os.replace(tmp, path)
PY
}

# ---------------------------------------------------------------- 9router HTTP

r_get()  { curl -fsS -m 5 "$(r_url)$1" 2>/dev/null; }
r_json() { python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
for k in sys.argv[1].split("."):
    d = d[int(k)] if isinstance(d, list) else d.get(k)
    if d is None: sys.exit(1)
print(len(d) if isinstance(d, list) else d)' "$1"; }
r_running() { [ "$(r_get /api/health | r_json ok 2>/dev/null)" = True ]; }

COOKIES=""
r_login() { # management API session; needs `password` in settings
  [ -n "$COOKIES" ] && return 0
  local pw; pw="$(setting password)"
  [ -n "$pw" ] || return 1
  COOKIES="$(mktemp "${TMPDIR:-/tmp}/agent-link-cookies.XXXXXX")"; trap 'rm -f "$COOKIES"' EXIT
  curl -fsS -m 5 -c "$COOKIES" -o /dev/null -H 'content-type: application/json' \
    -d "{\"password\":$(python3 -c 'import json,sys;print(json.dumps(sys.argv[1]))' "$pw")}" \
    "$(r_url)/api/auth/login" 2>/dev/null || { rm -f "$COOKIES"; COOKIES=""; return 1; }
}
r_mget()  { r_login && curl -fsS -m 5 -b "$COOKIES" "$(r_url)$1" 2>/dev/null; }
r_mpost() { r_login && curl -fsS -m 5 -b "$COOKIES" -H 'content-type: application/json' -d "$2" "$(r_url)$1" 2>/dev/null; }

# ---------------------------------------------------------------- 9router commands

router_start() {
  command -v 9router >/dev/null || die "9router is not installed. Install it with: npm i -g 9router"
  r_running && { ok "9router already running at $(r_url)"; return 0; }
  echo "starting 9router on 127.0.0.1:$(r_port)…"
  nohup 9router --no-browser --skip-update --host 127.0.0.1 --port "$(r_port)" >/dev/null 2>&1 </dev/null &
  disown 2>/dev/null || true
  local i; for i in $(seq 1 40); do r_running && { ok "9router is up at $(r_url)  (dashboard: same URL)"; return 0; }; sleep 0.5; done
  die "9router did not answer within 20 s — run '9router' in a terminal to see its log"
}

router_stop() {
  local pids; pids="$(lsof -nP -iTCP:"$(r_port)" -sTCP:LISTEN -t 2>/dev/null | sort -u)"
  [ -n "$pids" ] || { warn "nothing is listening on port $(r_port)"; return 0; }
  kill $pids 2>/dev/null
  local i; for i in $(seq 1 20); do r_running || { ok "9router stopped"; return 0; }; sleep 0.5; done
  kill -9 $pids 2>/dev/null; ok "9router killed"
}

router_key() { # ensure ROOT/9router.json holds a key: reuse the first active one, else mint "AgentLink"
  r_running || die "9router is not running at $(r_url). Start it with: agent-link 9router start"
  r_login || die "cannot log in to the 9router management API — set \"password\" in $SETTINGS"
  local key; key="$(r_mget /api/keys | python3 -c 'import json,sys
keys=[k for k in json.load(sys.stdin).get("keys",[]) if k.get("isActive", True) and k.get("key")]
print(keys[0]["key"] if keys else "")')"
  if [ -z "$key" ]; then
    key="$(r_mpost /api/keys '{"name":"AgentLink"}' | r_json key)" || die "could not create an API key"
    echo "minted 9router API key \"AgentLink\""
  fi
  settings_set apiKey "$key"
  ok "API key saved to $SETTINGS ($(last4 "$key"))"
}

router_status() {
  local bin ver
  bin="$(command -v 9router 2>/dev/null || true)"
  if [ -n "$bin" ]; then ok "9router binary: $bin ($(9router --version 2>/dev/null | head -1 || echo '?'))"
  else bad "9router not installed — npm i -g 9router"; fi
  if r_running; then
    ver="$(r_get /api/version)"
    ok "running at $(r_url) · v$(echo "$ver" | r_json currentVersion)$( [ "$(echo "$ver" | r_json hasUpdate)" = True ] && echo " (update available: $(echo "$ver" | r_json latestVersion))")"
    if [ -n "$(setting password)" ]; then
      local n; n="$(r_mget /api/providers | r_json connections 2>/dev/null)"
      if [ -n "$n" ]; then
        ok "management API: ok · $n connected account(s)"
        r_mget /api/providers | python3 -c 'import json,sys
for c in json.load(sys.stdin).get("connections", []):
    who = c.get("name") or c.get("email") or c.get("id"); state = "active" if c.get("isActive", True) else "inactive"
    print("      %-8s %s  priority %s  %s  %s" % (c.get("provider","?"), who, c.get("priority","-"), state, c.get("testStatus") or ""))'
      else bad "management API login failed (check \"password\" in $SETTINGS)"; fi
    else warn "no \"password\" in $SETTINGS — account details need the management API"; fi
    ok "models: $(r_get /v1/models | r_json data 2>/dev/null || echo '?') via /v1/models"
  else bad "not running at $(r_url) — agent-link 9router start"; fi
  ok "API key: $(last4 "$(r_key)")"
}

cmd_9router() {
  case "${1:-status}" in
    start) router_start ;; stop) router_stop ;; status) router_status ;; key) router_key ;;
    *) die "usage: agent-link 9router start|stop|status|key" ;;
  esac
}

# ---------------------------------------------------------------- Paseo wiring

# How many 9router models Paseo's own claude/codex providers currently offer.
models_listed() {
  python3 - "$PASEO_CONFIG" <<'PY' 2>/dev/null
import json, sys
try: config = json.load(open(sys.argv[1]))
except Exception: print("0 0"); sys.exit(0)
providers = config.get("providers") or config.get("agents", {}).get("providers", {})
entry = providers.get("ninerouter") or {}
models = entry.get("models") or []
print(f"{len(models)} {sum(1 for m in models if isinstance(m, dict) and str(m.get('id', '')).startswith(('cc/', 'cx/')))}")
PY
}
# Does 9router currently own this CLI's config? 9router answers for itself.
cli_routed() { # $1 claude|codex
  curl -fsS -m 5 "$(r_url)/api/cli-tools/$1-settings" 2>/dev/null \
    | python3 -c 'import json,sys
try: sys.exit(0 if json.load(sys.stdin).get("has9Router") else 1)
except Exception: sys.exit(1)'
}

legacy_providers_present() {
  python3 - "$PASEO_CONFIG" $LEGACY_PROVIDERS <<'PY' 2>/dev/null
import json, sys
p = json.load(open(sys.argv[1])).get("agents", {}).get("providers", {})
print(" ".join(k for k in sys.argv[2:] if k in p))
PY
}
legacy_shims_present() {
  local f out=""
  for f in $LEGACY_SHIMS "$BIN"/claude-[0-9]* "$BIN"/codex-[0-9]*; do
    [ -e "$BIN/${f##*/}" ] && out="$out ${f##*/}"
  done
  echo "${out# }"
}

# Ask 9router which models it serves, then list them on Paseo's own claude and
# codex providers so they appear in an ordinary chat's model picker. Dead
# provider entries from the pre-9router design are removed in the same write.
sync_models() {
  [ -f "$PASEO_CONFIG" ] || { warn "no $PASEO_CONFIG — is Paseo installed?"; return 0; }
  local ids
  ids="$(curl -fsS -m 10 -H "Authorization: Bearer $(r_key)" "$(r_url)/v1/models" 2>/dev/null \
    | python3 -c 'import json,sys
try: print(" ".join(m["id"] for m in json.load(sys.stdin).get("data", []) if isinstance(m.get("id"), str)))
except Exception: print("")')"
  [ -n "$ids" ] || { bad "9router returned no models — is it running and signed in?"; return 1; }

  local result
  result="$(python3 - "$PASEO_CONFIG" "$ids" "$(r_url)" "$(r_key)" $LEGACY_PROVIDERS <<'PY'
import json, os, shutil, sys, tempfile, time
path, ids, url, key, legacy = sys.argv[1], sys.argv[2].split(), sys.argv[3], sys.argv[4], sys.argv[5:]
try:
    config = json.load(open(path, encoding="utf-8"))
except Exception as error:
    print(f"error:{error}")
    sys.exit(0)

def label(model_id):
    bare = model_id.split("/", 1)[-1].replace("-", " ").replace("_", " ")
    pretty = " ".join(word.upper() if word.lower() == "gpt" else word.capitalize() for word in bare.split())
    return "9Router \u00b7 " + pretty

providers = config.setdefault("agents", {}).setdefault("providers", {})
cc = [{"id": i, "label": label(i)} for i in ids if i.startswith("cc/")]
cx = [{"id": i, "label": label(i)} for i in ids if i.startswith("cx/")]
every = [{"id": i, "label": label(i)} for i in ids]
# One provider carries the whole catalogue: 9router translates every pool into
# the Claude wire format, so splitting by pool would only mirror its internals.
# Paseo rejects a provider id starting with a digit, so the id cannot be
# "9router"; the label carries the branding.
desired = {"ninerouter": {"extends": "claude", "label": "9Router",
                          "description": "Every model your local 9router serves",
                          "env": {"ANTHROPIC_BASE_URL": url, "ANTHROPIC_AUTH_TOKEN": key},
                          "models": every}}
changed = False
for pid, value in desired.items():
    if providers.get(pid) != value:
        providers[pid] = value
        changed = True
if providers.pop("ninerouter-codex", None) is not None:
    changed = True
# Keep the models on the stock providers too: emptying that list breaks any
# existing chat pinned to one of them.
for stock, models in (("claude", cc), ("codex", cx)):
    entry = providers.setdefault(stock, {})
    if isinstance(entry, dict) and entry.get("additionalModels") != models:
        entry["additionalModels"] = models
        changed = True
removed = [k for k in legacy if providers.pop(k, None) is not None]
if removed:
    changed = True
if not changed:
    print("unchanged " + str(len(every)) + " " + str(len(cc)))
    sys.exit(0)
shutil.copy2(path, path + ".bak-agent-link-" + str(int(time.time())))
mode = os.stat(path).st_mode & 0o777
fd, tmp = tempfile.mkstemp(prefix=".agent-link-config-", dir=os.path.dirname(path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(config, handle, indent=2)
        handle.write("\n")
    os.chmod(tmp, mode)
    os.replace(tmp, path)
finally:
    if os.path.exists(tmp):
        os.unlink(tmp)
print("changed " + str(len(every)) + " " + str(len(cc)) + " " + " ".join(removed))
PY
)"
  case "$result" in
    error:*) echo "could not update Paseo config: ${result#error:}" >&2; return 1 ;;
    unchanged*) set -- $result; ok "9Router provider already offers $2 models" ;;
    changed*) set -- $result; ok "9Router provider now offers $2 models${4:+ · removed: ${*:4}}" ;;
  esac
}

# Point a CLI at 9router (or restore it) using 9router's own endpoint, so the
# rewrite of ~/.claude/settings.json or ~/.codex/config.toml stays its job.
route_cli() { # $1 claude|codex, $2 on|off
  local cli="$1" mode="$2" url key body
  url="$(r_url)"; key="$(r_key)"
  [ -n "$key" ] || { bad "no API key — agent-link 9router key"; return 1; }
  if [ "$mode" = off ]; then
    curl -fsS -m 10 -X DELETE "$url/api/cli-tools/$cli-settings" >/dev/null 2>&1 \
      && ok "$cli restored to its direct connection" || { bad "could not restore $cli"; return 1; }
    return 0
  fi
  if [ "$cli" = claude ]; then
    body="$(python3 -c 'import json,sys; print(json.dumps({"env": {"ANTHROPIC_BASE_URL": sys.argv[1], "ANTHROPIC_AUTH_TOKEN": sys.argv[2]}}))' "$url" "$key")"
  else
    body="$(python3 -c 'import json,sys; print(json.dumps({"baseUrl": sys.argv[1] + "/v1", "apiKey": sys.argv[2]}))' "$url" "$key")"
  fi
  curl -fsS -m 10 -X POST -H 'content-type: application/json' -d "$body" "$url/api/cli-tools/$cli-settings" >/dev/null 2>&1 \
    && ok "$cli now runs through 9router" || { bad "could not route $cli"; return 1; }
}

remove_legacy_shims() {
  local f gone=""
  for f in $(legacy_shims_present); do rm -f "$BIN/$f" && gone="$gone $f"; done
  [ -n "$gone" ] && ok "removed legacy launchers:$gone"
  return 0
}

cmd_auto() {
  [ -f "$SETTINGS" ] || warn "no $SETTINGS yet — run 'agent-link 9router key' first"
  r_running || die "9router is not running at $(r_url) — agent-link 9router start"
  sync_models || exit 1
  remove_legacy_shims
  if command -v paseo >/dev/null; then
    paseo reload >/dev/null 2>&1 && ok "paseo reload done" || warn "paseo reload failed — restart Paseo to pick up the models"
  else warn "paseo CLI not found — restart Paseo to pick up the models"; fi
  echo
  echo "  Route a CLI through 9router with: agent-link route claude on"
  echo "  Then pick a 9router model in any Paseo chat."
}

cmd_route() { # claude|codex on|off
  case "${1:-}" in claude|codex) ;; *) die "usage: agent-link route claude|codex on|off" ;; esac
  case "${2:-}" in on|off) ;; *) die "usage: agent-link route claude|codex on|off" ;; esac
  r_running || die "9router is not running at $(r_url) — agent-link 9router start"
  route_cli "$1" "$2"
}

# ---------------------------------------------------------------- status / doctor

cmd_status() {
  printf '  %sagent-link %s%s   %s%s%s\n' "$C_BOLD" "$VERSION" "$C_OFF" "$C_DIM" "$ROOT" "$C_OFF"
  router_status
  local counts; counts="$(models_listed)"; set -- $counts
  if [ "${1:-0}" != 0 ]; then ok "9Router provider offers $1 models ($2 from your Claude/Codex accounts)"
  else bad "no 9Router provider in Paseo — agent-link auto"; fi
  cli_routed claude && ok "Claude Code routes through 9router" || warn "Claude Code is direct — agent-link route claude on"
  cli_routed codex && ok "Codex routes through 9router" || warn "Codex is direct — agent-link route codex on"
  local l; l="$(legacy_providers_present)"; [ -n "$l" ] && warn "legacy Paseo providers still present: $l (agent-link auto removes them)"
  l="$(legacy_shims_present)"; [ -n "$l" ] && warn "legacy launchers in $BIN: $l (agent-link auto removes them)"
  return 0
}

cmd_doctor() {
  local rc=0 t
  for t in python3 curl; do command -v "$t" >/dev/null && ok "$t: $(command -v "$t")" || { bad "$t not found (required)"; rc=1; }; done
  command -v 9router >/dev/null && ok "9router: $(command -v 9router)" || { bad "9router not installed — npm i -g 9router"; rc=1; }
  command -v paseo >/dev/null && ok "paseo: $(command -v paseo)" || { warn "paseo CLI not found — the Paseo provider cannot be reloaded"; }
  for t in claude codex; do command -v "$t" >/dev/null && ok "$t: $(command -v "$t")" || warn "$t CLI not found — its 9router models will fail to start"; done
  if [ -f "$SETTINGS" ]; then
    [ "$(stat -f '%Lp' "$SETTINGS" 2>/dev/null || stat -c '%a' "$SETTINGS")" = 600 ] && ok "$SETTINGS (mode 600)" || { warn "$SETTINGS is not mode 600 — chmod 600 it"; }
    [ -n "$(r_key)" ] || { warn "no apiKey in $SETTINGS — agent-link 9router key"; }
  else bad "$SETTINGS missing — agent-link 9router key"; rc=1; fi
  r_running && ok "9router answering at $(r_url)" || { bad "9router not running at $(r_url)"; rc=1; }
  local counts; counts="$(models_listed)"; set -- $counts
  if [ "${1:-0}" != 0 ]; then ok "9Router provider offers $1 models"
  else bad "no 9Router provider in Paseo — agent-link auto"; rc=1; fi
  [ -n "${ANTHROPIC_API_KEY:-}" ] && warn "ANTHROPIC_API_KEY is set in this shell; it overrides the 9router token for Claude Code"
  [ "$rc" = 0 ] && echo "  All good."
  return "$rc"
}

# ---------------------------------------------------------------- Paseo plugin (app)

app_field() { python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get(sys.argv[2], "") or "")
except Exception: print("")' "$1/app.json" "$2"; }
paseo_home() {
  local h; h="$(paseo daemon status --json 2>/dev/null | python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: d={}
print(d.get("home") or d.get("daemon",{}).get("home") or "")' 2>/dev/null)"
  [ -n "$h" ] && [ -d "$h" ] && echo "$h" || echo "$HOME/.paseo"
}
paseo_plugin_row() { # $1 id, $2 field (path|status|enabled)
  paseo plugin ls --json 2>/dev/null | python3 -c 'import json,sys
try: rows=json.load(sys.stdin)
except Exception: rows=[]
print(next((str(r.get(sys.argv[2]) or "") for r in rows if isinstance(r, dict) and r.get("id")==sys.argv[1]), ""))' "$1" "$2"
}
apps_dir() { # the apps/ directory of a checkout next to this script, else the managed clone
  local d; for d in "$HERE/apps" "$HERE/../apps" "$ROOT/src/apps"; do [ -d "$d" ] && { echo "$d"; return 0; }; done
  command -v git >/dev/null || return 1
  echo "fetching $REPO into $ROOT/src…" >&2
  git clone --depth 1 -q "https://github.com/$REPO.git" "$ROOT/src" >&2 && [ -d "$ROOT/src/apps" ] && echo "$ROOT/src/apps"
}

install_paseo_plugin() { # $1 source dir, $2 plugin id, $3 copy|link
  local src="$1" pid="$2" mode="$3" dest status
  command -v paseo >/dev/null || die "Paseo is not installed — get it at https://paseo.sh"
  [ "$(python3 -c 'import json,sys
try: print("yes" if json.load(open(sys.argv[1])).get("pluginsEnabled") else "no")
except Exception: print("no")' "$(paseo_home)/config.json")" = yes ] || die "Paseo has plugins switched off. Turn them on in Paseo → Settings → Plugins, then rerun."
  # Paseo 0.7+ manages Git installs and updates itself; --link runs from this checkout.
  if [ "$mode" != link ] && paseo plugin add --help 2>&1 | grep -q -- '--path <path>'; then
    if [ "$(paseo plugin status "$pid" --json 2>/dev/null | python3 -c 'import json,sys
v=json.load(sys.stdin); v=v if isinstance(v,list) else [v]
print(next((r.get("source") or "" for r in v if isinstance(r,dict) and r.get("id")==sys.argv[1]), ""))' "$pid" 2>/dev/null)" = git ]; then
      echo "checking the Git-managed plugin for updates…"; paseo plugin update "$pid" >/dev/null || return 1
    else
      paseo plugin ls 2>/dev/null | grep -q "^$pid " && paseo plugin remove "$pid" >/dev/null 2>&1
      echo "installing from Git with Paseo-managed updates…"
      paseo plugin add "$REPO" --path apps/paseo --id "$pid" >/dev/null || die "Git install failed — see: paseo plugin logs $pid"
    fi
  else
    command -v npm >/dev/null || die "Node.js (npm) is needed to build the plugin"
    if [ "$mode" = link ]; then dest="$src"; else
      dest="$(paseo_home)/plugins/$pid"; echo "installing into $dest…"; mkdir -p "$dest" || return 1
      ( cd "$src" && tar --exclude=node_modules --exclude=.git -cf - . ) | ( cd "$dest" && tar -xf - ) || return 1
    fi
    [ -d "$dest/node_modules" ] || { echo "installing dependencies…"; (cd "$dest" && npm install --silent --no-audit --no-fund) || return 1; }
    (cd "$dest" && npm run --silent typecheck) || die "plugin failed to typecheck — not installing"
    paseo plugin ls 2>/dev/null | grep -q "^$pid " && paseo plugin remove "$pid" >/dev/null 2>&1
    paseo plugin install "$dest" --id "$pid" >/dev/null || return 1
  fi
  status="$(paseo_plugin_row "$pid" status)"
  case "$status" in
    running) ok "plugin $pid installed and running. Open Paseo → AgentLink." ;;
    "")      warn "installed, but Paseo does not list it yet — check: paseo plugin ls" ;;
    *)       bad "installed but $status — check: paseo plugin logs $pid"; return 1 ;;
  esac
}

cmd_app() { # install|status|remove paseo [--link]
  local action="${1:-status}" id="${2:-paseo}" mode=copy base d pid dest
  case "${3:-}" in --link|--dev) mode=link ;; esac
  [ "$id" = paseo ] || die "the only app is 'paseo': agent-link app $action paseo"
  base="$(apps_dir)" || die "no apps/ directory found and could not fetch it"
  d="$base/$id"; [ -f "$d/app.json" ] || die "apps/$id is missing app.json"
  pid="$(app_field "$d" pluginId)"
  case "$action" in
    status|list)
      command -v paseo >/dev/null || { warn "paseo: Paseo is not installed on this machine"; return 0; }
      case "$(paseo_plugin_row "$pid" status)" in
        "") warn "$pid: not installed — agent-link app install paseo" ;;
        *)  ok "$pid: $(paseo_plugin_row "$pid" status) (enabled: $(paseo_plugin_row "$pid" enabled)) · $(paseo_plugin_row "$pid" path)" ;;
      esac ;;
    install) install_paseo_plugin "$d" "$pid" "$mode" ;;
    remove)
      command -v paseo >/dev/null || die "Paseo is not installed here."
      paseo plugin remove "$pid" >/dev/null 2>&1
      dest="$(paseo_home)/plugins/$pid"
      [ -d "$dest" ] && [ "$dest" != "$d" ] && rm -rf "$dest"   # never delete a --link source
      ok "removed. The source in apps/$id is untouched." ;;
    *) die "usage: agent-link app install|status|remove paseo [--link]" ;;
  esac
}

# ---------------------------------------------------------------- help / main

usage() {
  cat <<EOF
agent-link $VERSION — Paseo front-end for 9router      ($ROOT)

  agent-link auto                       list 9router's models on Paseo's claude/codex providers
                                        (plus legacy cleanup and paseo reload)
  agent-link route claude|codex on|off  send that CLI through 9router, or restore it
  agent-link status                     9router + Paseo wiring at a glance
  agent-link 9router start|stop|status  run the local 9router server (127.0.0.1:$(r_port))
  agent-link 9router key                reuse or mint a 9router API key into $SETTINGS
  agent-link app install|status|remove paseo [--link]
                                        the 9Router Agent Link Paseo plugin (--link uses this checkout)
  agent-link doctor                     check prerequisites and wiring
  agent-link --version

Settings: $SETTINGS  {"url","apiKey","password"}  · env AGENT_LINK_9ROUTER_URL / AGENT_LINK_9ROUTER_KEY
Accounts, quotas and fallback live in the 9router dashboard: $(r_url)
EOF
}

main() {
  case "${1:-}" in
    ""|status) cmd_status ;;
    auto)      cmd_auto ;;
    route)     shift; cmd_route "$@" ;;
    9router)   shift; cmd_9router "$@" ;;
    app)       shift; cmd_app "$@" ;;
    doctor)    cmd_doctor ;;
    version|--version|-v) echo "$VERSION" ;;
    help|--help|-h) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}
main "$@"
