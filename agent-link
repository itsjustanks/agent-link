refresh_paseo_provider_catalog() {
  local config="$HOME/.paseo/config.json" target="$ROOT/state/acp/paseo-provider-catalog.json" paseo_bin=""
  [ -f "$config" ] || return 0
  paseo_bin="$(command -v paseo 2>/dev/null || true)"
  [ -n "$paseo_bin" ] || return 0
  python3 - "$config" "$target" "$paseo_bin" <<'PY2'
import json, os, subprocess, sys, tempfile

config_path, target, paseo = sys.argv[1:4]
try:
    config = json.load(open(config_path, encoding="utf-8"))
except Exception:
    sys.exit(0)
configured = config.get("agents", {}).get("providers", {})
try:
    previous = json.load(open(target, encoding="utf-8")).get("providers", {})
except Exception:
    previous = {}
providers = {}
for provider_id, value in configured.items():
    if not isinstance(value, dict) or value.get("extends") != "acp" or value.get("enabled") is False or provider_id == "agent-link":
        continue
    command = value.get("command")
    if not isinstance(command, list) or not command or os.path.basename(str(command[0])).startswith("agent-link-acp"):
        continue
    try:
        result = subprocess.run(
            [paseo, "provider", "models", provider_id, "--json"],
            check=True,
            capture_output=True,
            text=True,
            timeout=15,
        )
        rows = json.loads(result.stdout)
        models = []
        for row in rows if isinstance(rows, list) else []:
            model_id = row.get("id") if isinstance(row, dict) else None
            if not isinstance(model_id, str) or not model_id:
                continue
            models.append({
                "id": model_id,
                "name": row.get("model") if isinstance(row.get("model"), str) else model_id,
                "description": row.get("description") if isinstance(row.get("description"), str) else "",
            })
        if models:
            providers[provider_id] = {"label": value.get("label") or provider_id, "models": models}
            continue
    except Exception:
        pass
    if provider_id in previous:
        providers[provider_id] = previous[provider_id]

payload = {"version": 1, "providers": providers}
os.makedirs(os.path.dirname(target), mode=0o700, exist_ok=True)
fd, temporary = tempfile.mkstemp(prefix=".paseo-provider-catalog-", dir=os.path.dirname(target))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2)
        handle.write("\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, target)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
print(f"cached {sum(len(entry.get('models', [])) for entry in providers.values())} Paseo provider models")
PY2
}

write_auto_launcher() { # $1 provider — one command that routes to a live account
  local p="$1" env_var self primary_search cont_flags app_server_proxy_block=""
  # Continue-style flags differ by CLI — and clash: codex uses -c for a CONFIG
  # override, so treating it as "continue" would reroute a fresh launch.
  case "$p" in
    claude) cont_flags='-c|--continue' ;;
    *)      cont_flags='--last' ;;
  esac
  local trust_block=""
  [ "$p" = claude ] && trust_block="$(claude_trust_block)"
  if [ "$p" = codex ]; then
    app_server_proxy_block='if [ "${1:-}" = app-server ] && [ -x "$here/codex-app-server-proxy" ]; then
  exec "$here/codex-app-server-proxy" "$real" "$@"
fi'
  fi
  primary_search="$(primary_dir "$1")"
  env_var="$(prov_env_var "$p")"
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  mkdir -p "$SHIM_BIN"
  cat > "$SHIM_BIN/$p-auto" <<EOF
#!/usr/bin/env bash
# agent-link auto-routing launcher for $p — managed by \`agent-link auto\`.
# Picks a logged-in, non-cooled-down account at launch and execs the real CLI.
# Point one editor/orchestrator provider at this file instead of picking
# accounts by hand. Running processes are never re-routed.
here="\$(cd "\$(dirname "\$0")" && pwd)"
aa_root="\${AGENT_LINK_HOME:-\${AGENT_AUTH_HOME:-$ROOT}}"
real=""
old_ifs="\$IFS"; IFS=:
for d in \$PATH; do
  [ -n "\$d" ] || continue
  [ "\$d" = "\$here" ] && continue
  if [ -x "\$d/$p" ] && [ ! "\$d/$p" -ef "\$here/$p" ]; then real="\$d/$p"; break; fi
done
IFS="\$old_ifs"
[ -n "\$real" ] || real="$(command -v "$p" 2>/dev/null || echo "$p")"
# A resumed session only exists in the account that created it, so routing a
# resume elsewhere fails with "No conversation found with session ID". Detect a
# session id in the args and pin to the account that owns it.
aa_sid=""
aa_cont=""
aa_prev=""
aa_model=""
for aa_a in "\$@"; do
  case "\$aa_a" in
    --resume=*) aa_sid="\${aa_a#--resume=}" ;;
    --model=*) aa_model="\${aa_a#--model=}" ;;
    $cont_flags) aa_cont=1 ;;
    -*) ;;
    *)
      case "\$aa_prev" in
        --resume|-r|resume) aa_sid="\$aa_a" ;;
        --model) aa_model="\$aa_a" ;;
      esac
      ;;
  esac
  aa_prev="\$aa_a"
done
# Paseo persists the selected model on the agent record. Some resume launches
# do not repeat --model, so recover it before model-scoped health filtering.
aa_agent_file=""
if [ -n "\${PASEO_AGENT_ID:-}" ]; then
  aa_paseo_home="\${PASEO_HOME:-\$HOME/.paseo}"
  aa_agent_file="\$(find "\$aa_paseo_home/agents" -maxdepth 2 -type f -name "\${PASEO_AGENT_ID}.json" -print -quit 2>/dev/null || true)"
  if [ -z "\$aa_model" ] && [ -n "\$aa_agent_file" ]; then
    aa_model="\$(sed -n 's/.*"model":[[:space:]]*"\([^"]*\)".*/\1/p' "\$aa_agent_file" | head -1)"
  fi
fi
[ -n "\$aa_model" ] && export AGENT_LINK_ROUTE_MODEL="\$aa_model"
# Paseo starts Codex as an app-server, then sends the thread id over RPC. That
# means it is absent from argv when this launcher has to choose an account.
# Paseo does provide the persisted agent id, so recover the thread id from that
# agent record before normal owner-or-healthiest resume routing runs below.
if [ "$p" = codex ] && [ -z "\$aa_sid" ] && [ -n "\${PASEO_AGENT_ID:-}" ]; then
  if [ -n "\$aa_agent_file" ]; then
    aa_sid="\$(sed -n 's/.*"sessionId":[[:space:]]*"\([^"]*\)".*/\1/p' "\$aa_agent_file" | head -1)"
  fi
fi
aa_pin=""
# An explicitly inherited env var means the caller already chose the account —
# compute nothing for it, or a mere launch would copy transcripts around.
if [ -n "\${$env_var:-}" ]; then aa_sid=""; aa_cont=""; fi
# "continue" means the newest chat — which may live in any account. Pin it to
# its owner; never copy or rotate a conversation implicitly.
if [ -z "\$aa_sid" ] && [ -n "\$aa_cont" ] && [ -x "$self" ]; then
  aa_pin="\$("$self" continue-target $p "\$PWD" "" "\$aa_model" 2>/dev/null || true)"
fi
if [ -n "\$aa_sid" ]; then
  # A legacy native conversation remains on its owning account. AgentLink ACP
  # is the only path that can switch account/model inside one logical chat.
  if [ -x "$self" ]; then
    aa_pin="\$("$self" resume-target $p "\$aa_sid" "" "\$aa_model" 2>/dev/null || true)"
  fi
  if [ -z "\$aa_pin" ]; then
    # The CLI was missing or failed — at least pin to the owner so the resume
    # still works. The primary owns sessions too, so it must be searched.
    if [ -n "\$(find "$primary_search" -maxdepth 5 -name "*\$aa_sid*" -print -quit 2>/dev/null)" ]; then
      aa_pin="primary"
    else
      for aa_d in "\$aa_root/accounts/$p"/*/; do
        [ -d "\$aa_d" ] || continue
        if [ -n "\$(find "\$aa_d" -maxdepth 5 -name "*\$aa_sid*" -print -quit 2>/dev/null)" ]; then
          aa_pin="\${aa_d%/}"
          break
        fi
      done
    fi
  fi
fi
# An explicitly inherited value always wins, then a pinned resume, then rotation.
if [ -z "\${$env_var:-}" ] && [ "\$aa_pin" != primary ]; then
  if [ -n "\$aa_pin" ]; then
    export $env_var="\$aa_pin"
  elif [ -x "$self" ]; then
    # Paseo starts short-lived provider discovery processes from / without an
    # agent id. They need a valid account, but they are not real launches and
    # must not advance LRU or inflate launch counts.
    if [ -z "\${PASEO_AGENT_ID:-}" ] && [ -z "\${PASEO_AGENT_CWD:-}" ] && [ "\$PWD" = / ]; then
      slot="\$("$self" pick $p dry "\$aa_model" 2>/dev/null || true)"
    else
      slot="\$("$self" pick $p live "\$aa_model" 2>/dev/null || true)"
    fi
    if [ -z "\$slot" ]; then
      echo "agent-link: no healthy $p account is available; wait for a cooldown or release an account" >&2
      exit 75
    elif [ "\$slot" != primary ]; then
      export $env_var="\$aa_root/accounts/$p/\$slot"
    fi
  fi
fi
$trust_block
$app_server_proxy_block
exec "\$real" "\$@"
EOF
  chmod +x "$SHIM_BIN/$p-auto"
  echo "wrote $SHIM_BIN/$p-auto"
}

cmd_auto() { # install the one-chat ACP provider and retain launchers for old sessions
  local p
  disable_legacy_paseo_recovery
  install_acp_runtime || return 1
  install_codex_app_server_proxy || return 1
  for p in $PROVIDERS; do write_auto_launcher "$p"; done
  configure_paseo_agentlink || return 1
  cmd_style install || return 1
  refresh_paseo_provider_catalog || true
  if command -v paseo >/dev/null 2>&1; then
    paseo reload >/dev/null 2>&1 || echo "Paseo config was saved; reload it from Paseo if AgentLink does not appear yet." >&2
    paseo provider diagnostic agent-link --json >/dev/null 2>&1 || true
  fi
  cat <<EOF

AgentLink is the provider for new chats. AgentRouter is its automatic model;
every connected model/account remains directly selectable. Switching changes
the next turn inside the same chat and never creates, archives or replaces a
Paseo agent.

The Claude/Codex legacy launchers remain installed only so existing chats can
resume on their original account. They no longer rotate or copy a resumed chat.
EOF
}


# Run a provider's real CLI with dynamic routing applied:
#   agent-link claude          -> Claude Code on the next account in rotation
#   agent-link codex -m ...    -> args pass straight through
# An inherited CLAUDE_CONFIG_DIR/CODEX_HOME still wins. With no healthy account
# the launcher refuses cleanly instead of silently falling onto the primary.
cmd_exec_auto() { # $1 provider, rest = args for the real CLI
  local p="$1" env_var real d slot
  shift
  env_var="$(prov_env_var "$p")"
  real=""
  local old_ifs="$IFS"; IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    [ "$d" = "$SHIM_BIN" ] && continue
    if [ -x "$d/$p" ]; then real="$d/$p"; break; fi
  done
  IFS="$old_ifs"
  [ -n "$real" ] || { prov_binary_check "$p"; return 127; }
  if [ -z "$(eval "printf '%s' \"\${$env_var:-}\"")" ]; then
    slot="$(pick_slot "$p" 2>/dev/null || true)"
    if [ -z "$slot" ]; then
      echo "agent-link: no healthy $p account is available; wait for a cooldown or release an account" >&2
      return 75
    elif [ "$slot" != primary ]; then
      export "$env_var=$(slot_dir "$p" "$slot")"
    fi
  fi
  exec "$real" "$@"
}

# Which account owns a session? Prints "primary" or a slot email. A moved
# session is a COPY, so several accounts can hold the same id — the owner is
# wherever the newest write happened, or a repeat resume would clobber the
# account that has been doing the work with a stale copy. The primary counts
# too: it owns every conversation started before any slots existed.
session_owner() { # $1 provider, $2 session-id
  local d f m best="" best_m=0 label
  for d in "$(primary_dir "$1")" "$ACCOUNTS/$1"/*/; do
    d="${d%/}"
    [ -d "$d" ] || continue
    if [ "$d" = "$(primary_dir "$1")" ]; then label=primary; else label="$(basename "$d")"; fi
    f="$(find "$d" -maxdepth 5 -name "*$2*" -not -name "*.al-moved" -type f 2>/dev/null | head -20)"
    [ -n "$f" ] || continue
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      m="$(stat -f %m "$hit" 2>/dev/null || stat -c %Y "$hit" 2>/dev/null || echo 0)"
      if [ "$m" -gt "$best_m" ]; then best_m="$m"; best="$label"; fi
    done <<EOF2
$f
EOF2
  done
  [ -n "$best" ] || return 1
  echo "$best"
}

session_dir() { # $1 provider, $2 owner (primary|email) — the config dir behind it
  if [ "$2" = primary ]; then primary_dir "$1"; else slot_dir "$1" "$2"; fi
}

# Copy every file of one session between config dirs, preserving layout. A
# session can be more than one file (transcript plus sidecars), so copy every
# match rather than the first — a partial copy resumes with holes.
cmd_resume_target() { # $1 provider, $2 session-id — print its owning config directory
  prov_valid "${1:-}" && [ -n "${2:-}" ] || {
    echo "usage: agent-link resume-target <claude|codex> <session-id>" >&2; return 1; }
  if [ "${3:-}" = --go ]; then
    echo "automatic transcript moves were removed; switch the AgentLink model/account in the same chat instead" >&2
    return 1
  fi
  local p="$1" sid="$2" owner
  owner="$(session_owner "$p" "$sid")" || return 0
  if [ "$owner" = primary ]; then
    echo primary
  else
    session_dir "$p" "$owner"
  fi
}

cmd_continue_target() { # $1 provider, $2 cwd [--go]
  prov_valid "${1:-}" && [ -n "${2:-}" ] || return 0
  local p="$1" slug d f m best="" best_m=0 sid
  slug="$(printf %s "$2" | LC_ALL=C sed 's/[^A-Za-z0-9]/-/g')"
  for d in "$(primary_dir "$p")" "$ACCOUNTS/$p"/*/; do
    d="${d%/}"
    if [ "$p" = claude ]; then
      # Claude keys history by project: newest transcript for THIS cwd.
      [ -d "$d/projects/$slug" ] || continue
      f="$(ls -t "$d/projects/$slug"/*.jsonl 2>/dev/null | head -1)"
    else
      # Codex `resume --last` is global: newest rollout, whatever the cwd.
      f="$(ls -t "$d"/sessions/*/*/*/*.jsonl 2>/dev/null | head -1)"
    fi
    [ -n "$f" ] || continue
    m="$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0)"
    if [ "$m" -gt "$best_m" ]; then best_m="$m"; best="$f"; fi
  done
  [ -n "$best" ] || return 0
  if [ "$p" = claude ]; then
    sid="$(basename "$best" .jsonl)"
  else
    # rollout-<timestamp>-<uuid>.jsonl — the uuid is the session id.
    sid="$(basename "$best" .jsonl | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || true)"
    [ -n "$sid" ] || return 0
  fi
  cmd_resume_target "$p" "$sid" "${3:-}" "${4:-}"
}

cmd_pick() { # provider — print the account to use next (used by the launchers)
  prov_valid "${1:-}" || { echo "usage: agent-link pick <claude|codex>" >&2; return 1; }
  pick_slot "$@"
}

cmd_cooldown() { # provider email minutes — park an exhausted account
  prov_valid "${1:-}" && valid_account "${2:-}" || {
    echo "usage: agent-link cooldown <claude|codex> <email> [minutes|clear]" >&2; return 1; }
  local p="$1" e="$2" arg="${3:-180}"
  mkdir -p "$(pools_dir)"
  if [ "$arg" = clear ]; then
    rm -f "$(pools_dir)/cooldown-$p-$e" "$(pools_dir)/reason-$p-$e" "$(pools_dir)/hold-$p-$e"
    echo "$p · $e: released (cooldown and hold cleared)"
    return 0
  fi
  if [ "$arg" = hold ]; then
    hold_set "$p" "$e" "held by you — release with: agent-link cooldown $p $e clear"
    echo "held by you" > "$(pools_dir)/reason-$p-$e"
    echo "$p · $e: HELD — routing skips it until you clear it (no expiry)"
    return 0
  fi
  echo "$(( $(date +%s) + arg * 60 ))" > "$(pools_dir)/cooldown-$p-$e"
  echo "parked by you" > "$(pools_dir)/reason-$p-$e"
  echo "$p · $e: parked for ${arg}m — auto-routing will skip it until then"
}

# One line, for an agent to run mid-conversation without dumping context.
# Ask each account to answer one token on a given model. Config flags proved
# unreliable — an account marked "out of credits" can still serve, and one that
# looks fine can refuse — so this measures instead of guessing.
cmd_probe() { # $1 provider (default claude), $2 model, [--park]
  local p="${1:-claude}" model="${2:-}" park="" e dir out rc ok auth_failed limit_failed model_slug
  case "${3:-}" in --park) park=1 ;; esac
  prov_valid "$p" || { echo "usage: agent-link probe <claude|codex> [model] [--park]" >&2; return 1; }
  for e in primary $(slot_list "$p"); do
    if [ "$e" = primary ]; then
      [ -n "$(primary_email "$p")" ] || continue
      dir=""
    else
      prov_logged_in "$p" "$(slot_dir "$p" "$e")" || continue
      dir="$(slot_dir "$p" "$e")"
    fi
    printf '  %-28s ' "$e"
    out="$(probe_account_once "$p" "$dir" "$model" 2>&1)"
    rc=$?
    out="$(printf '%s' "$out" | tr '\n' ' ')"
    auth_failed=""; limit_failed=""
    if is_auth_failure_text "$out"; then
      auth_failed=1
      ok=""
      printf '%sAUTH FAILED%s — login required\n' "$C_RED" "$C_OFF"
    elif [ "$rc" -ne 0 ]; then
      ok=""
      printf '%sCHECK FAILED%s — account remains unavailable\n' "$C_RED" "$C_OFF"
    elif is_limit_refusal_text "$out"; then
      limit_failed=1
      ok=""
      printf '%sCANNOT SERVE%s %s\n' "$C_RED" "$C_OFF" "${model:-default}"
    else
      ok=1
      printf '%sok%s\n' "$C_GREEN" "$C_OFF"
    fi
    if [ -n "$ok" ]; then
      model_slug="$(model_key "$model")"
      if [ -n "$model_slug" ] && [ -f "$(pools_dir)/holdmodel-$p-$e-$model_slug" ]; then
        rm -f "$(pools_dir)/holdmodel-$p-$e-$model_slug"
        echo "      released ${model:-model} — it just served"
      fi
      # Proof of service releases whatever was holding the account back.
      if [ -f "$(pools_dir)/hold-$p-$e" ] || [ -f "$(pools_dir)/cooldown-$p-$e" ]; then
        rm -f "$(pools_dir)/hold-$p-$e" "$(pools_dir)/cooldown-$p-$e" "$(pools_dir)/reason-$p-$e"
        echo "      released — it just served, so its park is over"
      fi
    elif [ -n "$park" ] && [ -n "$auth_failed" ]; then
      hold_set "$p" "$e" "authentication failed — run: agent-link login $p $e"
      echo "auto: authentication failed — login required" > "$(pools_dir)/reason-$p-$e"
      echo "      HELD (authentication) — run: agent-link login $p $e"
    elif [ -n "$park" ] && [ -n "$limit_failed" ]; then
      case "$p:$out" in
        codex:*)
          autopark "$p" "$e" hold:unknown
          echo "      HELD — Codex limits are account-wide; probe again after the cap resets"
          ;;
        *"spend limit"*)
          hold_set "$p" "$e" "monthly spend limit — raise it at claude.ai/settings/usage, then: agent-link probe $p"
          echo "auto: monthly spend limit" > "$(pools_dir)/reason-$p-$e"
          echo "      HELD (spend limit) — no expiry; probe again or clear to release"
          ;;
        *)
          if [ -n "$model" ]; then
            autopark "$p" "$e" "hold:model:$(model_key "$model")"
            echo "      HELD for $model — other Claude models remain routable"
          else
            autopark "$p" "$e" hold:unknown
            echo "      HELD — routing skips it until a probe actually serves"
          fi
          ;;
      esac
    fi
  done
}

# What the numbers actually say: where work went, what it cost in tokens, how
# much came from cache, and which accounts got refused.
cmd_insights() { # [days]
  local days="${1:-7}"
  python3 - "$ACCOUNTS" "$HOME" "$days" "$(pools_dir)" <<'PY2'
import json, os, sys, time, glob
accounts_root, home, days, pools = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
since = time.time() - days * 86400

def email_of(d):
    try:
        return (json.load(open(os.path.join(d, ".claude.json"))).get("oauthAccount") or {}).get("emailAddress") or ""
    except Exception:
        return ""

def scan(d):
    t = dict(sessions=0, inp=0, out=0, cread=0, ccreate=0, limits=0, last=0, models=set(), daily=[0]*days, proj={})
    for f in glob.glob(os.path.join(d, "projects", "*", "*.jsonl")):
        try:
            st = os.stat(f)
        except OSError:
            continue
        if st.st_mtime < since or st.st_size > 25_000_000:
            continue
        t["sessions"] += 1
        t["last"] = max(t["last"], st.st_mtime)
        label = os.path.basename(os.path.dirname(f)).split("--")[-1]
        t["proj"][label] = t["proj"].get(label, 0) + 1
        # Skip content copied in from another account (see .al-moved): its
        # tokens were spent there and its refusals happened there.
        floor = 0
        try:
            floor = int(open(f + ".al-moved").read().strip())
        except (OSError, ValueError):
            pass
        if st.st_size <= floor:
            continue
        try:
            fh = open(f, errors="ignore")
            fh.seek(floor)
            text = fh.read()
        except OSError:
            continue
        for line in text.split("\n"):
            if '"usage"' not in line and "spend limit" not in line and "usage limit" not in line:
                continue
            try:
                o = json.loads(line)
            except Exception:
                continue
            if "spend limit" in line or "usage limit" in line:
                t["limits"] += 1
            m = o.get("message") or {}
            u = m.get("usage") or {}
            if not u:
                continue
            out = u.get("output_tokens") or 0
            t["inp"] += u.get("input_tokens") or 0
            t["out"] += out
            t["cread"] += u.get("cache_read_input_tokens") or 0
            t["ccreate"] += u.get("cache_creation_input_tokens") or 0
            if m.get("model") and m["model"] != "<synthetic>":
                t["models"].add(m["model"])
            ts = o.get("timestamp")
            when = None
            if ts:
                try:
                    when = time.mktime(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S"))
                except Exception:
                    when = None
            when = when or st.st_mtime
            idx = days - 1 - int((time.time() - when) // 86400)
            if 0 <= idx < days:
                t["daily"][idx] += out
    return t

def human(n):
    return f"{n/1_000_000:.1f}M" if n >= 1_000_000 else (f"{round(n/1000)}k" if n >= 1000 else str(n))

def spark(vals):
    blocks = "▁▂▃▄▅▆▇█"
    top = max(vals) or 1
    return "".join(blocks[min(7, int(v / top * 7))] if v else "·" for v in vals)

dirs = [(email_of(home) or "primary", os.path.join(home, ".claude"), "primary")]
for d in sorted(glob.glob(os.path.join(accounts_root, "claude", "*"))):
    dirs.append((os.path.basename(d), d, "account"))

rows = [(name, kind, scan(d), d) for name, d, kind in dirs]
total_out = sum(r[2]["out"] for r in rows) or 1
print(f"\n  Last {days} days\n")
for name, kind, t, d in rows:
    if t["sessions"] == 0:
        print(f"  {name:28} {kind:8} no activity")
        continue
    tin = t["inp"] + t["cread"] + t["ccreate"]
    cache = round(t["cread"] / tin * 100) if tin else 0
    launches = 0
    key = "primary" if kind == "primary" else name
    try:
        launches = int(open(os.path.join(pools, f"count-claude-{key}")).read().strip())
    except Exception:
        pass
    print(f"  {name:28} {kind:8} {spark(t['daily'])}  {t['sessions']:>3} sessions · {human(t['out']):>5} out · {cache:>2}% cached · {round(t['out']/total_out*100):>2}% of work")
    extra = []
    if launches:
        extra.append(f"{launches} launches")
    if t["models"]:
        extra.append(", ".join(sorted(m.replace("claude-", "") for m in t["models"]))[:48])
    if t["proj"]:
        extra.append("mostly " + max(t["proj"], key=t["proj"].get))
    if extra:
        print(f"  {'':28} {'':8} {' · '.join(extra)}")
    if t["limits"]:
        ago = int((time.time() - t["last"]) / 60)
        print(f"  {'':28} {'':8} ⚠ {t['limits']} limit refusals · probe this account before relying on it")
print()
PY2
}

# The Paseo panel is an optional companion that ships in this repo. Install it
# only when Paseo is actually present — the CLI never depends on it.
REPO_URL="https://github.com/itsjustanks/paseo-agent-link"
RAW_URL="https://raw.githubusercontent.com/itsjustanks/paseo-agent-link/main/agent-link"
RELEASES_URL="https://api.github.com/repos/itsjustanks/paseo-agent-link/releases/latest"

# Updates follow RELEASES, not main: a release is a version someone chose to
# announce, main is whatever landed last. Falls back to main when the API is
# unreachable, so an update is never impossible.
latest_release_tag() {
  # GitHub/CDN responses can briefly cache the previous `latest` release.
  # A cache-buster prevents `agent-link update` from downgrading a fresh fix.
  curl -fsSL -m 8 "${RELEASES_URL}?nocache=$(date +%s)" 2>/dev/null |
    python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("tag_name") or "")
except Exception: pass' 2>/dev/null
}

# ---------------------------------------------------------------- apps
#
# Integrations live in apps/<id>/ with an app.json describing how to install
# them. Nothing here is required: the CLI works on its own, and an app only
# appears as installable when the tool it targets is present.

apps_dir() { # find the apps/ directory, fetching or refreshing the repo
  local here d
  here="$(cd "$(dirname "$0")" && pwd)"
  # A checkout next to the script is the developer's own tree: use it as-is.
  for d in "$here/apps" "$here/../apps"; do
    [ -d "$d" ] && { echo "$d"; return 0; }
  done
  command -v git >/dev/null 2>&1 || { [ -d "$ROOT/src/apps" ] && { echo "$ROOT/src/apps"; return 0; }; return 1; }
  # The managed copy must be brought up to date, or an install would keep
  # reinstalling whatever was published the first time the CLI ever ran.
  if [ -d "$ROOT/src/.git" ]; then
    # The panel must match the CLI, so the managed clone follows the same
    # release tag the updater installs — main only when no release resolves.
    local tag ref
    tag="$(latest_release_tag)"
    ref="${tag:+refs/tags/$tag}"; ref="${ref:-HEAD}"
    git -C "$ROOT/src" fetch -q --depth 1 origin "$ref" 2>/dev/null &&
      git -C "$ROOT/src" reset -q --hard FETCH_HEAD 2>/dev/null ||
      echo "could not refresh $ROOT/src — installing the copy already there" >&2
    [ -d "$ROOT/src/apps" ] && { echo "$ROOT/src/apps"; return 0; }
  fi
  echo "fetching integrations from ${REPO_URL}…" >&2
  rm -rf "$ROOT/src.tmp"
  if git clone --depth 1 -q "$REPO_URL" "$ROOT/src.tmp" >&2; then
    rm -rf "$ROOT/src"; mv "$ROOT/src.tmp" "$ROOT/src"
    [ -d "$ROOT/src/apps" ] && { echo "$ROOT/src/apps"; return 0; }
  fi
  return 1
}

# Updating is two things — this file, and the app sources it installs from.
cmd_update() {
  local self target cli_only="" update_rc=0
  [ "${1:-}" = "--cli-only" ] && cli_only=1
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  echo
  if [ -d "$(dirname "$self")/.git" ] || [ -d "$(dirname "$self")/../.git" ]; then
    echo "  ${C_DIM}$self is a git checkout — pull it yourself.${C_OFF}"
  else
    local tag; tag="$(latest_release_tag)"
    if [ -n "$tag" ]; then
      target="https://raw.githubusercontent.com/itsjustanks/paseo-agent-link/$tag/agent-link"
      printf '  updating %s to %s… ' "$self" "$tag"
    else
      target="$RAW_URL"
      printf '  updating %s (no release info — using main)… ' "$self"
    fi
    if curl -fsSL "$target" -o "$self.new" 2>/dev/null && [ -s "$self.new" ]; then
      chmod +x "$self.new"; mv "$self.new" "$self"
      echo "${C_GREEN}done${C_OFF} (now $("$self" --version 2>/dev/null || echo "?"))"
    else
      rm -f "$self.new"
      echo "${C_RED}failed${C_OFF} — check your connection, or re-run the curl from the README"
      update_rc=1
    fi
  fi
  [ -n "$cli_only" ] && return "$update_rc"
  # Anything installed from this repo gets the new source too, or the CLI and
  # its Paseo panel drift apart.
  local base d id
  base="$(apps_dir)" || { echo "  no apps to update"; return 0; }
  install_acp_runtime || update_rc=1
  configure_paseo_agentlink || update_rc=1
  for d in "$base"/*/; do
    [ -f "$d/app.json" ] || continue
    [ "$(app_state "$d")" = installed ] || continue
    id="$(app_field "$d" id)"
    echo "  reinstalling the '${id}' app (this repo's panel — Paseo itself is untouched)…"
    cmd_app install "$id"
  done
  return "$update_rc"
}

# ---------------------------------------------------------------- toolchain updates
#
# Provider CLIs are executable code, not account state. Replacing an idle
# binary is safe, but asking an updater to mutate files beneath a live provider
# is needlessly risky. Scheduled updates therefore prove a provider family is
# idle through both Paseo and the process table. Any uncertainty is a skip.

toolchain_plist() { echo "$HOME/Library/LaunchAgents/com.agent-link.toolchain-updater.plist"; }
toolchain_log() { echo "$STATE/toolchain-updater.log"; }
toolchain_state() { echo "$STATE/toolchain-updates.json"; }
toolchain_config() { echo "$ROOT/toolchain-providers.json"; }
toolchain_cron_marker() { echo "# agent-link-toolchain-updater"; }
toolchain_watchdog_marker() { echo "$STATE/toolchain-watchdog-enabled"; }
toolchain_watchdog_stamp() { echo "$STATE/toolchain-watchdog-last-date"; }
toolchain_runtime_path() {
  printf '%s\n' "$HOME/.local/bin:$HOME/.kimi-code/bin:$HOME/.grok/bin:$HOME/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
}

toolchain_cron_enabled() {
  command -v crontab >/dev/null 2>&1 || return 1
  crontab -l 2>/dev/null | grep -Fq "$(toolchain_cron_marker)"
}

toolchain_install_cron() { # $1 executable
  local executable="$1" marker existing line
  command -v crontab >/dev/null 2>&1 || return 1
  marker="$(toolchain_cron_marker)"
  existing="$(crontab -l 2>/dev/null || true)"
  line="$(python3 - "$executable" "$(toolchain_log)" "$marker" "$HOME" "$(toolchain_runtime_path)" <<'PY2'
import shlex, sys
executable, log, marker, home, runtime_path = sys.argv[1:]
args = ["/usr/bin/env", f"HOME={home}", f"PATH={runtime_path}", executable, "toolchain", "update", "--scheduled"]
command = " ".join(shlex.quote(arg) for arg in args)
print(f"15 4 * * * {command} >> {shlex.quote(log)} 2>&1 {marker}")
PY2
)"
  {
    printf '%s\n' "$existing" | grep -Fv "$marker" || true
    printf '%s\n' "$line"
  } | crontab -
}

toolchain_remove_cron() {
  local marker existing
  toolchain_cron_enabled || return 0
  marker="$(toolchain_cron_marker)"
  existing="$(crontab -l 2>/dev/null || true)"
  printf '%s\n' "$existing" | grep -Fv "$marker" | crontab - || true
}

toolchain_watchdog_available() {
  local uid label
  command -v launchctl >/dev/null 2>&1 || return 1
  uid="$(id -u)"
  for label in com.agent-link.paseo-watchdog com.ankit.paseo-watchdog; do
    launchctl print "gui/$uid/$label" >/dev/null 2>&1 && return 0
  done
  return 1
}

toolchain_enable_watchdog() {
  toolchain_watchdog_available || return 1
  : > "$(toolchain_watchdog_marker)"
  echo "automatic provider CLI updates enabled via the Paseo watchdog — daily after 04:15"
  echo "live providers are skipped and retried on the next daily run"
}

toolchain_watchdog_tick() {
  local marker today last hour self
  marker="$(toolchain_watchdog_marker)"
  [ -f "$marker" ] || return 0
  today="$(date +%Y-%m-%d)"
  last="$(cat "$(toolchain_watchdog_stamp)" 2>/dev/null || true)"
  hour="$(date +%H)"
  [ "$last" != "$today" ] || return 0
  [ "$hour" -gt 4 ] || { [ "$hour" -eq 4 ] && [ "$(date +%M)" -ge 15 ]; } || return 0
  printf '%s\n' "$today" > "$(toolchain_watchdog_stamp)"
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  /usr/bin/nohup /usr/bin/nice -n 10 "$self" toolchain update --scheduled \
    >> "$(toolchain_log)" 2>&1 </dev/null &
}

toolchain_binary_path() { # $1 provider
  local resolved=""
  case "$1" in
    claude|codex) resolved="$(prov_real_binary "$1" 2>/dev/null || true)" ;;
    kimi)
      resolved="$(command -v kimi 2>/dev/null || true)"
      [ -n "$resolved" ] || [ ! -x "$HOME/.kimi-code/bin/kimi" ] || resolved="$HOME/.kimi-code/bin/kimi"
      ;;
    grok)
      resolved="$(command -v grok 2>/dev/null || true)"
      [ -n "$resolved" ] || [ ! -x "$HOME/.grok/bin/grok" ] || resolved="$HOME/.grok/bin/grok"
      ;;
    paseo) resolved="$(command -v paseo 2>/dev/null || true)" ;;
    *)
      resolved="$(python3 - "$(toolchain_config)" "$1" <<'PY2'
import json, os, shutil, sys
try: entries = json.load(open(sys.argv[1])).get("providers", [])
except Exception: entries = []
entry = next((item for item in entries if item.get("id") == sys.argv[2]), {})
binary = str(entry.get("binary") or sys.argv[2])
print(binary if os.path.isabs(binary) and os.access(binary, os.X_OK) else (shutil.which(binary) or ""))
PY2
)"
      ;;
  esac
  [ -n "$resolved" ] && printf '%s\n' "$resolved"
}

toolchain_version() { # $1 provider, $2 binary
  local value
  if [ "$1" = claude ] || [ "$1" = codex ] || [ "$1" = kimi ] || [ "$1" = grok ] || [ "$1" = paseo ]; then
    value="$("$2" --version 2>/dev/null | head -1 || true)"
  else
    value="$(python3 - "$(toolchain_config)" "$1" "$2" <<'PY2'
import json, subprocess, sys
try: entries = json.load(open(sys.argv[1])).get("providers", [])
except Exception: entries = []
entry = next((item for item in entries if item.get("id") == sys.argv[2]), {})
args = entry.get("versionArgs") if isinstance(entry.get("versionArgs"), list) else ["--version"]
try:
    result = subprocess.run([sys.argv[3], *map(str, args)], text=True, capture_output=True, timeout=15)
    print((result.stdout or result.stderr).splitlines()[0] if (result.stdout or result.stderr) else "")
except Exception:
    pass
PY2
)"
  fi
  [ -n "$value" ] || value="unknown"
  printf '%s\n' "$value"
}

toolchain_record() { # provider result before after detail
  local state_file; state_file="$(toolchain_state)"
  python3 - "$state_file" "$1" "$2" "$3" "$4" "$5" <<'PY2'
import datetime, json, os, sys

path, provider, result, before, after, detail = sys.argv[1:]
try:
    data = json.load(open(path))
except Exception:
    data = {"providers": {}}
if not isinstance(data.get("providers"), dict):
    data["providers"] = {}
data["lastRunAt"] = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
data["providers"][provider] = {
    "result": result,
    "before": before or None,
    "after": after or None,
    "detail": detail,
    "checkedAt": data["lastRunAt"],
}
os.makedirs(os.path.dirname(path), exist_ok=True)
tmp = path + ".tmp"
with open(tmp, "w") as handle:
    json.dump(data, handle, indent=2)
os.replace(tmp, path)
PY2
}

toolchain_snapshot_runtime() {
  TOOLCHAIN_PASEO_STATE=absent
  TOOLCHAIN_PASEO_RUNNING=""
  local paseo_bin payload
  paseo_bin="$(toolchain_binary_path paseo)"
  [ -n "$paseo_bin" ] || return 0
  if ! payload="$("$paseo_bin" ls --global --json 2>/dev/null)"; then
    TOOLCHAIN_PASEO_STATE=unavailable
    return 0
  fi
  TOOLCHAIN_PASEO_STATE=ok
  TOOLCHAIN_PASEO_RUNNING="$(printf '%s' "$payload" | python3 -c '
import json, sys
try:
    rows = json.load(sys.stdin)
except Exception:
    sys.exit(2)
families = set()
for row in rows if isinstance(rows, list) else []:
    if str(row.get("status") or "").lower() != "running":
        continue
    provider = str(row.get("provider") or "").lower().split("/", 1)[0]
    if "agent-router" in provider or "agentrouter" in provider:
        families.add("all")
    families.add(provider.removesuffix("-auto"))
    for family in ("claude", "codex", "kimi", "grok"):
        if provider.startswith(family) or family in provider: families.add(family)
print(" ".join(sorted(families)))
' 2>/dev/null)" || TOOLCHAIN_PASEO_STATE=unavailable
}

toolchain_idle() { # $1 provider; 0 idle, 1 active, 2 unknown
  local provider="$1" pattern rc
  [ "$TOOLCHAIN_PASEO_STATE" != unavailable ] || return 2
  case " $TOOLCHAIN_PASEO_RUNNING " in
    *" all "*|*" $provider "*) return 1 ;;
  esac
  command -v pgrep >/dev/null 2>&1 || return 2
  case "$provider" in
    claude) pattern='(^|/)(claude|claude-auto)( |$)' ;;
    codex)  pattern='(^|/)(codex|codex-auto)( |$)' ;;
    kimi)   pattern='(^|/)(kimi)( |$)' ;;
    grok)   pattern='(^|/)(grok)( |$)' ;;
    *)
      pattern="$(python3 - "$(toolchain_config)" "$provider" <<'PY2'
import json, sys
try: entries = json.load(open(sys.argv[1])).get("providers", [])
except Exception: entries = []
entry = next((item for item in entries if item.get("id") == sys.argv[2]), {})
print(entry.get("processPattern") or rf"(^|/)({sys.argv[2]})( |$)")
PY2
)"
      ;;
  esac
  pgrep -f "$pattern" >/dev/null 2>&1
  rc=$?
  [ "$rc" -eq 1 ] && return 0
  [ "$rc" -eq 0 ] && return 1
  return 2
}

toolchain_update_one() { # $1 provider
  local provider="$1" binary before after output detail result rc tmp_file
  binary="$(toolchain_binary_path "$provider")"
  if [ -z "$binary" ]; then
    printf '  %-8s not installed\n' "$provider"
    toolchain_record "$provider" missing "" "" "binary not installed"
    return 0
  fi
  before="$(toolchain_version "$provider" "$binary")"
  toolchain_idle "$provider"
  rc=$?
  if [ "$rc" -eq 1 ]; then
    printf '  %-8s skipped — live session or process (%s)\n' "$provider" "$before"
    toolchain_record "$provider" skipped "$before" "$before" "live session or process"
    return 0
  fi
  if [ "$rc" -ne 0 ]; then
    printf '  %-8s skipped — could not prove idle (%s)\n' "$provider" "$before"
    toolchain_record "$provider" skipped "$before" "$before" "could not prove idle"
    return 0
  fi

  output=""
  rc=0
  case "$provider" in
    claude) output="$("$binary" update 2>&1)" || rc=$? ;;
    codex) output="$("$binary" update 2>&1)" || rc=$? ;;
    grok) output="$("$binary" update --stable 2>&1)" || rc=$? ;;
    kimi)
      tmp_file="$(mktemp "${TMPDIR:-/tmp}/agent-link-kimi-installer.XXXXXX")" || rc=$?
      if [ "$rc" -eq 0 ]; then
        curl -fsSL --connect-timeout 10 --max-time 120 \
          https://code.kimi.com/kimi-code/install.sh -o "$tmp_file" 2>/dev/null || rc=$?
      fi
      if [ "$rc" -eq 0 ]; then
        output="$(KIMI_NO_MODIFY_PATH=1 /bin/bash "$tmp_file" 2>&1)" || rc=$?
      fi
      [ -z "${tmp_file:-}" ] || rm -f "$tmp_file"
      ;;
    *)
      output="$(python3 - "$(toolchain_config)" "$provider" "$binary" <<'PY2'
import json, subprocess, sys
try: entries = json.load(open(sys.argv[1])).get("providers", [])
except Exception: entries = []
entry = next((item for item in entries if item.get("id") == sys.argv[2]), {})
args = entry.get("updateArgs") if isinstance(entry.get("updateArgs"), list) else []
if not args:
    print("no update arguments configured")
    raise SystemExit(64)
try:
    result = subprocess.run([sys.argv[3], *map(str, args)], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=900)
    print(result.stdout or "", end="")
    raise SystemExit(result.returncode)
except subprocess.TimeoutExpired:
    print("updater timed out after 15 minutes")
    raise SystemExit(124)
PY2
)" || rc=$?
      ;;
  esac
  after="$(toolchain_version "$provider" "$binary")"
  detail="$(printf '%s' "$output" | tr '\n\t' '  ' | cut -c1-500)"
  if [ "$rc" -eq 0 ]; then
    result=updated
    [ "$before" = "$after" ] && result=current
    printf '  %-8s %s — %s\n' "$provider" "$result" "$after"
  else
    result=failed
    [ -n "$detail" ] || detail="updater exited $rc"
    printf '  %-8s failed — %s\n' "$provider" "$detail"
  fi
  toolchain_record "$provider" "$result" "$before" "$after" "$detail"
  [ "$rc" -eq 0 ]
}

toolchain_update() {
  local lock="$STATE/toolchain-update.lock" provider failures=0 lock_age self before after result detail
  if ! mkdir "$lock" 2>/dev/null; then
    lock_age="$(python3 - "$lock" <<'PY2'
import os, sys, time
try: print(int(time.time() - os.path.getmtime(sys.argv[1])))
except OSError: print(0)
PY2
)"
    if [ "$lock_age" -gt 21600 ] && rmdir "$lock" 2>/dev/null && mkdir "$lock" 2>/dev/null; then
      echo "cleared stale provider-update lock"
    else
      echo "provider update already running — skipped"
      return 0
    fi
  fi
  trap 'rmdir "$lock" 2>/dev/null || true' EXIT INT TERM
  toolchain_snapshot_runtime
  echo "Provider CLI updates (live sessions are never touched):"
  for provider in claude codex kimi grok $(python3 - "$(toolchain_config)" <<'PY2'
import json, sys
try: entries = json.load(open(sys.argv[1])).get("providers", [])
except Exception: entries = []
print(" ".join(str(item.get("id")) for item in entries if item.get("id") not in {"claude", "codex", "kimi", "grok"}))
PY2
); do
    toolchain_update_one "$provider" || failures=$((failures + 1))
  done
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  before="$VERSION"
  echo "  agent-link checking latest released CLI…"
  if cmd_update --cli-only; then
    after="$("$self" --version 2>/dev/null || echo unknown)"
    result=updated; [ "$before" = "$after" ] && result=current
    detail="release updater completed"
  else
    after="$("$self" --version 2>/dev/null || echo "$before")"
    result=failed; detail="release updater failed"
    failures=$((failures + 1))
  fi
  toolchain_record agent-link "$result" "$before" "$after" "$detail"
  rmdir "$lock" 2>/dev/null || true
  trap - EXIT INT TERM
  [ "$failures" -eq 0 ]
}

toolchain_status() {
  local provider binary current schedule="disabled" state_file
  if launchctl print "gui/$(id -u)/com.agent-link.toolchain-updater" >/dev/null 2>&1; then
    schedule="enabled via launchd daily at 04:15"
  elif toolchain_cron_enabled; then
    schedule="enabled via cron daily at 04:15"
  elif [ -f "$(toolchain_watchdog_marker)" ] && toolchain_watchdog_available; then
    schedule="enabled via Paseo watchdog daily after 04:15"
  elif [ -f "$(toolchain_plist)" ]; then
    schedule="written but not loaded"
  fi
  echo "Automatic provider CLI updates: $schedule"
  for provider in claude codex kimi grok $(python3 - "$(toolchain_config)" <<'PY2'
import json, sys
try: entries = json.load(open(sys.argv[1])).get("providers", [])
except Exception: entries = []
print(" ".join(str(item.get("id")) for item in entries if item.get("id") not in {"claude", "codex", "kimi", "grok"}))
PY2
); do
    binary="$(toolchain_binary_path "$provider")"
    if [ -n "$binary" ]; then
      current="$(toolchain_version "$provider" "$binary")"
      printf '  %-8s %s  %s\n' "$provider" "$current" "$binary"
    else
      printf '  %-8s not installed\n' "$provider"
    fi
  done
  binary="$(toolchain_binary_path paseo)"
  if [ -n "$binary" ]; then
    current="$(toolchain_version paseo "$binary")"
    printf '  %-8s %s  %s (desktop app-managed)\n' paseo "$current" "$binary"
  else
    echo "  paseo    not installed (desktop app-managed)"
  fi
  state_file="$(toolchain_state)"
  [ ! -f "$state_file" ] || python3 - "$state_file" <<'PY2'
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
print("Last run: " + str(data.get("lastRunAt") or "unknown"))
for provider, row in sorted((data.get("providers") or {}).items()):
    print(f"  {provider:<8} {row.get('result', 'unknown')} — {row.get('detail') or row.get('after') or ''}")
PY2
}

toolchain_enable() {
  local plist self uid target_dir
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  if ! command -v launchctl >/dev/null 2>&1; then
    if toolchain_install_cron "$self"; then
      echo "automatic provider CLI updates enabled via cron — daily at 04:15"
      echo "live providers are skipped and retried on the next daily run"
      return 0
    fi
    echo "neither launchd, cron, nor the Paseo watchdog is available on this machine" >&2
    return 1
  fi
  plist="$(toolchain_plist)"
  target_dir="$(dirname "$plist")"
  uid="$(id -u)"
  mkdir -p "$target_dir" "$STATE"
  python3 - "$plist" "$self" "$(toolchain_log)" "$HOME" "$(toolchain_runtime_path)" <<'PY2'
import os, plistlib, sys
path, executable, log, home, runtime_path = sys.argv[1:]
payload = {
    "Label": "com.agent-link.toolchain-updater",
    "ProgramArguments": [executable, "toolchain", "update", "--scheduled"],
    "EnvironmentVariables": {
        "HOME": home,
        "PATH": runtime_path,
    },
    "RunAtLoad": True,
    "StartCalendarInterval": {"Hour": 4, "Minute": 15},
    "ProcessType": "Background",
    "LowPriorityIO": True,
    "Nice": 10,
    "ThrottleInterval": 3600,
    "StandardOutPath": log,
    "StandardErrorPath": log,
}
tmp = path + ".tmp"
with open(tmp, "wb") as handle:
    plistlib.dump(payload, handle)
os.replace(tmp, path)
PY2
  launchctl bootout "gui/$uid/com.agent-link.toolchain-updater" >/dev/null 2>&1 || true
  if ! launchctl bootstrap "gui/$uid" "$plist"; then
    echo "launchd could not load the schedule; using the daily cron fallback" >&2
    if ! toolchain_install_cron "$self"; then
      echo "cron could not install the schedule; trying the loaded Paseo watchdog" >&2
      if toolchain_enable_watchdog; then
        rm -f "$plist"
        return 0
      fi
      echo "no supported scheduler could install the daily update" >&2
      return 1
    fi
    rm -f "$plist"
    echo "automatic provider CLI updates enabled via cron — daily at 04:15"
    echo "live providers are skipped and retried on the next daily run"
    return 0
  fi
  toolchain_remove_cron
  rm -f "$(toolchain_watchdog_marker)" "$(toolchain_watchdog_stamp)"
  echo "automatic provider CLI updates enabled — daily at 04:15 and once now"
  echo "live providers are skipped and retried on the next daily run"
}

toolchain_disable() {
  local plist uid
  plist="$(toolchain_plist)"; uid="$(id -u)"
  launchctl bootout "gui/$uid/com.agent-link.toolchain-updater" >/dev/null 2>&1 || true
  toolchain_remove_cron
  rm -f "$(toolchain_watchdog_marker)" "$(toolchain_watchdog_stamp)"
  [ ! -f "$plist" ] || rm -f "$plist"
  echo "automatic provider CLI updates disabled"
}

cmd_toolchain() { # status|update|enable|disable
  case "${1:-status}" in
    status) toolchain_status ;;
    update) toolchain_update ;;
    enable) toolchain_enable ;;
    disable) toolchain_disable ;;
    *) echo "usage: agent-link toolchain [status|update|enable|disable]" >&2; return 1 ;;
  esac
}

app_field() { # $1 app dir, $2 key
  python3 - "$1/app.json" "$2" <<'PY2'
import json, sys
try:
    print(json.load(open(sys.argv[1])).get(sys.argv[2], "") or "")
except Exception:
    print("")
PY2
}

app_state() { # $1 app dir -> installed|available|unavailable
  local req kind pid
  req="$(app_field "$1" requires)"
  kind="$(app_field "$1" kind)"
  [ -n "$req" ] && ! command -v "$req" >/dev/null 2>&1 && { echo unavailable; return; }
  case "$kind" in
    paseo-plugin)
      pid="$(app_field "$1" pluginId)"
      paseo plugin ls 2>/dev/null | grep -q "^$pid" && echo installed || echo available
      ;;
    *) echo available ;;
  esac
}

# Paseo keeps its plugins in <paseo home>/plugins/<id> and identifies each one
# by that id. Installing means putting the source there and registering the id,
# which is exactly what these two helpers make automatic.
paseo_home() {
  local home
  home="$(paseo daemon status --json 2>/dev/null | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
except Exception:
    d = {}
print(d.get("home") or d.get("daemon", {}).get("home") or "")' 2>/dev/null)"
  [ -n "$home" ] && [ -d "$home" ] && { echo "$home"; return; }
  echo "$HOME/.paseo"
}

paseo_plugins_on() { # plugins are off by default and only the user may turn them on
  python3 - "$(paseo_home)/config.json" <<'PY3'
import json, sys
try:
    print("yes" if json.load(open(sys.argv[1])).get("pluginsEnabled") else "no")
except Exception:
    print("no")
PY3
}

paseo_plugin_source() { # $1 plugin id -> git|directory|empty
  paseo plugin status "$1" --json 2>/dev/null | python3 -c '
import json, sys
try: value = json.load(sys.stdin)
except Exception: value = []
rows = value if isinstance(value, list) else [value]
print(next((row.get("source") or "" for row in rows if isinstance(row, dict) and row.get("id") == sys.argv[1]), ""))
' "$1"
}

paseo_has_git_plugins() {
  paseo plugin add --help 2>&1 | grep -q -- '--path <path>'
}

install_paseo_plugin() { # $1 source dir, $2 plugin id, $3 "link" to run from source
  local src="$1" pid="$2" mode="${3:-copy}" dest home status prior_path source
  command -v paseo >/dev/null 2>&1 || {
    echo "Paseo is not installed on this machine — this app is optional." >&2
    echo "Get it at https://paseo.sh, then run: agent-link app install paseo" >&2
    return 1; }
  if [ "$(paseo_plugins_on)" != yes ]; then
    echo "Paseo has plugins switched off." >&2
    echo "Turn them on in Paseo → Settings → Plugins, then run: agent-link app install paseo" >&2
    return 1
  fi

  # Paseo 0.7+ owns Git installs and updates. It builds a candidate with install
  # scripts disabled and keeps the current plugin if the candidate cannot start.
  # --link stays explicit for local development; older hosts use the copy flow.
  if [ "$mode" != link ] && paseo_has_git_plugins; then
    source="$(paseo_plugin_source "$pid")"
    if [ "$source" = git ]; then
      echo "checking the Git-managed plugin for updates…"
      paseo plugin update "$pid" >/dev/null || return 1
    else
      prior_path="$(paseo plugin ls --json 2>/dev/null | python3 -c '
import json, sys
try: rows = json.load(sys.stdin)
except Exception: rows = []
print(next((row.get("path") or "" for row in rows if isinstance(row, dict) and row.get("id") == sys.argv[1]), ""))
' "$pid")"
      [ -n "$source" ] && paseo plugin remove "$pid" >/dev/null 2>&1
      echo "installing from Git with Paseo-managed updates…"
      if ! paseo plugin add itsjustanks/paseo-agent-link --path apps/paseo --id "$pid" >/dev/null; then
        [ -n "$prior_path" ] && [ -d "$prior_path" ] && paseo plugin install "$prior_path" --id "$pid" >/dev/null 2>&1
        echo "Git install failed; the previous plugin was restored when possible." >&2
        return 1
      fi
    fi
    status="$(paseo plugin ls 2>/dev/null | awk -v id="$pid" '$1 == id { print $2 }')"
    case "$status" in
      running) echo "installed from Git and running. Paseo now checks and applies its updates." ;;
      "")      echo "installed, but Paseo does not list it yet — check: paseo plugin ls" >&2 ;;
      *)       echo "installed but $status — check: paseo plugin logs $pid" >&2; return 1 ;;
    esac
    return 0
  fi

  command -v npm >/dev/null 2>&1 || {
    echo "This app needs Node.js (for npm) to build. Install Node 20+, then run this again." >&2
    return 1; }

  home="$(paseo_home)"
  if [ "$mode" = link ]; then
    dest="$src"
  else
    dest="$home/plugins/$pid"
    echo "installing into ${dest}…"
    mkdir -p "$dest" || return 1
    # Copy the source only: node_modules is rebuilt in place and .git is noise.
    ( cd "$src" && tar --exclude=node_modules --exclude=.git -cf - . ) | ( cd "$dest" && tar -xf - ) || return 1
    # Stamp what was installed, so the panel can compare it with the release.
    local sha; sha="$(git -C "$src" rev-parse HEAD 2>/dev/null || true)"
    printf '{ "sha": "%s", "version": "%s", "builtAt": "%s" }\n' "$sha" "$VERSION" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dest/build.json"
  fi

  [ -d "$dest/node_modules" ] || { echo "installing dependencies…"; (cd "$dest" && npm install --silent --no-audit --no-fund) || return 1; }
  (cd "$dest" && npm run --silent typecheck) || { echo "app failed to typecheck — not installing" >&2; return 1; }

  # Paseo refuses to install over an existing id, so an upgrade means dropping
  # the registration first. That removes configuration only — never source.
  paseo plugin ls 2>/dev/null | grep -q "^$pid " && paseo plugin remove "$pid" >/dev/null 2>&1
  paseo plugin install "$dest" --id "$pid" >/dev/null || return 1
  status="$(paseo plugin ls 2>/dev/null | awk -v id="$pid" '$1 == id { print $2 }')"
  case "$status" in
    running) echo "installed and running. Open Paseo → AgentLink or MCP." ;;
    "")      echo "installed, but Paseo does not list it yet — check: paseo plugin ls" >&2 ;;
    *)       echo "installed but $status — check: paseo plugin logs $pid" >&2; return 1 ;;
  esac
}

cmd_app() { # list|install|status|remove [id] [--link]
  local action="${1:-list}" id="${2:-}" mode=copy base d state kind pid dest
  case "${3:-}" in --link|--dev) mode="link" ;; esac
  base="$(apps_dir)" || { echo "no apps/ directory found and could not fetch it" >&2; return 1; }
  case "$action" in
    list|status)
      for d in "$base"/*/; do
        [ -f "$d/app.json" ] || continue
        state="$(app_state "$d")"
        case "$state" in
          installed)   printf '  %s●%s %-10s %-46s %sinstalled%s\n' "$C_GREEN" "$C_OFF" "$(app_field "$d" id)" "$(app_field "$d" summary)" "$C_GREEN" "$C_OFF" ;;
          available)   printf '  %s○%s %-10s %-46s %savailable — agent-link app install %s%s\n' "$C_DIM" "$C_OFF" "$(app_field "$d" id)" "$(app_field "$d" summary)" "$C_DIM" "$(app_field "$d" id)" "$C_OFF" ;;
          *)           printf '  %s·%s %-10s %-46s %s%s not installed on this machine%s\n' "$C_DIM" "$C_OFF" "$(app_field "$d" id)" "$(app_field "$d" summary)" "$C_DIM" "$(app_field "$d" requires)" "$C_OFF" ;;
        esac
      done
      return 0
      ;;
    install|remove) [ -n "$id" ] || { echo "usage: agent-link app $action <id>   (see: agent-link app list)" >&2; return 1; } ;;
    *) echo "usage: agent-link app [list|install|remove] [id] [--link]" >&2; return 1 ;;
  esac
  d="$base/$id"
  [ -f "$d/app.json" ] || { echo "no app called '$id' — try: agent-link app list" >&2; return 1; }
  kind="$(app_field "$d" kind)"; pid="$(app_field "$d" pluginId)"
  case "$kind" in
    paseo-plugin)
      if [ "$action" = remove ]; then
        command -v paseo >/dev/null 2>&1 || { echo "Paseo is not installed here." >&2; return 1; }
        paseo plugin remove "$pid" >/dev/null 2>&1
        dest="$(paseo_home)/plugins/$pid"
        # Only ever delete our own copy — a --link install points at your repo.
        [ -d "$dest" ] && [ "$dest" != "$d" ] && rm -rf "$dest"
        echo "removed. The source in apps/$id is untouched."
        return 0
      fi
      install_paseo_plugin "$d" "$pid" "$mode"
      ;;
    docs-only)
      [ "$action" = remove ] && { echo "nothing to remove — this app is instructions only"; return 0; }
      echo; sed 's/^/  /' "$d/$(app_field "$d" doc)"
      ;;
    *) echo "unknown app kind: $kind" >&2; return 1 ;;
  esac
}

# Back-compat: `agent-link plugin …` still means the Paseo app.
cmd_plugin() {
  case "${1:-status}" in
    status) cmd_app list ;;
    install) cmd_app install paseo ;;
    remove) cmd_app remove paseo ;;
    *) echo "usage: agent-link plugin [install|status|remove]" >&2; return 1 ;;
  esac
}

# One key that does the obvious maintenance: sideline accounts that cannot serve
# your model, move conversations off them, and put every account back in step.
cmd_whoami() { # [provider]
  local p pdir email kind runs nxt
  for p in ${1:-$PROVIDERS}; do
    prov_valid "$p" || continue
    pdir="$(eval "printf '%s' \"\${$(prov_env_var "$p"):-}\"")"
    if [ -n "$pdir" ]; then
      email="$(prov_email "$p" "$pdir")"
      kind="account"
      runs="$(cat "$(pools_dir)/count-$p-$(basename "$pdir")" 2>/dev/null || echo 0)"
    else
      email="$(primary_email "$p")"
      kind="primary"
      runs="$(cat "$(pools_dir)/count-$p-primary" 2>/dev/null || echo 0)"
    fi
    [ -n "$email" ] || continue
    nxt="$(pick_slot "$p" dry 2>/dev/null || echo "-")"
    printf '%s: %s (%s, %s launches) · next: %s\n' "$p" "$email" "$kind" "$runs" "$nxt"
  done
}

cmd_pools() { # show what auto-routing sees
  local p e now until last state
  now="$(date +%s)"
  for p in $PROVIDERS; do
    echo "$p"
    for e in $(slot_list "$p"); do
      until="$(cat "$(pools_dir)/cooldown-$p-$e" 2>/dev/null || echo 0)"
      last="$(cat "$(pools_dir)/last-$p-$e" 2>/dev/null || echo 0)"
      if ! prov_logged_in "$p" "$(slot_dir "$p" "$e")"; then
        state="not logged in"
      elif [ -f "$(pools_dir)/hold-$p-$e" ]; then
        state="HELD (no expiry)"
      elif [ "$until" -gt "$now" ]; then
        state="cooling down $(( (until - now + 59) / 60 ))m"
      elif slot_nearing "$p" "$e"; then
        state="nearing limit"
      else
        state="available"
      fi
      if [ "$last" -gt 0 ]; then
        printf '  %-28s %-20s last used %sm ago\n' "$e" "$state" "$(( (now - last) / 60 ))"
      else
        printf '  %-28s %-20s never used\n' "$e" "$state"
      fi
    done
  done
  [ -x "$SHIM_BIN/claude-auto" ] || echo "(no auto launchers yet — run: agent-link auto)"
  return 0
}

cmd_shims() { # numbered per-slot shims: claude-1, codex-2, ...
  local p e i env_var f trust_block
  mkdir -p "$SHIM_BIN"
  for p in $PROVIDERS; do
    trust_block=""
    [ "$p" = claude ] && trust_block="$(claude_trust_block)"
    for f in "$SHIM_BIN/$p"-[0-9] "$SHIM_BIN/$p"-[0-9][0-9]; do
      [ -e "$f" ] && rm -f "$f"
    done
    env_var="$(prov_env_var "$p")"
    pemail="$(primary_email "$p")"
    pcov=""
    for e in $(slot_list "$p"); do
      [ "$(prov_email "$p" "$(slot_dir "$p" "$e")")" = "$pemail" ] && pcov=1
    done
    if [ -n "$pemail" ]; then
      pruns="$(cat "$(pools_dir)/count-$p-primary" 2>/dev/null || echo 0)"
      puntil="$(cat "$(pools_dir)/cooldown-$p-primary" 2>/dev/null || echo 0)"
      pnow="$(date +%s)"
      phold="$(hold_get "$p" primary 2>/dev/null || true)"
      pdot="${C_GREEN}●${C_OFF}"
      if [ -n "$phold" ]; then
        pdot="${C_RED}●${C_OFF}"
        pnote="HELD — $phold"
      elif [ -n "$pcov" ]; then
        pnote="duplicated by a slot below"
      elif [ "$puntil" -gt "$pnow" ]; then
        pdot="${C_RED}●${C_OFF}"
        pnote="parked $(( (puntil - pnow + 59) / 60 ))m — $(cat "$(pools_dir)/reason-$p-primary" 2>/dev/null || echo 'routing skips it')"
      else
        pnote="in rotation · ${pruns} launches"
      fi
      printf '    %s %-30s %-14s %s%s%s\n' "$pdot" "$pemail" "primary" "$C_DIM" "$pnote" "$C_OFF"
    fi
    i=0
    for e in $(slot_list "$p"); do
      i=$((i+1))
      cat > "$SHIM_BIN/$p-$i" <<EOF
#!/usr/bin/env bash
# agent-link slot shim: $p account $e — managed by \`agent-link shims\`.
here="\$(cd "\$(dirname "\$0")" && pwd)"
real=""
old_ifs="\$IFS"; IFS=:
for d in \$PATH; do
  [ -n "\$d" ] || continue
  [ "\$d" = "\$here" ] && continue
  if [ -x "\$d/$p" ] && [ ! "\$d/$p" -ef "\$here/$p" ]; then real="\$d/$p"; break; fi
done
IFS="\$old_ifs"
[ -n "\$real" ] || { echo "agent-link: real '$p' binary not found in PATH" >&2; exit 127; }
export $env_var="\${AGENT_LINK_HOME:-\${AGENT_AUTH_HOME:-$ROOT}}/accounts/$p/$e"
$trust_block
exec "\$real" "\$@"
EOF
      chmod +x "$SHIM_BIN/$p-$i"
      echo "wrote $SHIM_BIN/$p-$i -> $e"
    done
  done
  case ":$PATH:" in
    *":$SHIM_BIN:"*) ;;
    *) echo; echo "note: $SHIM_BIN is not in PATH — add to your shell profile:"
       echo "  export PATH=\"$SHIM_BIN:\$PATH\"" ;;
  esac
}

cmd_env() { # provider email — print eval-able export
  prov_valid "${1:-}" && valid_account "${2:-}" || { echo "usage: agent-link env <claude|codex> <email>" >&2; return 1; }
  [ -d "$(slot_dir "$1" "$2")" ] || { echo "no $1 slot '$2'" >&2; return 1; }
  echo "export $(prov_env_var "$1")=\"$(slot_dir "$1" "$2")\""
}

cmd_run() { # provider email [cmd...]
  prov_valid "${1:-}" && valid_account "${2:-}" || { echo "usage: agent-link run <claude|codex> <email> [command...]" >&2; return 1; }
  local p="$1" e="$2" dir
  dir="$(slot_dir "$p" "$e")"
  [ -d "$dir" ] || { echo "no $p slot '$e'" >&2; return 1; }
  shift 2
  [ $# -gt 0 ] || set -- "$(prov_binary "$p")"
  env "$(prov_env_var "$p")=$dir" "$@"
}

cmd_remove() { # provider email — archive a slot outside rotation
  prov_valid "${1:-}" || { echo "usage: agent-link remove <claude|codex> <email>" >&2; return 1; }
  # Never let a path fragment through: this function moves a directory.
  valid_account "${2:-}" || { echo "invalid account name: '${2:-}'" >&2; return 1; }
  local p="$1" e="$2" dir a archive
  dir="$(slot_dir "$p" "$e")"
  [ -d "$dir" ] || { echo "no $p slot '$e'" >&2; return 1; }
  printf "Remove the %s slot for %s from routing and archive its login/history? [y/N] " "$p" "$e"
  read -r a || return 1
  case "$a" in y|Y|yes|YES) ;; *) echo "aborted"; return 1;; esac
  mkdir -p "$ROOT/removed"
  archive="$ROOT/removed/$p-$e-$(date '+%Y%m%d-%H%M%S')"
  mv "$dir" "$archive"
  if [ -f "$(order_file "$p")" ]; then
    grep -vxF "$e" "$(order_file "$p")" > "$(order_file "$p").tmp" || true
    mv "$(order_file "$p").tmp" "$(order_file "$p")"
  fi
  if [ "$(cat "$(route_file "$p")" 2>/dev/null)" = "$e" ]; then
    echo primary > "$(route_file "$p")"
    echo "plain \`$p\` was routed to this slot — reset to primary"
  fi
  for a in first last; do
    if [ -f "$STATE/prefer-$p-$a" ]; then
      grep -vxF "$e" "$STATE/prefer-$p-$a" > "$STATE/prefer-$p-$a.tmp" || true
      if [ -s "$STATE/prefer-$p-$a.tmp" ]; then mv "$STATE/prefer-$p-$a.tmp" "$STATE/prefer-$p-$a"
      else rm -f "$STATE/prefer-$p-$a" "$STATE/prefer-$p-$a.tmp"; fi
    fi
  done
  rm -f "$(pools_dir)/count-$p-$e" "$(pools_dir)/last-$p-$e" \
    "$(pools_dir)/cooldown-$p-$e" "$(pools_dir)/reason-$p-$e" \
    "$(pools_dir)/hold-$p-$e" "$(pools_dir)/holdcheck-$p-$e" \
    "$(pools_dir)/nearing-$p-$e" "$(pools_dir)/quota-$p-$e.json" \
    "$(pools_dir)/.quota-check-$p-$e"
  # Numbering is positional, so every later slot shifts down. Rewrite the
  # numbered shims now rather than leaving one pointing at a deleted slot.
  if ls "$SHIM_BIN/$p"-[0-9]* >/dev/null 2>&1; then
    rm -f "$SHIM_BIN/$p"-[0-9]*
    cmd_shims >/dev/null
    echo "removed. Numbered shims rebuilt — $p-N numbers may now refer to different accounts."
  else
    echo "removed."
  fi
  echo "archived for recovery at $archive"
}

