        printf '  account email: '; read -r e
        cmd_remove "$p" "$e" || true
        ;;
      d|D) cmd_auto ;;
      u|U)
        printf '  provider (claude/codex): '; read -r p
        printf '  pin plain command to (email, number, or "primary"): '; read -r n
        cmd_use "$p" "$n" || true
        ;;
      s|S) cmd_shims ;;
      p|P)
        printf '  provider (claude/codex): '; read -r p
        printf '  account email (or "primary"): '; read -r e
        printf '  minutes [180]: '; read -r n
        cmd_cooldown "$p" "$e" "${n:-180}" || true
        ;;
      k|K)
        printf '  provider (claude/codex): '; read -r p
        printf '  account email (or "primary"): '; read -r e
        cmd_cooldown "$p" "$e" clear || true
        ;;
      t|T)
        printf '  model [claude-fable-5]: '; read -r n
        printf '  park the ones that refuse? [y/N] '; read -r e
        case "$e" in y|Y) cmd_probe claude "${n:-claude-fable-5}" --park || true ;; *) cmd_probe claude "${n:-claude-fable-5}" || true ;; esac
        ;;
      x|X)
        printf '  look back how many hours? [6] '; read -r n
        printf '  move them to a healthy account? [y/N] '; read -r e
        case "$e" in y|Y) cmd_rescue "${n:-6}" --go || true ;; *) cmd_rescue "${n:-6}" || true ;; esac
        ;;
      i|I)
        printf '  days [7]: '; read -r n
        cmd_insights "${n:-7}" || true
        ;;
      w|W) cmd_whoami || true ;;
      y|Y) cmd_sync || true ;;
      g|G)
        echo; cmd_app list
        printf '  install/remove which? [id, or enter to skip] '; read -r n
        if [ -n "$n" ]; then
          printf '  (i)nstall or (r)emove? [i] '; read -r e
          case "$e" in r|R) cmd_app remove "$n" || true ;; *) cmd_app install "$n" || true ;; esac
        fi
        ;;
      '?'|h|H) cmd_doctor || true ;;
      q|Q) return 0 ;;
      "") ;;
      *) printf '  %sunknown key: %s%s\n' "$C_DIM" "$choice" "$C_OFF" ;;
    esac
  done
}

usage() {
  cat <<EOF
agent-link $VERSION — multi-account manager for AI coding CLIs (claude, codex)

usage:
  agent-link                       interactive mode
  agent-link status                show every account slot and where routing points
  agent-link add <prov> <email>    create a slot and log it in
  agent-link login [prov] [email|all]   (re)login slots that need it
  agent-link use <prov> <email|N|primary>  route plain \`claude\`/\`codex\` to a slot
  agent-link route enable|disable|status   manage the routing shims
  agent-link shims                 write numbered shims: claude-1, claude-2, codex-1 ...
  agent-link auto                  write auto-routing launchers (one provider, many accounts)
  agent-link pools                 show what auto-routing sees (available / cooling down)
  agent-link cooldown <prov> <email> [min|clear]   park an exhausted account
  agent-link nearing <prov> [email|primary] [clear]  soft-flag an account nearing its limit
  agent-link usage                 /usage across accounts: live window %%, resets, park state
  agent-link router [install|status]   AgentRouter virtual route: ordered cross-provider Paseo targets
  agent-link switch [prov] [sid]   move this conversation to a healthy account and print the resume
  agent-link evict [prov]          end processes stuck on a held account so their next message re-routes
  agent-link revalidate [prov]     re-prove HELD accounts; release any that serve again
  agent-link prefer <prov> [email|primary] [first|last|clear]  bias routing toward/away from an account
  agent-link cooldown <prov> <email> hold          park with NO expiry (release: clear, or a passing probe)
  agent-link hooks [install|remove|status] [--primary]  wire Claude Code itself to report limits
  agent-link handoff <prov> <session-id> <email>   move a chat to another account
  agent-link env <prov> <email>    print an eval-able export for one slot
  agent-link run <prov> <email> [cmd...]   run a command under a slot's account
  agent-link claude [args...]      run Claude Code on the next account in rotation
  agent-link codex  [args...]      same for Codex
  agent-link remove <prov> <email> archive a slot outside routing
  agent-link sync                  copy MCP servers + project trust from primaries into slots
  agent-link style [install|status] install/check the concise contract across Claude/Codex accounts
  agent-link app [list|install|remove] [id] [--link]  optional integrations (Paseo panel, editors)
  agent-link update                update the CLI and reinstall the apps you have
  agent-link fix [model]           test accounts, rescue stuck chats, resync — the one-shot cleanup
  agent-link doctor                sanity checks

slots live in \$AGENT_AUTH_HOME (default ~/.agent-link), one folder per account email.
Primary ~/.claude and ~/.codex stay untouched except for an explicit `style install`.
EOF
}

main() {
  mkdir -p "$ACCOUNTS/claude" "$ACCOUNTS/codex" "$STATE"
  case "${1:-}" in
    "") if [ -t 0 ]; then cmd_interactive; else cmd_status; fi ;;
    status)  cmd_status ;;
    add)     shift; cmd_add "$@" ;;
    login)   shift; cmd_login "$@" ;;
    use)     shift; cmd_use "$@" ;;
    route)   shift; cmd_route "${1:-status}" ;;
    shims)   cmd_shims ;;
    auto)    cmd_auto ;;
    pick)    shift; cmd_pick "$@" ;;
    handoff) shift; cmd_handoff "$@" ;;
    resume-target) shift; cmd_resume_target "$@" ;;
    continue-target) shift; cmd_continue_target "$@" ;;
    nearing) shift; cmd_nearing "$@" ;;
    prefer)  shift; cmd_prefer "$@" ;;
    usage)   cmd_usage ;;
    router)  shift; cmd_router "$@" ;;
    revalidate) shift; cmd_revalidate "$@" ;;
    switch)  shift; cmd_switch "$@" ;;
    evict)   shift; cmd_evict "$@" ;;
    refused) shift; cmd_refused "$@" ;;
    hooks)   shift; cmd_hooks "$@" ;;
    pools)   cmd_pools ;;
    whoami)  shift; cmd_whoami "$@" ;;
    plugin)  shift; cmd_plugin "$@" ;;
    app)     shift; cmd_app "$@" ;;
    update)  cmd_update ;;
    insights) shift; cmd_insights "$@" ;;
    rescue)  shift; cmd_rescue "$@" ;;
    probe)   shift; cmd_probe "$@" ;;
    next)    shift; prov_valid "${1:-claude}" && pick_slot "${1:-claude}" dry ;;
    cooldown) shift; cmd_cooldown "$@" ;;
    env)     shift; cmd_env "$@" ;;
    run)     shift; cmd_run "$@" ;;
    remove)  shift; cmd_remove "$@" ;;
    sync)    cmd_sync ;;
    style)   shift; cmd_style "$@" ;;
    fix)     shift; cmd_fix "$@" ;;
    doctor)  cmd_doctor ;;
    claude|codex) cmd_exec_auto "$@" ;;
    version|--version|-v) echo "$VERSION" ;;
    help|--help|-h|*) usage ;;
  esac
}

main "$@"
