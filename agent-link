# A hold never expires — which is right for "this account is refusing" and
# WRONG the moment the month rolls over or the user raises the cap. Nothing
# but a real call can tell the difference, so re-prove held accounts on a
# schedule: one tiny call each, and any that serves is released immediately.
# Move a conversation to a healthy account and print the one command that
# continues it there. This is the honest form of "switch accounts": a running
# process can never change account, but its next resume can.
# Sending a message to an agent whose process is ALREADY RUNNING never routes:
# the orchestrator writes to that process's stdin, so a session pinned to an
# exhausted account keeps answering "usage limit" forever. The process cannot
# be re-pointed — but it can be ended, and the next message then relaunches it
# through the launcher, which picks a live account. Only processes bound to a
# HELD (refusing) account are touched: they cannot serve anything anyway.
cmd_evict() { # [provider] [model-slug] — end processes pinned to a held account/model
  local p="${1:-claude}" model_slug="${2:-}" pid dir key ended=0 until_ts command
  prov_valid "$p" || { echo "usage: agent-link evict [claude]" >&2; return 1; }
  [ "$p" = claude ] || { echo "evict supports claude only" >&2; return 1; }
  for pid in $(ps -axo pid,command | grep "[c]laude " | awk '{print $1}'); do
    dir="$(ps eww -p "$pid" 2>/dev/null | tr ' ' '\n' | grep '^CLAUDE_CONFIG_DIR=' | head -1 | cut -d= -f2-)"
    [ -n "$dir" ] || continue
    key="$(basename "$dir")"
    if [ -n "$model_slug" ]; then
      [ -f "$(pools_dir)/holdmodel-$p-$key-$model_slug" ] || continue
      command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
      case "$command" in *"$model_slug"*) ;; *) continue ;; esac
      kill "$pid" 2>/dev/null && ended=$((ended+1))
      continue
    fi
    # A timed cooldown is just as fatal as a hold while it lasts: a session
    # limit resets at midnight, and until then every message to that pinned
    # process comes back refused. Retire on either.
    if [ ! -f "$(pools_dir)/hold-$p-$key" ]; then
      until_ts="$(cat "$(pools_dir)/cooldown-$p-$key" 2>/dev/null || echo 0)"
      [ "$until_ts" -gt "$(date +%s)" ] || continue
    fi
    kill "$pid" 2>/dev/null && ended=$((ended+1))
  done
  if [ "$ended" -gt 0 ]; then
    echo "ended $ended process(es) pinned to an exhausted account"
    echo "send those agents a message — the relaunch lands on a live account"
    echo "$(date '+%Y-%m-%d %H:%M')  evicted $ended $p process(es) from held accounts" >> "$STATE/autopark.log"
  else
    echo "nothing pinned to an exhausted $p account"
  fi
}

cmd_switch() { # [provider] [session-id] — default: the newest session in this cwd
  local p="${1:-claude}" sid="${2:-}" target owner
  prov_valid "$p" || { echo "usage: agent-link switch [claude|codex] [session-id]" >&2; return 1; }
  if [ -z "$sid" ]; then
    target="$(cmd_continue_target "$p" "$PWD" 2>/dev/null || true)"
    local slug f best="" best_m=0 d m
    slug="$(printf %s "$PWD" | LC_ALL=C sed 's/[^A-Za-z0-9]/-/g')"
    for d in "$(primary_dir "$p")" "$ACCOUNTS/$p"/*/; do
      d="${d%/}"
      if [ "$p" = claude ]; then f="$(ls -t "$d/projects/$slug"/*.jsonl 2>/dev/null | head -1)"
      else f="$(ls -t "$d"/sessions/*/*/*/*.jsonl 2>/dev/null | head -1)"; fi
      [ -n "$f" ] || continue
      m="$(stat -f %m "$f" 2>/dev/null || echo 0)"
      [ "$m" -gt "$best_m" ] && { best_m="$m"; best="$f"; }
    done
    [ -n "$best" ] || { echo "no conversation found for $PWD" >&2; return 1; }
    if [ "$p" = claude ]; then sid="$(basename "$best" .jsonl)"
    else sid="$(basename "$best" .jsonl | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')"; fi
  fi
  owner="$(session_owner "$p" "$sid")" || { echo "session '$sid' not found in any $p account" >&2; return 1; }
  echo "session $sid"
  echo "  currently on: $owner"
  target="$(cmd_resume_target "$p" "$sid" --go 2>/dev/null || true)"
  [ -n "$target" ] || { echo "  no healthy account to move to — run: agent-link revalidate" >&2; return 1; }
  if [ "$target" = primary ]; then
    echo "  moved to: primary"
    echo
    echo "continue it with:  $p --resume $sid"
  else
    echo "  moved to: $(basename "$target")"
    echo
    echo "continue it with:  agent-link run $p $(basename "$target") $p --resume $sid"
  fi
  echo "(in Paseo: just send the agent a message — the launcher routes the resume for you)"
}

HOLD_RECHECK_HOURS=1

cmd_revalidate() { # [provider] — probe only HELD accounts, release those that serve
  local p="${1:-claude}" e dir out rc held=0
  prov_valid "$p" || { echo "usage: agent-link revalidate [claude]" >&2; return 1; }
  [ "$p" = claude ] || { echo "revalidate supports claude only" >&2; return 1; }
  for e in primary $(slot_list "$p"); do
    [ -f "$(pools_dir)/hold-$p-$e" ] || continue
    held=$((held+1))
    if [ "$e" = primary ]; then dir=""; else dir="$(slot_dir "$p" "$e")"; fi
    printf '  %-28s ' "$e"
    if [ -n "$dir" ]; then
      out="$(CLAUDE_CONFIG_DIR="$dir" claude -p "ok" 2>&1)"
      rc=$?
    else
      out="$(claude -p "ok" 2>&1)"
      rc=$?
    fi
    out="$(printf '%s' "$out" | tr '\n' ' ')"
    if [ "$rc" -ne 0 ]; then
      printf 'probe failed — hold stands\n'
    elif is_limit_refusal_text "$out"; then
      printf 'still refusing — hold stands\n'
    else
        rm -f "$(pools_dir)/hold-$p-$e" "$(pools_dir)/cooldown-$p-$e" "$(pools_dir)/reason-$p-$e"
        printf 'RECOVERED — released back into rotation\n'
        echo "$(date '+%Y-%m-%d %H:%M')  released $p/$e — it serves again (revalidate)" >> "$STATE/autopark.log"
    fi
    date +%s > "$(pools_dir)/holdcheck-$p-$e"
  done
  [ "$held" -gt 0 ] || echo "  no held $p accounts to re-prove"
}

# Fired detached from a launch when a hold has gone stale, so recovery happens
# without anyone remembering to run anything.
maybe_revalidate() { # $1 provider
  local e f age now self
  [ "$1" = claude ] || return 0
  now="$(date +%s)"
  for f in "$(pools_dir)"/hold-$1-*; do
    [ -f "$f" ] || continue
    e="${f##*/hold-$1-}"
    age="$(cat "$(pools_dir)/holdcheck-$1-$e" 2>/dev/null || stat -f %m "$f" 2>/dev/null || echo 0)"
    if [ $(( now - age )) -gt $(( HOLD_RECHECK_HOURS * 3600 )) ]; then
      self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
      [ -x "$self" ] && ( "$self" revalidate "$1" >/dev/null 2>&1 & ) 
      return 0
    fi
  done
}

